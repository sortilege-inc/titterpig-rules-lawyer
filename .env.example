# Local embedding backend (Ollama). Copy to .env to override defaults.
# The tool degrades to keyword-only (FTS5) retrieval when Ollama is unreachable
# or the model is not pulled, so these are optional.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Corpus store. Overrides corpora.json's "root". Every <id>.merged.ttrpg found
# under it (with a sibling <id>.resolved.json) is auto-discovered as a corpus.
# TITTERPIG_CORPORA=/home/you/Working/titterpig-corpora
