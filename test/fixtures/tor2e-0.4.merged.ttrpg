            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
    # FAMOUS WEAPONS (Lone-Lands)
    ^"Sword of Tempests" DEF {
        EXTENDS ^"FamousWeapon"
        PROPERTIES {
            ^"Name" STRING "Sword of Tempests" FIXED
            ^"Weapon Type" STRING "Long Sword" FIXED
            ^"Original Bearer" STRING "Duinhir 'Eaglenose'" FIXED
            ^"Craftsmanship" STRING "Númenórean" FIXED
            ^"Banes" LIST [] FIXED
            ^"Qualities" LIST ["Fell", "Luminescence"] FIXED
            ^"Description" STRING "A damasked blade whose hilt is engraved with scenes of sea-storms. When swung with force, those near the strike feel the blast of a great wind." FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
