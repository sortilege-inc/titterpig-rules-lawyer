    # LONE-LANDS CAMPAIGN TREASURES
    # ─────────────────────────────────────────────
    # MARVELLOUS ARTEFACTS
    ^"War-horn of Arveleg" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "War-horn of Arveleg" FIXED
            ^"Description" STRING "An ivory horn carved from the tusk of a great northern beast, fashioned for Arveleg, King of Arnor. Its call carries farther than it should, and it stirs the hearts of those who hear it." FIXED
            ^"Blessing Skill" STRING "Enhearten" FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
    ^"The Unquenchable Lantern" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "The Unquenchable Lantern" FIXED
            ^"Description" STRING "A casket of glass and bronze holding a crystal shard from an Elven lamp. It cannot be extinguished by wind or water, and its light reveals hidden paths." FIXED
            ^"Blessing Skill" STRING "Scan" FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
    ^"Boots of the Thousand Leagues" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Boots of the Thousand Leagues" FIXED
            ^"Description" STRING "Ancient boots sewn with Elven craft that relieve the wearer of travel fatigue. The roads seem to welcome the feet of the one who wears them." FIXED
            ^"Blessing Skill" STRING "Travel" FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
    ^"Quiver of Araw" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Quiver of Araw" FIXED
            ^"Description" STRING "A Sindarin quiver decorated with scenes of the Vala Oromë. The arrows within never go wide when the hunter's intent is true." FIXED
            ^"Blessing Skill" STRING "Hunting" FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
    ^"Durin's Whetstone" DEF {
