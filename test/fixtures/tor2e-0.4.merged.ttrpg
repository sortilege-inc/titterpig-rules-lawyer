            ^"Cultural Blessing Name" STRING "Folk of the Dusk" FIXED
            ^"Cultural Blessing" STRING "When you are in a forest, or at night, you can spend 1 point of Hope to achieve a Magical success on a skill roll." FIXED
            ^"Languages" LIST ["Sindarin"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Amras", "Aredhel", "Beleganor", "Belegon", "Calanhir", "Carmagor", "Dagorhir", "Durandir", "Edrahil", "Ellahir", "Fincalan", "Fuindor", "Galdagor", "Galdor", "Hallas", "Hirimlad", "Ithildir", "Lascalan", "Linaith", "Mablin", "Malanor", "Nauros", "Orgalad", "Pelegorn", "Sargon"] FIXED
                ^"Female" LIST ["Anórel", "Aranel", "Arbereth", "Baraniel", "Calanril", "Celebrindal", "Celenneth", "Elanor", "Elwing", "Eraniel", "Fimbrethil", "Gloredhel", "Idril", "Irilde", "Laurelin", "Lôrwend", "Lothíriel", "Meneloth", "Moriel", "Narieth", "Narniel", "Nimloth", "Nimrodel", "Níniel", "Tarandîs"] FIXED
            }
        }
        # Choose one set of Attributes, or roll 1d6 to determine set.
        ATTRIBUTE_ARRAYS {
            1
            : [STR 5, HEART 2, WITS 7]
            2
            : [STR 4, HEART 3, WITS 7]
            3
            : [STR 5, HEART 3, WITS 6]
            4
            : [STR 4, HEART 4, WITS 6]
            5
            : [STR 5, HEART 4, WITS 5]
            6
            : [STR 6, HEART 2, WITS 6]
        }
        DERIVED_STATS {
            ^"Endurance"
            FORMULA "Strength + 18"
            ^"Hope"
            FORMULA "Heart + 8"
            ^"Parry"
            FORMULA "Wits + 14"
        }
        # Copy listed ranks; choose one Favoured skill from the two marked [F].
        STARTING_SKILLS {
