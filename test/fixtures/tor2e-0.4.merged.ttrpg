            ^"Cultural Blessing" STRING "Add 1 point to one Attribute of your choice during character creation." FIXED
            ^"Cultural Weakness" STRING "ALLEGIANCE OF THE DÚNEDAIN: During the Fellowship Phase (except at Yule), you may recover Hope up to a maximum equal to half your HEART score (rounded up)." FIXED
            ^"Languages" LIST ["Common Speech", "Sindarin"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Adrahil", "Amlaith", "Arvegil", "Baranor", "Belecthor", "Bergil", "Celepharn", "Cirion", "Damrod", "Dírhael", "Duinhir", "Egalmoth", "Eradan", "Findemir", "Forlong", "Golasdan", "Hallas", "Hirluin", "Ingold", "Iorlas", "Malvegil", "Ohtar", "Orodreth", "Tarannon", "Targon"] FIXED
