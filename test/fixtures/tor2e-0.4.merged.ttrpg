    THE_FORTUNE_TABLE {
        DESCRIPTION "Rolling the rune means a successful action was bolstered by fortune, such as unexpected aid, advantageous terrain, or a foe's folly. To help inspire a random result, roll on the Fortune table."
        ROLL "Feat die"
        NAME "The Fortune Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Gandalf Rune"
        { RESULT "The Eye of the Enemy focuses elsewhere. Decrease Eye Awareness by 1." }
        ^"1"
        { RESULT "You may bypass a threat without attracting notice" }
        ^"2"
        { RESULT "You gain favour with an Ally" }
        ^"3"
        { RESULT "An enemy inadvertently reveals their position" }
        ^"4"
        { RESULT "You gain favoured ground" }
        ^"5"
        { RESULT "Enemies run afoul of danger" }
        ^"6"
        { RESULT "You locate or learn of a useful item" }
        ^"7"
        { RESULT "Your success instills new hope or renewed resolve" }
        ^"8"
        { RESULT "You find a moment of comfort or safety" }
        ^"9"
        { RESULT "You learn or realise something which gives helpful insight into your mission" }
        ^"10"
        { RESULT "You encounter an opportunity suited to your nature or abilities" }
        ^"Eye of Sauron"
        { RESULT "An Ally reveals an unexpected strength or skill" }
    }
    THE_ILL_FORTUNE_TABLE {
        DESCRIPTION "Rolling a failure with the Eye icon means a failure was complicated by ill-fortune, such as a broken weapon, difficult terrain, or enemy reinforcements. To help inspire a random result, roll on the Ill-fortune table."
        ROLL "Feat die"
        NAME "The Ill-fortune Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Eye of Sauron"
        { RESULT "Your actions catch the Eye of the Enemy. Increase Eye Awareness by 2." }
        ^"1"
        { RESULT "You draw unwanted attention" }
        ^"2"
        { RESULT "Your actions are observed by someone of ill-intent" }
        ^"3"
        { RESULT "Unexpected enemies emerge or are sighted" }
        ^"4"
        { RESULT "You are hindered by difficult terrain or an unfavourable environment" }
        ^"5"
        { RESULT "You find yourself ill-equipped for the circumstances" }
        ^"6"
        { RESULT "A favoured weapon or item is lost, broken, or sacrificed" }
        ^"7"
        { RESULT "You are plagued by troubling visions or thoughts" }
        ^"8"
        { RESULT "An old injury or stress resurfaces" }
        ^"9"
        { RESULT "You learn or realise something which adds a new complication to your mission" }
        ^"10"
        { RESULT "You face a test which is contrary to your nature or abilities" }
        ^"Gandalf Rune"
        { RESULT "An Ally becomes a hindrance or liability" }
    }
    THE_SPECIAL_SUCCESS_TABLE {
        DESCRIPTION "When a successful action also produces one or more Elvish symbols on your Success dice, this is a superior result. You can specify what your superior result means by 'spending' your rolled icons to trigger special results. Choose one of the options listed for each Success icon rolled. The 'Cancel a Failure' option is only relevant for co-op play with another Player-hero."
        ROLL "Success icon"
        NAME "The Special Success Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Spend 1 Success icon"
        { RESULT "Cancel a Failure" DESCRIPTION "If a Skill roll involves multiple players, you help another Player-hero who failed; the failed roll is considered a success." }
        ^"Spend 1 Success icon"
        { RESULT "Score 1 Additional Success" DESCRIPTION "If an action requires multiple successes to be achieved, you score 1 additional success." }
        ^"Spend 1 Success icon"
        { RESULT "Gain Insight" DESCRIPTION "You gain additional information, not necessarily related to the task at hand. For example, while helping a sick individual with a HEALING roll you discover the trace of poison. Or you spot a sentry while sneaking into a ruin with a roll of STEALTH." }
        ^"Spend 1 Success icon"
        { RESULT "Go quietly" DESCRIPTION "You achieve your goal noiselessly or without otherwise attracting attention." }
        ^"Spend 1 Success icon"
        { RESULT "Make haste" DESCRIPTION "You complete the attempted task in a shorter time (about half the expected time)." }
        ^"Spend 1 Success icon"
        { RESULT "Widen Influence" DESCRIPTION "You can influence more than the specific number of subjects originally targeted by the action. As a general rule, each Success icon spent corresponds to one additional subject or group of subjects. For example, following a roll of INSIGHT, you spot a second person acting suspiciously at an inn; a roll of ENHEARTEN aimed to affect half a dozen individuals allows you to influence a full dozen." }
    }
    EXPERIENCE_MILESTONES {
        DESCRIPTION "When you achieve an experience milestone shown in the table below, gain the listed amount of Skill points or Adventure points. If more than one milestone applies to a scene or challenge, select only one."
        ROLL "Milestone"
        NAME "Experience Milestones"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Reclaim a new Safe Haven within Moria"
        { RESULT "3 Adventure Points and 3 Skill Points" }
        ^"Achieve a mission or quest"
        { RESULT "2 Adventure Points and 2 Skill Points" }
        ^"Achieve a notable personal goal"
        { RESULT "1 Adventure Point and 1 Skill Point" }
        ^"Retrieve a notable treasure"
        { RESULT "1 Adventure Point and 1 Skill Point" }
        ^"Reach or reveal a significant location"
        { RESULT "1 Adventure Point" }
        ^"Survive a dangerous battle"
        { RESULT "1 Adventure Point" }
        ^"Face a Revelation Episode"
        { RESULT "1 Adventure Point" }
        ^"Defeat a notable foe"
        { RESULT "1 Skill Point" }
        ^"Overcome a tricky obstacle"
        { RESULT "1 Skill Point" }
        ^"Face a Noteworthy Encounter during a journey"
        { RESULT "1 Skill point" }
    }
    SPEC_VERSION "0.4"
    # Source: Strider Mode supplement for The One Ring 2e.
    # Provides rules for playing The One Ring as a solo adventure.
    # Modifies character creation and introduces Patron Quests.
    # ─────────────────────────────────────────────
    # CHARACTER CREATION MODIFICATIONS
    # ─────────────────────────────────────────────
    ^"Strider Mode Rules" DEF {
        PROPERTIES {
            ^"Name" STRING "Strider Mode Character Creation" FIXED
            ^"Previous Experience" INTEGER 15 FIXED
            ^"Fellowship Rating" STRING "3 + bonuses from Virtues, Cultural Blessings, and Patron" FIXED
            ^"Fellowship Focus" STRING "None (solo characters do not have a Fellowship Focus)" FIXED
            ^"Extra Distinctive Feature" STRING "Strider" FIXED
            ^"Virtue Advisory" STRING "Watch for Company-specific benefits which will not apply to solo play (e.g. Three is Company is not recommended)." FIXED
            ^"Description" STRING "Solo Player-heroes use 15 Previous Experience points instead of 10. Fellowship score equals 3 plus any bonuses. No Fellowship Focus. Gains an extra Distinctive Feature: Strider." FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
    # ─────────────────────────────────────────────
    # DISTINCTIVE FEATURE — STRIDER
    # ─────────────────────────────────────────────
    ^"Strider" DEF {
        EXTENDS ^"DistinctiveFeature"
        PROPERTIES {
            ^"Name" STRING "Strider" FIXED
            ^"Effect" STRING "Wandering the wilds of Middle-earth alone hardens the spirit and sharpens the senses. While journeying, the Player-hero is considered Inspired on all skill rolls." FIXED
            ^"Prerequisite" STRING "Strider Mode solo play only" FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
    # ─────────────────────────────────────────────
    # PATRON QUESTS
    # ─────────────────────────────────────────────
    # Each Patron provides six quest options for Strider Mode campaigns.
    # These seed adventures for solo play.
    ^"Patron Quest — Balin" DEF {
        PROPERTIES {
            ^"Patron" STRING "Balin" FIXED
            ^"Quests" LIST [
                "Investigate reports of Orcs gathering in the Misty Mountains.",
                "Seek out a lost Dwarf settlement in the Grey Mountains.",
                "Recover a stolen heirloom from a band of thieves.",
                "Map a safe route through the mountains for Dwarf traders.",
                "Investigate rumours of a dragon in the Withered Heath.",
                "Escort a delegation of Dwarves to a meeting with the Elvenking."
            ] FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
    ^"Patron Quest — Bilbo" DEF {
        PROPERTIES {
            ^"Patron" STRING "Bilbo Baggins" FIXED
            ^"Quests" LIST [
                "Gather tales and songs from the peoples of Wilderland.",
                "Investigate a mysterious disappearance in the Shire.",
                "Deliver a package to a distant friend.",
                "Search for rare plants in the Old Forest.",
                "Uncover the history of an old Hobbit family heirloom.",
                "Investigate rumours of strange folk on the East Road."
            ] FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
    ^"Patron Quest — Círdan" DEF {
        PROPERTIES {
            ^"Patron" STRING "Círdan the Shipwright" FIXED
            ^"Quests" LIST [
                "Investigate a disturbance along the coast.",
                "Seek tidings from the Elves of Rivendell.",
                "Scout the ruins of Annúminas for signs of Shadow.",
                "Recover an Elven artefact lost during the last war.",
                "Carry a message to the Grey Havens.",
                "Escort travellers through the Tower Hills."
            ] FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
    ^"Patron Quest — Gandalf" DEF {
        PROPERTIES {
            ^"Patron" STRING "Gandalf the Grey" FIXED
            ^"Quests" LIST [
                "Investigate rumours of a Necromancer's servants.",
                "Seek out a missing Ranger in the wild.",
                "Deliver a warning to the people of Lake-town.",
                "Explore an ancient ruin for signs of dark sorcery.",
                "Protect a village from raiding Orcs.",
                "Gather intelligence on Enemy movements."
            ] FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
    ^"Patron Quest — Gilraen" DEF {
        PROPERTIES {
            ^"Patron" STRING "Gilraen" FIXED
            ^"Quests" LIST [
                "Scout the borders of the Angle for threats.",
                "Investigate the ruins of Weathertop.",
                "Carry supplies to a remote Ranger outpost.",
                "Track a band of Orcs through the Trollshaws.",
                "Seek tidings from the Bree-folk.",
                "Investigate disappearances along the Great East Road."
            ] FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
    ^"Patron Quest — Tom Bombadil" DEF {
        PROPERTIES {
            ^"Patron" STRING "Tom Bombadil" FIXED
            ^"Quests" LIST [
                "Investigate disturbances in the Old Forest.",
                "Seek the source of a blight upon the Withywindle.",
                "Carry a message to Farmer Maggot.",
                "Explore the Barrow-downs carefully.",
                "Gather rare herbs that bloom only by moonlight.",
                "Aid a lost traveller in the Old Forest."
            ] FIXED
            ^"Source" STRING "Strider Mode" FIXED
        }
    }
}
