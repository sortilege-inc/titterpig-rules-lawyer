        PROPERTIES {
            ^"Name" STRING "Durin's Whetstone" FIXED
            ^"Description" STRING "Said to be the whetstone used by the Kings of Durin's Folk to keep their tools sharp. Work done with a blade honed on this stone comes out finer than craft alone should allow." FIXED
            ^"Blessing Skill" STRING "Craft" FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
    ^"Mantle of Fineness" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Mantle of Fineness" FIXED
            ^"Description" STRING "A wool fabric infused with the essence of courtesy itself. When worn, others find themselves inclined to treat the wearer with respect regardless of circumstance." FIXED
            ^"Blessing Skill" STRING "Courtesy" FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
    }
