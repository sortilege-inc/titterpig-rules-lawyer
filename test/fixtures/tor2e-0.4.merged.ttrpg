    ^"Hobbits of the Bree-land" DEF {
        EXTENDS ^"HeroicCulture"
        PROPERTIES {
            ^"Culture Name" STRING "Hobbits of the Bree-land" FIXED
            ^"Standard of Living" STRING "Common" FIXED
            ^"Cultural Blessing Name" STRING "Bree-blood" FIXED
            ^"Cultural Blessing" STRING "Each Hobbit of the Bree-land in the Company increases the Fellowship Rating by 1 point." FIXED
            ^"Cultural Weakness" STRING "HALFLINGS: Available weapons are axe, bow, club, cudgel, dagger, short sword, short spear, spear. Cannot use a great shield." FIXED
            ^"Languages" LIST ["Common Tongue"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Alfred", "Artie", "Bill", "Bob", "Carl", "Ed", "Fred", "Giles", "Herb", "Larry", "Nob", "Oswald", "Percy", "Perry", "Sid", "Tom", "Harry"] FIXED
                ^"Female" LIST ["Daisy", "Emma", "Etta", "Fay", "Fern", "Flora", "Gert", "Holly", "Lily", "Myrtle", "Poppy", "Rose", "Sage", "Tilly", "Violet"] FIXED
                ^"Family" LIST ["Banks", "Brockhouse", "Longhole", "Mugworts", "Sandheaver", "Tunnelly", "Underhill"] FIXED
            }
