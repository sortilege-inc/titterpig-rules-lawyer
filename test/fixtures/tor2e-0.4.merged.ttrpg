            1 ^"Stealth"
            1 ^"Awareness"
            1 ^"Insight"
            2
            [F]   ^"Scan"      1
            ^"Hunting"
            1 ^"Healing"
            0 ^"Explore"
            1 ^"Song"
            1 ^"Courtesy"
            3 ^"Riddle"
            2
            [F]
            ^"Craft"
            2 ^"Battle"
            0 ^"Lore"
            0
        }
        # Starting proficiencies: same as Men of Bree.
        STARTING_PROFICIENCIES "Axes or Spears 2, choose one other Combat Proficiency 1"
