            3 ^"Awareness"
            2
            [F] ^"Insight"  0       ^"Scan"      2
            ^"Hunting"
            1 ^"Healing"
            1 ^"Explore"
            1 ^"Song"
            2
            [F] ^"Courtesy" 0       ^"Riddle"    0
            ^"Craft"
            2 ^"Battle"
            1 ^"Lore"
            2
        }
        STARTING_PROFICIENCIES "Bows or Spears 2, choose one other Combat Proficiency 1"
        DISTINCTIVE_FEATURES CHOOSE 2 ["Cunning", "Fair", "Keen-eyed", "Merry", "Proud", "Secretive", "Swift", "Wary"]
        # Lórien Elves share virtues with other Elven cultures
        # plus unique virtues of their own.
        CULTURAL_VIRTUES [^"Against the Unseen", ^"Deadly Archery", ^"Elvish Dreams", ^"Shots in the Dark", ^"Lembas", ^"Favour of the Lady"]
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — HIGH ELVES OF RIVENDELL
    # ─────────────────────────────────────────────
    # Note: "Against the Unseen", "Deadly Archery", "Elvish Dreams", and
    # "Gleam of Wrath" are defined in tor2e-2e-core-virtues.ttrpg under
    # Elves of Lindon. High Elves share these.
    ^"Artificer of Eregion" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Artificer of Eregion" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "High Elves of Rivendell" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Next Yule, you may either add a single Enchanted Reward of Elven craftsmanship to a weapon of your choice, or create a Marvellous Artefact (your choice). In addition, during any Fellowship Phase you can make a CRAFT or LORE roll. If you succeed, you learn all there is to be discovered about the qualities of a single Marvellous Artefact or Wondrous Item in the Company's possession." FIXED
        }
    }
    ^"Beauty of the Stars" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Beauty of the Stars" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "High Elves of Rivendell" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Hope score by 1 point. If you are the spokesperson during a council, you raise its time limit by 1, OR you can choose to make all Mortals that were present during a council retain only a vague memory of what was said or agreed. This counts as a lesser magical effect for the purposes of increasing Eye Awareness." FIXED
        }
    }
    ^"Might of the Firstborn" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Might of the Firstborn" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "High Elves of Rivendell" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When an adversary spends a point of Hate or Resolve to activate a Fell Ability, you can spend a point of Hope to cancel its effects." FIXED
        }
    }
    ^"Skill of the Eldar" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Skill of the Eldar" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "High Elves of Rivendell" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you roll a 10 or a Gandalf rune on the Feat die, your result counts as a Magical success without needing to spend Hope." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — ELVES OF LÓRIEN
    # ─────────────────────────────────────────────
    # Note: "Against the Unseen", "Deadly Archery", "Elvish Dreams", and
    # "Shots in the Dark" are defined in other files and shared across
    # Elven cultures.
    ^"Lembas" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Lembas" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Elves of Lórien" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Each time you gain Fatigue from a Journey Event, you gain 1 point less. Additionally, you and all members of the Company can get rid of Fatigue on every Prolonged Rest, not only when in a safe and sheltered refuge, and at a rate of 2 points of Fatigue for each Prolonged Rest." FIXED
        }
    }
    ^"Favour of the Lady" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Favour of the Lady" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Elves of Lórien" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Hope score by 1 point. Additionally, during each Fellowship Phase, you may either return to Lórien or gain 1 Shadow point to recover twice the usual number of Hope points." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # EQUIPMENT — BOW OF THE GALADHRIM
    # ─────────────────────────────────────────────
    ^"Bow of the Galadhrim" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Bow of the Galadhrim" FIXED
            ^"Group" STRING "Bows" FIXED
            ^"Damage" INTEGER 6 FIXED
            ^"Injury" INTEGER 16 FIXED
            ^"Load" INTEGER 4 FIXED
            ^"Ranged" BOOLEAN TRUE FIXED
            ^"Two-Handed" BOOLEAN TRUE FIXED
            ^"Range Short" INTEGER 30 FIXED
            ^"Range Medium" INTEGER 60 FIXED
            ^"Range Long" INTEGER 120 FIXED
            ^"Notes" STRING "A Great Bow, but counts as a Bow for the purpose of Deadly Archery. Gain (1d) on SCAN rolls when attempting the Prepare Shot combat task. You can spend 1 Hope for a Magical success on such rolls." FIXED
            ^"Culture Restriction" STRING "Elves of Lórien" FIXED
            ^"Source" STRING "Realms of the Three Rings" FIXED
        }
    }
    # ─────────────────────────────────────────────
    # ELF-LORDS (SOLO / EPIC PLAY VARIANT)
    # ─────────────────────────────────────────────
    # Elf-lords are an optional character type for solo or epic play.
    # They use enhanced character creation rules.
    ^"Elf-lord Rules" DEF {
        PROPERTIES {
            ^"Name" STRING "Elf-lord Character Creation" FIXED
            ^"Previous Experience" INTEGER 20 FIXED
            ^"Starting Valour" INTEGER 3 FIXED
            ^"Starting Wisdom" INTEGER 3 FIXED
            ^"Starting Virtues" INTEGER 3 FIXED
            ^"Starting Rewards" INTEGER 3 FIXED
            ^"Additional Favoured Skills" INTEGER 1 FIXED
            ^"Second Calling" BOOLEAN TRUE FIXED
            ^"Maximum Flaws" INTEGER 8 FIXED
            ^"Heirloom Choices" INTEGER 2 FIXED
            ^"Description" STRING "Choose a second Calling for your character, gaining two additional Favoured Skills, its Distinctive Feature, and its Shadow Path. Start with 3 Virtues (one must be Common) and 3 Rewards. Choose two heirlooms from: a Famous Weapon/Armour with one Enchanted Reward and up to 2 normal Rewards; a Wondrous Item; a Marvellous Artefact and a Precious Object worth 30 Treasure; or a Precious Object worth 90 Treasure." FIXED
            ^"Source" STRING "Realms of the Three Rings" FIXED
        }
    }
    SPEC_VERSION "0.4"
    # Source: Rivendell supplement for The One Ring 2e.
    # Adds the High Elves of Rivendell Heroic Culture.
    # ─────────────────────────────────────────────
    # HIGH ELVES OF RIVENDELL
    # ─────────────────────────────────────────────
    SPEC_VERSION "0.4"
    # Source: Moria — Through the Doors of Durin supplement for The One Ring 2e.
    # Adds a new Heroic Culture (Dwarves of Nogrod and Belegost),
    # five Shared Callings for Band-based solo play in Moria,
    # and the Band system for managing Allies.
    # ─────────────────────────────────────────────
    # DWARVES OF NOGROD AND BELEGOST
    # ─────────────────────────────────────────────
    ^"Dwarves of Nogrod and Belegost" DEF {
        EXTENDS ^"HeroicCulture"
        # Source: Moria — Through the Doors of Durin
        PROPERTIES {
            ^"Culture Name" STRING "Dwarves of Nogrod and Belegost" FIXED
            ^"Standard of Living" STRING "Common" FIXED
            ^"Cultural Blessing Name" STRING "Redoubtable" FIXED
            ^"Cultural Blessing" STRING "Halve the Load rating of any armour you're wearing (rounding fractions up), including helms (but not shields)." FIXED
            ^"Cultural Weakness" STRING "PETTY-DWARVES: Cannot use great bow, great spear, or great shield. You can only choose another Dwarf as your Fellowship Focus." FIXED
            ^"Languages" LIST ["Common Tongue", "Dwarvish (secret)"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Ai", "Anar", "Beli", "Bláin", "Borin", "Burin", "Bruni", "Farin", "Flói", "Frár", "Frerin", "Frór", "Ginar", "Gróin", "Grór", "Hanar", "Hepti", "Iari", "Lófar", "Lóni", "Náli", "Nár", "Niping", "Nói", "Núr", "Nýrád", "Ónar", "Póri", "Regin", "Svior", "Veig", "Vidar"] FIXED
                ^"Female" LIST ["Adís", "Afrid", "Agda", "Bersa", "Birna", "Dagrún", "Dís", "Drífa", "Edda", "Elin", "Fenja", "Frida", "Geira", "Gísla", "Hadda", "Hón", "Ida", "Ilmr", "Jóra", "Kára", "Kóna", "Líf", "Línhild", "Már", "Mist", "Nál", "Oda", "Ósk", "Rán", "Rinda", "Sefa", "Syn", "Tóra", "Trana", "Úlfrún", "Vírún", "Yrr"] FIXED
            }
        }
        # Choose one set of Attributes, or roll 1d6 to determine set.
        ATTRIBUTE_ARRAYS {
            1
            : [STR 7, HEART 2, WITS 5]
            2
            : [STR 7, HEART 3, WITS 4]
            3
            : [STR 6, HEART 3, WITS 5]
            4
            : [STR 6, HEART 4, WITS 4]
            5
            : [STR 5, HEART 4, WITS 5]
            6
            : [STR 6, HEART 2, WITS 6]
        }
        DERIVED_STATS {
            ^"Endurance"
            FORMULA "Strength + 22"
            ^"Hope"
            FORMULA "Heart + 8"
            ^"Parry"
            FORMULA "Wits + 10"
        }
        # Copy listed ranks; choose one Favoured skill from the two marked [F].
        STARTING_SKILLS {
            ^"Awe"
            2
            [F] ^"Enhearten" 0       ^"Persuade"  0
            ^"Athletics"
            1 ^"Travel"
            2 ^"Stealth"
            0 ^"Awareness"
            0 ^"Insight"
            0 ^"Scan"
            3 ^"Hunting"
            0 ^"Healing"
            0 ^"Explore"
            2 ^"Song"
            1 ^"Courtesy"
            0 ^"Riddle"
            2 ^"Craft"
            3
            [F] ^"Battle"   0       ^"Lore"      2
        }
        STARTING_PROFICIENCIES "Axes or Swords 2, choose one other Combat Proficiency 1"
        DISTINCTIVE_FEATURES CHOOSE 2 ["Cunning", "Fierce", "Proud", "Rustic", "Secretive", "Stern", "Wary", "Wilful"]
        # Shares most virtues with Dwarves of Durin's Folk, but replaces
        # "Broken Spells" and "Durin's Way" with "Ancient Fire" and
        # "Telchar's Secrets".
        CULTURAL_VIRTUES [^"Baruk Khazâd!", ^"Ancient Fire", ^"Dark for Dark Business", ^"Telchar's Secrets", ^"Stone-hard", ^"Untameable Spirit"]
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — NOGROD AND BELEGOST
    # ─────────────────────────────────────────────
    # Note: "Baruk Khazâd!", "Dark for Dark Business", "Stone-hard",
    # and "Untameable Spirit" are defined in tor2e-2e-core-virtues.ttrpg
    # under Dwarves of Durin's Folk. These are shared.
    ^"Ancient Fire" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Ancient Fire" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Dwarves of Nogrod and Belegost" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Endurance rating by 1 point. Any Endurance loss from extreme cold, fire, and poison you suffer is reduced by one level (grievous to severe, severe to moderate, moderate to none)." FIXED
        }
    }
    ^"Telchar's Secrets" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Telchar's Secrets" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Dwarves of Nogrod and Belegost" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Next Yule, you may either add a single Enchanted Reward of Dwarven craftsmanship to a mail armour or close combat weapon of your choice, or create a Marvellous Artefact (your choice)." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # SHARED CALLINGS (MORIA BAND PLAY)
    # ─────────────────────────────────────────────
    # Shared Callings replace individual Callings when playing
    # solo in Moria with a Band of Allies. They apply to both
    # the Player-hero and the Band.
    ^"SharedCalling" DEF {
        PROPERTIES {
            ^"Calling Name" STRING REQUIRED
            ^"Disposition Focus" STRING REQUIRED
            ^"Favoured Skills" LIST REQUIRED
            ^"Choose Favoured" INTEGER MIN 1 MAX 3 DEFAULT 2
            ^"Shadow Path" STRING REQUIRED
            ^"Description" STRING
        }
    }
    ^"Reclaimers" DEF {
        EXTENDS ^"SharedCalling"
        PROPERTIES {
            ^"Calling Name" STRING "Reclaimers" FIXED
            ^"Disposition Focus" STRING "Expertise" FIXED
            ^"Favoured Skills" LIST ["Craft", "Lore", "Scan"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Shadow Path" STRING "Dragon-sickness" FIXED
            ^"Description" STRING "Reclaimers are driven by the desire to restore what was lost and reclaim the glories of the past. They are scholars, artisans, and seekers of ancient knowledge." FIXED
        }
    }
    ^"Pathfinders" DEF {
        EXTENDS ^"SharedCalling"
        PROPERTIES {
            ^"Calling Name" STRING "Pathfinders" FIXED
            ^"Disposition Focus" STRING "Manoeuvre" FIXED
            ^"Favoured Skills" LIST ["Athletics", "Explore", "Travel"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Shadow Path" STRING "Lure of Secrets" FIXED
            ^"Description" STRING "Pathfinders are scouts and explorers, always seeking the next passage, the hidden way, the forgotten road through the darkness." FIXED
        }
    }
    ^"Standard-bearers" DEF {
        EXTENDS ^"SharedCalling"
        PROPERTIES {
            ^"Calling Name" STRING "Standard-bearers" FIXED
            ^"Disposition Focus" STRING "Rally" FIXED
            ^"Favoured Skills" LIST ["Enhearten", "Persuade", "Song"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Shadow Path" STRING "Lure of Power" FIXED
            ^"Description" STRING "Standard-bearers are leaders and inspirers, keeping hope alive among their companions through stirring words and deeds." FIXED
        }
    }
    ^"Guardians" DEF {
        EXTENDS ^"SharedCalling"
        PROPERTIES {
            ^"Calling Name" STRING "Guardians" FIXED
            ^"Disposition Focus" STRING "Vigilance" FIXED
            ^"Favoured Skills" LIST ["Awareness", "Healing", "Insight"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Shadow Path" STRING "Path of Despair" FIXED
            ^"Description" STRING "Guardians are watchful protectors, vigilant against threats both physical and spiritual, tending to the well-being of their companions." FIXED
        }
    }
    ^"Vanguards" DEF {
        EXTENDS ^"SharedCalling"
        PROPERTIES {
            ^"Calling Name" STRING "Vanguards" FIXED
            ^"Disposition Focus" STRING "War" FIXED
            ^"Favoured Skills" LIST ["Awe", "Battle", "Stealth"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Shadow Path" STRING "Curse of Vengeance" FIXED
            ^"Description" STRING "Vanguards are warriors and tactical leaders, first into the breach and last to retreat." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # MORIA SOLO PLAY RULES
    # ─────────────────────────────────────────────
    ^"Moria Solo Play" DEF {
        PROPERTIES {
            ^"Name" STRING "Moria Solo Play Rules" FIXED
            ^"Previous Experience" INTEGER 15 FIXED
            ^"Fellowship Rating" STRING "3 + bonuses from Virtues, Cultural Blessings, Patron" FIXED
            ^"Maximum Hope Bonus" INTEGER 5 FIXED
            ^"Default Patron" STRING "Balin" FIXED
            ^"Description" STRING "Solo play in Moria uses Shared Callings instead of standard Callings. Previous Experience is 15 AP. Fellowship Rating is 3 plus any bonuses. Maximum Hope is increased by 5 (representing Band support). Balin is the default Patron (Fellowship bonus +1, Balin's Counsel: spend Fellowship to make combat rolls Favoured)." FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    # ─────────────────────────────────────────────
    # BAND OF ALLIES
    # ─────────────────────────────────────────────
    # An Ally is one member of the Band accompanying the solo Player-hero.
    # INJURY and FATIGUE are tracked PER-ALLY as condition ladders (the fatigue
    # ladder here is the Ally's own condition track, distinct from the numeric
    # Fatigue points a Player-hero accrues in core-base). BURDEN, by contrast,
    # is a single band-wide level and lives on ^"Band System", not here.
    #TORMAlly00000001 ACTOR "Ally" DEF {
        PROPERTIES {
            ^"Name" STRING
            ^"Gift" STRING
            ^"Quirk" STRING
            ^"Injury Condition" ENUM ["None", "Fleeting", "Moderate", "Severe", "Grievous", "Lingering"] DEFAULT "None"
            ^"Fatigue Condition" ENUM ["None", "Fatigued", "Faltering", "Spent", "Collapsed"] DEFAULT "None"
            ^"Hardened" BOOLEAN DEFAULT false
            ^"Out of Action" BOOLEAN DEFAULT false
            ^"Suffering Serious Condition" BOOLEAN DEFAULT false
            ^"Source" STRING DEFAULT "Moria — Through the Doors of Durin"
        }
        RULES {
            #TORMAllySerious01: WHEN [^"Out of Action" OR ^"Injury Condition" is Severe, Grievous or Lingering OR ^"Fatigue Condition" is Spent or Collapsed] THEN ^"Ally" IS suffering a serious condition
        }
    }
    # ─────────────────────────────────────────────
    # BAND SYSTEM
    # ─────────────────────────────────────────────
    # The Band governs the group of ^"Ally" members under the Player-hero's
    # command during solo play in Moria.
    ^"Band System" DEF {
        PROPERTIES {
            ^"Name" STRING "Band of Allies" FIXED
            ^"Ally Type" ^"Ally"
            ^"Starting Allies" INTEGER 6 FIXED
            ^"Starting Readiness" INTEGER 4 FIXED
            ^"Readiness TN Formula" STRING "20 minus Readiness value" FIXED
            ^"Dispositions" LIST ["Expertise", "Manoeuvre", "Rally", "Vigilance", "War"] FIXED
            ^"Default Disposition Rating" INTEGER 2 FIXED
            ^"Burden" ENUM ["Light", "Medium", "Heavy", "Overburdened"] DEFAULT "Medium"
            ^"Serious Injury Conditions" LIST ["Severe", "Grievous", "Lingering"] FIXED
            ^"Serious Fatigue Conditions" LIST ["Spent", "Collapsed"] FIXED
            ^"Weary" BOOLEAN DEFAULT false
            ^"Description" STRING "The Band represents a group of Dwarf Allies accompanying the Player-hero. Group actions are resolved through Disposition rolls (Feat die + Success dice equal to the Disposition rating) against the Band's Readiness TN (20 minus Readiness), which also lets Allies resist injuries and fatigue and stand against fear. Each Ally has a unique Gift and Quirk and may be Hardened through acts of bravery." FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
        RULES {
            #TORMBandWeary001: WHEN [half or more (rounding up) of the Band's ^"Ally" members are Out of Action or Suffering a Serious Condition] THEN ^"Band System" IS Weary
        }
    }
    SPEC_VERSION "0.4"
    ^"Snake-like Speed" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Snake-like Speed" FIXED
            ^"Effect" STRING "When targeted by an attack, spend 1 Hate to make the attack roll *Ill-favoured*." FIXED
        }
    }
    ^"Yell of Triumph" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Yell of Triumph" FIXED
            ^"Effect" STRING "Spend 1 Hate to restore 1 Hate to all allies in the fight." FIXED
        }
    }
    ^"Thick Armour" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Thick Armour" FIXED
            ^"Effect" STRING "Spend 1 Hate to *gain (2d)* on a Protection roll." FIXED
        }
    }
    ^"Deadly Wound" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Deadly Wound" FIXED
            ^"Effect" STRING "Wounded targets make an *Ill-favoured* Feat die roll to determine the severity of their Injury." FIXED
        }
    }
    ^"Demon of Might" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Demon of Might" FIXED
            ^"Effect" STRING "The Balrog is immune to Endurance loss and Wounds from all sources of injury except magical weapons, and can spend 1 Hate to cancel a Wound from such weapons (unless they have been wrought for the Bane of the Enemy itself). When an attack inflicts damage to the Balrog that would cause it to go to zero Endurance, it causes a Piercing Blow instead. Then, if the Balrog is still alive, its Endurance score is set back at half its maximum rating." FIXED
        }
    }
    ^"Flame of Udûn" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Flame of Udûn" FIXED
            ^"Effect" STRING "When a Player-hero hits the Balrog with a close combat attack, the Player-hero suffers severe Endurance loss from fire damage. The Balrog cannot use this ability when immersed in water." FIXED
        }
    }
    ^"Ghastly Wings" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Ghastly Wings" FIXED
            ^"Effect" STRING "The creature can attack any Player-hero, in any combat stance, including Rearward." FIXED
        }
    }
    ^"Wind-like Speed" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Wind-like Speed" FIXED
            ^"Effect" STRING "All attack rolls against the creature are *Ill-favoured*." FIXED
        }
    }
    ^"Poison" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Poison" FIXED
            ^"Effect" STRING "If an attack results in a Wound, the target is also poisoned (see page 134 of *The One Ring*)." FIXED
        }
    }
    ^"Mock" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Mock" FIXED
            ^"Effect" STRING "When a nearby Player-hero fails any roll, spend 1 Hate to make them gain 2 Shadow points (Sorcery)." FIXED
        }
    }
    ^"Yell of Alarm" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Yell of Alarm" FIXED
            ^"Effect" STRING "Spend 1 Hate to raise the Eye Awareness of the Company by 1. If the total Eye Awareness is equal to or greater than the Hunt Threshold, there is an immediate Revelation episode." FIXED
        }
    }
    ^"Foul Dust" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Foul Dust" FIXED
            ^"Effect" STRING "Spend 1 Hate to inflict a moderate Endurance loss from Poison to all Player-heroes in close combat stance." FIXED
        }
    }
    ^"Dull-witted" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Dull-witted" FIXED
            ^"Effect" STRING "Player-heroes can attempt a special combat task against Uftak while in Forward stance. The acting player makes a **RIDDLE** roll as the main action for the round: on a success, Uftak loses 1 point of Hate, plus 1 point for each Success icon rolled." FIXED
        }
    }
    ^"Fearless" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Fearless" FIXED
            ^"Effect" STRING "Har’s Might is considered 1 higher for the purpose of resisting the Intimidate Foe combat task." FIXED
        }
    }
    ^"Hatred (Elves and Dúnedain)" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Hatred (Elves and Dúnedain)" FIXED
            ^"Effect" STRING "When targeting the object of his hatred, all attacks are *Favoured*." FIXED
        }
    }
    ^"Lesser Ring of Power" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Lesser Ring of Power" FIXED
            ^"Effect" STRING "Spend 1 Hate to cancel a success (not a Magical success) on any Skill roll made by a nearby Player-hero. The roll becomes a failure instead." FIXED
        }
    }
    ^"Spirit" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Spirit" FIXED
            ^"Effect" STRING "Spend 1 Hate to cancel a Wound. When an attack inflicts damage to the creature that would cause it to go to zero Endurance, it causes a Piercing Blow instead. Then, if the creature is still alive, it returns to full Endurance. This ability is ineffective against Player-heroes wielding any magical weapon." FIXED
        }
    }
    ^"Invisible" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Invisible" FIXED
            ^"Effect" STRING "This creature is invisible, and **AWARENESS**, **SCAN**, and attack rolls against it *lose (2d)*, while the creature’s attack rolls are *Favoured* and *gain (1d)* against Player-heroes who cannot see it. A Player-hero who obtains a Magical success on an **AWARENESS** or **SCAN** roll can see the creature normally and ignores all penalties for the rest of the fight." FIXED
        }
    }
    ^"Lifeless" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Lifeless" FIXED
            ^"Effect" STRING "Spend 1 Resolve to cancel a Wound. When an attack inflicts damage to the creature that would cause it to go to zero Endurance, spend 1 Resolve to bring the creature back to full Endurance again." FIXED
        }
    }
    ^"Snap Blade" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Snap Blade" FIXED
            ^"Effect" STRING "When a close combat weapon scores a Piercing Blow against the Stone Ghost, spend 1 Resolve to break that weapon. This ability does not affect weapons with one or more Rewards (enchanted or otherwise)." FIXED
        }
    }
    ^"Long Arms" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Long Arms" FIXED
            ^"Effect" STRING "Spend 1 Hate to attack any Player-hero, in any combat stance, including rearward (same as *Great Leap*)." FIXED
        }
    }
    ^"Many Arms" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Many Arms" FIXED
            ^"Effect" STRING "The Watcher in the Water makes one additional attack each round. Each time it receives a Wound, however, for the rest of the fight the Watcher in the Water can make one less attack." FIXED
        }
    }
    ^"Keening Wail" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Keening Wail" FIXED
            ^"Effect" STRING "Spend 1 Hate to make all Player-heroes who can hear the creature gain 2 Shadow points (Dread). Those who fail their Shadow test are daunted and cannot spend Hope for the rest of the fight." FIXED
        }
    }
    SPEC_VERSION "0.4"
    #tfwj6tKVGnpEPfiSCXi01qpd ^"Gem of the Stag" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Gem of the Stag" FIXED
            ^"Description" STRING "A disc of green glass, engraved with the image of a stag standing on a hilltop. Footprints seen through the disc glow faintly. Made as a gift for the Elves of Eregion, and especially potent in lands that remember them." FIXED
            ^"Blessing Skill" STRING "Hunting" FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #tmRGjl2sD5s9VXdMIYCLslnw ^"Ring of Riddles" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Ring of Riddles" FIXED
            ^"Description" STRING "A ring of gold, set with a large red stone. Those who speak with the wearer feel as though they are relaxing by a fireside with merry company, no matter the circumstances." FIXED
            ^"Blessing Skill" STRING "Riddle" FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #tUr4tydz61ojaS12kSdgfrVB ^"Silver Dream of the Smith" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Silver Dream of the Smith" FIXED
            ^"Description" STRING "A silver necklace of such surpassing craftsmanship and delicacy that it inspires those who study it. Often, they share the dreams or memories of great smiths who lived in ages past." FIXED
            ^"Blessing Skill" STRING "Craft" FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #tLdWBaJ8vjpavaIi52eC4AXl ^"Brazen Head" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Brazen Head" FIXED
            ^"Description" STRING "The cast head of a Dwarven scholar, with vocal cords of Mithril and eyes of polished quartz. Under moonlight, it whispers secrets. Said to have been forged by the mad Dwarf-scholar Dero, who descended into unknown tunnels beneath the world and returned with strange tales and secrets." FIXED
            ^"Blessing Skill" STRING "Lore" FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #trsz1ykmrcWXSHhVjeATkUKy ^"Scabbard of Thunder" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Scabbard of Thunder" FIXED
            ^"Description" STRING "An ornate sheath for a sword, made of polished black leather and brass, decorated with images of storm-clouds and lightning bolts. When a weapon is drawn from it, thunder rolls. Made for a King of the North-men in the Second Age of the world." FIXED
            ^"Blessing Skill" STRING "Awe" FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #tvVSbRjI3YCQZSJMSvz2ign5 ^"War-horn of the Underworld" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "War-horn of the Underworld" FIXED
            ^"Description" STRING "Made from a Dragon's horn, bound in steel, and marked with runes of power, this horn has not been sounded since the elder days. It also carries a curse — if blown, whoever hastens to aid the bearer is doomed, and their Protection rolls in battle are Ill-favoured." FIXED
            ^"Blessings" LIST ["Battle", "Enhearten"] FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #t6GX0ZWxKiicYa36275B5qsp ^"Staff of the Roadwarden" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "Staff of the Roadwarden" FIXED
            ^"Description" STRING "A black staff bound in mithril that grants these blessings in addition to any other properties (described in more detail on page 134)." FIXED
            ^"Blessings" LIST ["Explore", "Scan"] FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #tPHgssRneqEJ795wLKskJqwe ^"Harp of the Cascades" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "Harp of the Cascades" FIXED
            ^"Description" STRING "A harp associated with the Dimrill Stair and a maiden who dwelt there long ago, in love with a shepherd who perished in the winter snows. She sang a lament until her fingers bled and her heart froze, and she too perished. Despite this sad tale, the harp bears no curse." FIXED
            ^"Blessings" LIST ["Song", "Insight"] FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #tskiLWktQPmF7H18IDmlUCAf ^"Iron-shod Boots" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "Iron-shod Boots" FIXED
            ^"Description" STRING "Made for Dwarven messengers in the days of many Dwarven kingdoms. Heavy boots with soles of iron, yet marvellously light and comfortable." FIXED
            ^"Blessings" LIST ["Athletics", "Travel"] FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    #t7iDx0XheiiPIjUARADlLmuV ^"Circlet of Queen Edrys" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "Circlet of Queen Edrys" FIXED
            ^"Description" STRING "A circlet of Mithril studded with pearls, marked with runes of law and judgement." FIXED
            ^"Blessings" LIST ["Awareness", "Courtesy"] FIXED
            ^"Source" STRING "Moria — Through the Doors of Durin" FIXED
        }
    }
    SPEC_VERSION "0.4"
    CHAMBER_TYPE_TABLE {
        ROLL "Feat die"
        NAME "Chamber Type Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Eye of Sauron"
        { RESULT "Orc-nest" DESCRIPTION "This room was not built by the Dwarves — it is a den of Orcs." }
        ^"1"
        { RESULT "Utility" DESCRIPTION "Moria contained endless small passageways and tunnels off the main thoroughfares. Some of these held aqueducts for carrying fresh water down from the heights; others were air ducts, or sewers. Still others were the equivalent of servants' hallways or backstreets. Those who knew Khazad-dûm well could move from one end of the city to the other unseen. Goblins explored most of these little byways, but some remain undiscovered to this day." }
        ^"2"
        { RESULT "Storeroom" DESCRIPTION "Vast were the cellars and storehouses of Moria. Many of these storerooms were given over to food; the Dwarves had a terrible fear of rats eating their winter supplies, so they built cunning mousetraps and bred small dogs to guard their supplies. The descendants of these dogs, grown blind and hairless, still run wild in the dark." }
        ^"3"
        { RESULT "Small Dwelling" DESCRIPTION "A house for a single Dwarf. Dwarven families were rare — Dwarven women numbered no more than a third of the population, and not every Dwarf wished to marry, so many Dwarves lived alone. Small dwellings like these typically centred around a workroom, work being the centre of a Dwarf's life, with the bedroom and other necessities off to the side. Some clusters of dwellings opened onto a courtyard or shared space, often with a large oven for communal cooking." }
        ^"4"
        { RESULT "Stairs" DESCRIPTION "As Khazad-dûm extended over many levels, the Dwarves built great stone concourses — and, in later years, mechanical elevators powered by waterwheels or by hauling on ropes. The larger stairs in the city were also public auditoria where the affairs of the day were discussed." }
        ^"5"
        { RESULT "Well or Watercourse" DESCRIPTION "Wells drew water from both natural and Dwarf-built reservoirs. The neglect and malice of the Goblins means that few of the artificial reservoirs survive, and all wells within Moria are suspect." }
        ^"6"
        { RESULT "Guard Post or Armoury" DESCRIPTION "Especially in its latter years, Moria was a fortress. While the gates of Khazad-dûm were never breached in any siege, the city was endangered by Goblin sappers, who would dig tunnels from the Goblin-caves of the Misty Mountains to break into the mines." }
        ^"7"
        { RESULT "Forge" DESCRIPTION "The forges of Moria were wonders indeed — they were clustered around titanic chimneys and flues, so that many fires could share the same air vents. At first, the forges were fired with wood, and the hungry axes of the Dwarves devoured the forests of Dimrill Dale. Later, the deep forges were dug, fuelled by coal. The Goblins continued to use some of the deep forges, but centuries of accumulated debris have blocked the air shafts, so the lower levels are choked with soot and smoke." }
        ^"8"
        { RESULT "Workshop" DESCRIPTION "The Dwarves wrought wonders, especially in the days of their friendship with the Elves of Hollin. They were chiefly known for their mastery of smithing and metallurgy, but there were all manner of crafts — the Dwarves may love metal and stone, but also they carve wood and weave cloth with equal diligence." }
        ^"9"
        { RESULT "Large Dwelling" DESCRIPTION "Extended Dwarven families lived in mansions, where several generations would live in the same complex. A great door connected each dwelling with the rest of the city, and this door carried the sigil of the clan." }
        ^"10"
        { RESULT "Civic Building" DESCRIPTION "Moria was a place of scholarship and culture, and the city had many libraries, archives, galleries and meeting-halls. The Dwarves were exacting historians and academics — and they delighted in bureaucracy too, considering ink as fine a thing to work with as gold or iron. Many of the civic buildings of the Dwarrowdelf, alas, burned when the city fell, and much knowledge was lost." }
        ^"Gandalf Rune"
        { RESULT "Great Hall" DESCRIPTION "The Halls where the Dwarves gathered. They were markets and feast-halls, debating chambers and places of prayer; the mansions of princes and chieftains. It was in the Halls that the Dwarves housed their most cherished works, and where they glorified their heroes and ancestors." }
    }
    CONDITION_TABLE {
        ROLL "Feat die"
        NAME "Condition Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Eye of Sauron"
        { RESULT "Held by foes" DESCRIPTION "This chamber is occupied by living adversaries — Orcs, Trolls or other foul creatures, rival treasure hunters, or something more dangerous. Draw your weapons and prepare to fight!" }
        ^"1"
        { RESULT "Blocked" DESCRIPTION "The chamber is inaccessible, at least by this route. The door may be shut and barred from the inside, or the access corridor is blocked by fallen rocks, or some other barrier stops the Company from proceeding. Many of the doors in Moria were magical, and Dwarf-doors cannot be found unless you know what you are looking for. It may be possible to find another way in." }
        ^"2"
        { RESULT "Suspiciously intact" DESCRIPTION "The chamber is remarkably intact — is something guarding it? Is there some hidden peril, like poisonous gas, that keeps intruders out?" }
        ^"3"
        { RESULT "Flooded" DESCRIPTION "The chamber is flooded with water. In the upper levels, it is likely that some broken pipe or aqueduct now rushes through the chamber before cascading into the depths; in the Deeps, the chamber may be flooded with standing water." }
        ^"4"
        { RESULT "Utterly ruined" DESCRIPTION "The ceiling has fallen in, the chamber has collapsed, or it is so smashed as to be unrecognisable. Nothing can be salvaged here." }
        ^"5"
        { RESULT "Goblin-gnawed" DESCRIPTION "Goblins are like woodworms — they riddle the place with tunnels and hidey-holes. Some of these little tunnels may lead to the Goblin-caves of the mountains; others might conceal a host of Goblins lurking in the dark." }
        ^"6"
        { RESULT "Shattered by earthquake" DESCRIPTION "The mountains grumble and stir in their sleep, especially violent Caradhras. Chasms have opened in the floor of those chambers damaged but not destroyed by tremors; in some cases, these chasms may lead down to lower levels." }
        ^"7"
        { RESULT "Burnt" DESCRIPTION "Terrible fires raged through much of the city when Durin's Bane arose; other, lesser fires swept through other parts of Moria when the Goblins meddled with the Dwarven forges. The stone walls of burnt chambers may be mostly intact, but little else remains." }
        ^"8"
        { RESULT "Despoiled" DESCRIPTION "Goblins are full of malice, and love to destroy and to deface beautiful things. This chamber is largely intact, but everything in it has been deliberately broken or made ugly — or rigged with traps." }
        ^"9"
        { RESULT "Ruined by the passage of time" DESCRIPTION "The chamber is exposed to wind or water, or has been filled with the slow accumulation of dust and snow. Maybe a thousand generations of spiders nest here. In any case, the chamber has succumbed to rot and few of its original fittings remain." }
        ^"10"
        { RESULT "Mostly intact" DESCRIPTION "The chamber is dark and cold, but otherwise remarkably well-preserved. The Player-heroes might catch a brief glimpse of how this place once looked, and be cheered by the thought that the Orcs cannot conquer forever!" }
        ^"Gandalf Rune"
        { RESULT "A safe place to rest" DESCRIPTION "The chamber feels… well, if not safe, then at least defensible. As long as no fool of a Took throws anything down a well, the Company might be able to rest here for a few hours without being discovered." }
    }
    APPEARANCE_TABLE {
        ROLL "Feat die"
        NAME "Appearance Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Eye of Sauron"
        { RESULT "Shunned" DESCRIPTION "For some reason, this chamber was shunned by the Dwarves. Perhaps they sealed or even bricked up the doors, and carved runes of warning upon the lintel. Peril or darkness lingers here." }
        ^"1"
        { RESULT "Unfinished" DESCRIPTION "The chamber was in the process of being constructed or repaired when the city fell, and the job remains unfinished. Scaffolding like the skeleton of some beast looms out of the darkness, and the tools of the builders lie where they were left. Any Dwarf in the Company feels the prickling urge to get the job finished." }
        ^"2"
        { RESULT "Austere" DESCRIPTION "The chamber is bare of all decoration — or perhaps any ornament was wiped away by the ravages of time. Little information can be gleaned from the bare stone walls." }
        ^"3"
        { RESULT "Ancient" DESCRIPTION "Chambers such as this one were built early in the history of Moria, perhaps all the way back in Durin's day. The stonecraft is marvellous; the style simple but well executed." }
        ^"4"
        { RESULT "Simple" DESCRIPTION "An unremarkable chamber, little more than functional. No Lord or Dwarf of note ever dwelt here; nor were great deeds performed in it." }
        ^"5"
        { RESULT "Heroic" DESCRIPTION "The room is decorated in a heroic style — likely with statues of Dwarven heroes of old, or carvings of battles. There may be places on the walls where weapons and armour were mounted long ago." }
        ^"6"
        { RESULT "Homely" DESCRIPTION "The chamber was built for comfort, not grandeur. It is low-ceilinged, with the hearth close at hand." }
        ^"7"
        { RESULT "Richly decorated" DESCRIPTION "Even the rot and ruin of a thousand years of neglect and occupation cannot erase the astounding artistry of this chamber. Every surface was decorated in some fashion — carved to resemble fabulous creatures, gilded or girded in expensive stone. This was a place of prestige and grandeur; if there are still treasures to be found in Moria, then surely they are nearby." }
        ^"8"
        { RESULT "Elven" DESCRIPTION "This chamber was built when the Dwarves of Moria were friends with the Elves of Hollin, and much evil must befall a place before it wholly forgets the Elves, if once they dwelt there. Perhaps there are living plants here, or lamps of crystal, or the echo of forgotten songs — or a lingering touch of magic." }
        ^"9"
        { RESULT "Fortified" DESCRIPTION "This chamber was built in the last days of Moria, when the Dwarves feared attack from without. The walls are especially thick, the doors reinforced to withstand assault, everything made to hold out against Orcs or Dragons or other servants of the Enemy." }
        ^"10"
        { RESULT "Natural" DESCRIPTION "Not a chamber, but a cavern or other natural opening in the rock, adapted by the Dwarves." }
        ^"Gandalf Rune"
        { RESULT "Enchanted" DESCRIPTION "Roll again, but this chamber has some Dwarf-magic in it. Perhaps there are fragments of spells worked into the stone, or runes of power upon the door." }
    }
    CHALLENGE_TABLE {
        ROLL "Feat die"
        NAME "Challenge Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Eye of Sauron"
        { RESULT "Combat" DESCRIPTION "The Company faces an immediate peril — a foul creature, an ambush, a hazard. There is no way of avoiding this peril: they must defeat the enemy in order to survive." }
        ^"1"
        { RESULT "None (Desolation)" DESCRIPTION "Not every room demands dice-rolling, and not every room hides some secret. This chamber is empty and long-abandoned. Emphasising the desolation of the ruined city makes other encounters more memorable." }
        ^"2"
        { RESULT "Athletics" DESCRIPTION "Part of this chamber has collapsed or been blocked by debris; to pass through the chamber, the Company must climb or leap over the obstacles; failure risks injury." }
        ^"3"
        { RESULT "Battle" DESCRIPTION "Enemies are closing in, and the Player-heroes must make a choice whether to lie in ambush, fortify their position — by barring the access to the chamber for example — or leave in haste. A successful roll of BATTLE can help them in adjudicating the situation." }
        ^"4"
        { RESULT "Enhearten" DESCRIPTION "Something in the chamber reminds the Company of the current state of the once-great city of the Dwarves, filling the Player-heroes with a sense of hopelessness. A successful roll of ENHEARTEN is required to raise their spirits — otherwise, everyone in the Company is considered to be Ill-favoured on their next roll." }
        ^"5"
        { RESULT "Healing" DESCRIPTION "The chamber is filled by invisible noxious fumes that causes the Player-heroes to cough incessantly, and their eyes to water. A HEALING roll allows them to continue their exploration." }
        ^"6"
        { RESULT "Hunting" DESCRIPTION "Foes have passed this way recently; a HUNTING roll permits the Company to determine which way they went, and if they are still close at hand. Failure raises the Eye Awareness Level by 1." }
        ^"7"
        { RESULT "Lore" DESCRIPTION "This chamber was once of significance, but only the learned recall its secrets. A successful roll of LORE is required to understand the importance of the place." }
        ^"8"
        { RESULT "Riddle" DESCRIPTION "The chamber is in the middle of a complicated maze of multiple passages and twisting corridors. A successful roll of RIDDLE points the Company towards the right direction." }
        ^"9"
        { RESULT "Stealth" DESCRIPTION "The chamber or the passages opening from it seem to intensify all sounds. If the Player-heroes fail at a STEALTH roll, they make a terrible noise (see Drums in the Deep, on page 39)." }
        ^"10"
        { RESULT "None (Foreshadowing)" DESCRIPTION "There is no immediate danger, but the chamber contains some inkling or affords a glimpse of impending doom. Perhaps the chamber has a balcony looking down at the caves outside, and the Company glimpses shadowy figures creeping through the gloom; a desiccated corpse hints at a nearby trap; a secret door lets a burglar eavesdrop on two Orcs talking about what the \"Boss\" has planned for the intruders." }
        ^"Gandalf Rune"
        { RESULT "Token of hope" DESCRIPTION "Something in the chamber inspires the Company to believe that their quest will not be in vain. Maybe daylight breaks through a distant sky-shaft, or one of the Dwarven Player-heroes spots the ancient sigil of their clan carved above a doorway, or maybe there is just the glint of a gold jewel amid the rubble." }
    }
    FEAT_DIE_TABLE {
        DESCRIPTION "To randomly generate a band of Orcs roaming into Moria, roll the Feat-die once to determine the leader, and 1 Success die per Player-hero."
        ROLL "Feat die"
        NAME "Feat Die Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Eye of Sauron"
        { RESULT "A named Orc leader, a Great Orc Chief, or a Great Cave-troll" }
        ^"1–2"
        { RESULT "Cave-troll Slinker" }
        ^"3–5"
        { RESULT "Great Orc Bodyguard" }
        ^"6–10"
        { RESULT "Orc-chieftain" }
        ^"Gandalf Rune"
        { RESULT "Orc-chieftain" DESCRIPTION "Orc-chieftain, and the enemies are sleeping, feasting, distracted, or already engaged in some task — the Company can take them by surprise." }
    }
    SUCCESS_DIE_TABLE {
        DESCRIPTION "Roll 1 Success die per Player-hero and compare each die roll individually on the table below, adding up the foes encountered."
        ROLL "Success die"
        NAME "Success Die Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"1"
        { RESULT "1 Great Orc Bodyguard" }
        ^"2"
        { RESULT "1 Orc Guard and 1 Goblin Archer" }
        ^"3"
        { RESULT "2 Orc Soldiers" }
        ^"4"
        { RESULT "1 Orc Guard" }
        ^"5"
        { RESULT "1 Orc Soldier" }
        ^"6"
        { RESULT "1 Goblin Archer" }
    }
    SPEC_VERSION "0.4"
    THE_TELLING_TABLE {
        DESCRIPTION "Use the Telling table when posing questions answerable by \"yes\" or \"no.\" Ask your question, with \"yes\" being the positive outcome; set the chance of a \"yes\" (with \"middling\" as the default); roll one Feat die and consult the Telling table for your answer. Rolling either the rune or Eye icon results in an automatic yes or no, respectively, with an extreme result or twist."
        ROLL "Feat die"
        NAME "The Telling Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"1 or greater"
        { RESULT "Certain" }
        ^"4 or greater"
        { RESULT "Likely" }
        ^"6 or greater"
        { RESULT "Middling" }
        ^"8 or greater"
        { RESULT "Doubtful" }
        ^"10"
        { RESULT "Unthinkable" }
        ^"Gandalf Rune"
        { RESULT "Always yes, with an extreme result or twist" }
        ^"Eye of Sauron"
        { RESULT "Always no, with an extreme result or twist" }
    }
    THE_LORE_TABLE {
        DESCRIPTION "Use the Lore table to help reveal details when asking an open-ended question about a situation or event. The table includes four columns: Action, Aspect, Focus, and Feature. You can roll on one column for a single word prompt, or two or more to construct a prompt phrase. To roll on the table, use one Feat die to determine the section, and one Success die for the row. Each result is given as Action / Aspect / Focus / Feature."
        ROLL "Feat die and Success die"
        NAME "The Lore Table"
        SOURCE "Moria — Through the Doors of Durin"
        ^"Feat Gandalf Rune / Success 1"
        { RESULT "Believe / Alluring / Courage / Artefact" }
        ^"Feat Gandalf Rune / Success 2"
        { RESULT "Bolster / Cheery / Duty / Artwork" }
        ^"Feat Gandalf Rune / Success 3"
        { RESULT "Defend / Gentle / Fellowship / Illumination" }
        ^"Feat Gandalf Rune / Success 4"
        { RESULT "Forgive / Good / Hope / Plants" }
        ^"Feat Gandalf Rune / Success 5"
        { RESULT "Resist / Kind / Love / Shelter" }
        ^"Feat Gandalf Rune / Success 6"
        { RESULT "Strengthen / Wondrous / Peace / Treasure" }
        ^"Feat Eye of Sauron / Success 1"
        { RESULT "Abandon / Corrupted / Curse / Darkness" }
        ^"Feat Eye of Sauron / Success 2"
        { RESULT "Attack / Cruel / Despair / Ruin" }
        ^"Feat Eye of Sauron / Success 3"
        { RESULT "Betray / Deceptive / Enemy / Blood" }
        ^"Feat Eye of Sauron / Success 4"
        { RESULT "Corrupt / Fell / Fear / Bones" }
        ^"Feat Eye of Sauron / Success 5"
        { RESULT "Defeat / Despoiled / Shadow / Corpse" }
        ^"Feat Eye of Sauron / Success 6"
        { RESULT "Weaken / Treacherous / War / Trap" }
        ^"Feat 1 / Success 1"
        { RESULT "Aid / Abandoned / Ally / Archive" }
        ^"Feat 1 / Success 2"
        { RESULT "Ambush / Adorned / Border / Armament" }
        ^"Feat 1 / Success 3"
        { RESULT "Arrive / Ancient / Burden / Barricade" }
        ^"Feat 1 / Success 4"
        { RESULT "Await / Blocked / Community / Battlefield" }
        ^"Feat 1 / Success 5"
        { RESULT "Breach / Bold / Council / Bridge" }
        ^"Feat 1 / Success 6"
        { RESULT "Break / Broken / Court / Cave-in" }
        ^"Feat 2 / Success 1"
        { RESULT "Capture / Cheerless / Death / Chill" }
        ^"Feat 2 / Success 2"
        { RESULT "Change / Colossal / Decay / Container" }
        ^"Feat 2 / Success 3"
        { RESULT "Chase / Concealed / Defence / Creature" }
        ^"Feat 2 / Success 4"
        { RESULT "Command / Dangerous / Doubt / Dead-end" }
        ^"Feat 2 / Success 5"
        { RESULT "Control / Dead / Dream / Debris" }
        ^"Feat 2 / Success 6"
        { RESULT "Craft / Defended / Fate / Doorway" }
        ^"Feat 3 / Success 1"
        { RESULT "Defy / Destroyed / Folk / Dust" }
        ^"Feat 3 / Success 2"
