    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # FELLOWSHIP RULES
    # ─────────────────────────────────────────────
    FELLOWSHIP_RULES {
        STARTING_FELLOWSHIP "Equal to the number of Player-heroes in the group; augmented by Virtues, Cultural Blessings, and the Patron's Fellowship Points bonus."
        SPENDING "Spend Fellowship points to recover Hope when resting, or to trigger special effects tied to the Company's Patron."
        REFRESH "Fully refreshed at the end of each gaming session."
        SHARED_POOL "Fellowship is a common pool shared by all Player-heroes; any expenditure must be agreed upon by all Player-heroes in the Company."
        SAFE_HAVEN "The Company's starting base of operations and refuge for the Fellowship Phase. New safe havens may be added as the Company explores."
    }
    FELLOWSHIP_FOCUS {
        DESCRIPTION "Each player chooses one member of the Company as their Player-hero's Fellowship Focus. The bond does not have to be mutual."
        SUPPORT "Player-heroes providing support to their Fellowship Focus make them gain (2d) instead of (1d)."
        SHADOW_COST "Player-heroes gain 1 Shadow point whenever their Fellowship Focus is Wounded, suffers a bout of madness, or is otherwise seriously harmed. This Shadow gain cannot be prevented with a Shadow Test."
    }
    # ─────────────────────────────────────────────
    # PATRONS
    # ─────────────────────────────────────────────
