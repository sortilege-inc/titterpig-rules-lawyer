            1 ^"Enhearten"
            0 ^"Persuade"
            0 ^"Athletics"
            2
            [F] ^"Travel"   0       ^"Stealth"   3 [F]
            ^"Awareness"
            2 ^"Insight"
            0 ^"Scan"
            2 ^"Hunting"
            2 ^"Healing"
            1 ^"Explore"
            1 ^"Song"
            2 ^"Courtesy"
            0 ^"Riddle"
            0 ^"Craft"
            1 ^"Battle"
            1 ^"Lore"
            2
        }
        STARTING_PROFICIENCIES "Bows or Spears 2, choose one other Combat Proficiency 1"
        DISTINCTIVE_FEATURES CHOOSE 2 ["Cunning", "Fair", "Fierce", "Keen-eyed", "Merry", "Proud", "Secretive", "Swift"]
        CULTURAL_VIRTUES [^"Against the Unseen", ^"Deadly Archery", ^"Elf-Lights", ^"Elvish Dreams", ^"Gleam of Wrath", ^"Shots in the Dark"]
    }
    # ─────────────────────────────────────────────
    # WOODMEN OF WILDERLAND
    # ─────────────────────────────────────────────
    ^"Woodmen of Wilderland" DEF {
        EXTENDS ^"HeroicCulture"
        # Source: Peoples of Wilderland
        PROPERTIES {
            ^"Culture Name" STRING "Woodmen of Wilderland" FIXED
            ^"Standard of Living" STRING "Frugal" FIXED
            ^"Cultural Blessing Name" STRING "Wood-Goer" FIXED
            ^"Cultural Blessing" STRING "Add +2 to your Parry rating when fighting in a forest." FIXED
            ^"Languages" LIST ["Common Tongue"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Amalric", "Ansegisel", "Audovald", "Balderic", "Beranald", "Beormud", "Ebrimuth", "Euric", "Gisalric", "Grimbald", "Gundovald", "Hartgard", "Hartnid", "Imnachar", "Ingelram", "Malaric", "Munderic", "Odo", "Odovacar", "Reginar", "Ricfried", "Sigibert", "Sunnegisil", "Theodebert", "Theodemir", "Theudebald", "Theuderic", "Waleran", "Willicar"] FIXED
                ^"Female" LIST ["Adosinda", "Amalfrida", "Amalina", "Avagisa", "Avina", "Basina", "Beranhild", "Brunihild", "Deuteria", "Gailavira", "Garsendis", "Geleswinta", "Gelvira", "Grimhild", "Gunteuch", "Hermesind", "Heva", "Hilduara", "Ingund", "Radegund", "Sichild", "Verich", "Waldrada", "Wisigard"] FIXED
                ^"Nicknames" LIST ["the Bird-keeper", "the Bowman", "the Bride", "the Bright one", "the Eagle", "the Healer", "the Hound", "the Hunter", "the Quick", "the Shepherd", "the Shield-bearer", "the Silent one", "the Spear-shaker", "the Wood-goer"] FIXED
            }
        }
        # Choose one set of Attributes, or roll 1d6 to determine set.
        ATTRIBUTE_ARRAYS {
            1
            : [STR 2, HEART 5, WITS 7]
            2
            : [STR 3, HEART 4, WITS 7]
            3
            : [STR 3, HEART 5, WITS 6]
            4
            : [STR 4, HEART 4, WITS 6]
            5
            : [STR 4, HEART 5, WITS 5]
            6
            : [STR 2, HEART 6, WITS 6]
