            ^"Description" STRING "A blue sapphire cut in the shape of a water drop, said to be the frozen tear of the Elf-maid Nimrodel. It sharpens the senses and brightens the spirit." FIXED
            ^"Blessings" LIST ["Awareness", "Song"] FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
