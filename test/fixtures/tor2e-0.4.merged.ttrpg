        # Attribute arrays: same as Men of Bree.
        ATTRIBUTE_ARRAYS {
            1
            : [STR 2, HEART 5, WITS 7]
            2
            : [STR 3, HEART 4, WITS 7]
            3
            : [STR 3, HEART 5, WITS 6]
            4
            : [STR 4, HEART 4, WITS 6]
            5
            : [STR 4, HEART 5, WITS 5]
            6
            : [STR 2, HEART 6, WITS 6]
        }
        # Derived stats: uses Hobbit formulas, not Men of Bree.
        DERIVED_STATS {
            ^"Endurance"
            FORMULA "Strength + 18"
            ^"Hope"
            FORMULA "Heart + 10"
            ^"Parry"
            FORMULA "Wits + 12"
