        DISTINCTIVE_FEATURES CHOOSE 2 ["Cunning", "Fair-spoken", "Faithful", "Generous", "Inquisitive", "Patient", "Rustic", "True-hearted"]
        # Cultural Virtues: distinct list (mix of Bree and Hobbit virtues).
        CULTURAL_VIRTUES [^"Bree-pony", ^"Desperate Courage", ^"Small Folk", ^"Strange as News from Bree", ^"The Art of Smoking", ^"Tough as Old Tree-roots"]
    }
    # ─────────────────────────────────────────────
    # RANGERS OF THE NORTH (DÚNEDAIN)
