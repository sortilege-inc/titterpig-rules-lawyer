        DISTINCTIVE_FEATURES CHOOSE 2 ["Bold", "Honourable", "Secretive", "Stern", "Subtle", "Swift", "Tall", "True-hearted"]
        CULTURAL_VIRTUES [^"Endurance of the Ranger", ^"Foresight of their Kindred", ^"Heir of Arnor", ^"Royalty Revealed", ^"Shadow of the Past", ^"Ways of the Wild"]
    }
    SPEC_VERSION "0.4"
    # Callings represent a Hero's motivation for leaving home and facing danger.
    # Each grants Favoured Skills, a Distinctive Feature, and defines a Shadow Path.
    ^"Calling" DEF {
        PROPERTIES {
            ^"Calling Name" STRING REQUIRED
            ^"Favoured Skills" LIST REQUIRED
            ^"Choose Favoured" INTEGER MIN 1 MAX 3 DEFAULT 2
            ^"Calling Distinctive Feature" STRING REQUIRED
            ^"Shadow Path" STRING REQUIRED
            ^"Shadow Path Description" STRING
            ^"Description" STRING
        }
    }
    # ─────────────────────────────────────────────
    # CAPTAIN
    # ─────────────────────────────────────────────
    ^"Captain" DEF {
        EXTENDS ^"Calling"
        PROPERTIES {
            ^"Calling Name" STRING "Captain" FIXED
            ^"Favoured Skills" LIST ["Battle", "Enhearten", "Persuade"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Calling Distinctive Feature" STRING "Leadership" FIXED
            ^"Shadow Path" STRING "Lure of Power" FIXED
            ^"Shadow Path Description" STRING "When individuals are given a position of authority, either by rank, lineage, or stature, they may end up mistaking their own aggrandisement for the greater good of the people they should be guiding or keeping safe. Power is the quintessential temptation, and provides the Shadow with an easy way to win the hearts of those who desire it." FIXED
            ^"Description" STRING "When the world is on the brink of ruin, it is the duty of all individuals of worth to rise and take the lead, whatever the risk. You have chosen to put your judgement to the service of others, to guide them in this dark hour. But you don't want others to heed your commands out of fear or obedience — you want them to follow you because they trust you." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CHAMPION
    # ─────────────────────────────────────────────
    ^"Champion" DEF {
        EXTENDS ^"Calling"
        PROPERTIES {
            ^"Calling Name" STRING "Champion" FIXED
            ^"Favoured Skills" LIST ["Athletics", "Awe", "Hunting"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Calling Distinctive Feature" STRING "Enemy-Lore" FIXED
            ^"Enemy-Lore Specialisation" ENUM ["Evil Men", "Orcs", "Spiders", "Trolls", "Wargs", "Undead"] DEFAULT "Orcs"
            ^"Shadow Path" STRING "Curse of Vengeance" FIXED
            ^"Shadow Path Description" STRING "Individuals who live by the sword are ever tempted to draw it, either literally or figuratively, when their will is thwarted or when they deem their honour to have been impugned by an insult. As corruption spreads in their spirit, their behaviour worsens, leading to more extreme violent reactions." FIXED
            ^"Description" STRING "You deem that there is but one way to oppose the return of the Shadow, and that it is to conquer it by strength of arms. You are recognised as a warrior among your folk, a valiant fighter, onward into battle. For you, the road to adventure leads straight to wherever your foes prowl or hide." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # MESSENGER
    # ─────────────────────────────────────────────
    ^"Messenger" DEF {
        EXTENDS ^"Calling"
        PROPERTIES {
            ^"Calling Name" STRING "Messenger" FIXED
            ^"Favoured Skills" LIST ["Courtesy", "Song", "Travel"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Calling Distinctive Feature" STRING "Folk-Lore" FIXED
            ^"Shadow Path" STRING "Wandering-Madness" FIXED
            ^"Shadow Path Description" STRING "Travelling afar might be the duty chosen by a messenger, but it carries the risk of never finding a place to fight for. The Road goes ever on and on, it's true, but whither then?" FIXED
            ^"Description" STRING "The Wise hold that evil days lie ahead, and that to keep hope, all who fight the Enemy must be as one. Yet, many miles and centuries of isolation separate the Free Peoples, and estrangement breeds mistrust. You have decided that it is your duty to travel to distant lands, carrying tidings and warning people of the coming danger." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # SCHOLAR
    # ─────────────────────────────────────────────
    ^"Scholar" DEF {
        EXTENDS ^"Calling"
        PROPERTIES {
            ^"Calling Name" STRING "Scholar" FIXED
            ^"Favoured Skills" LIST ["Craft", "Lore", "Riddle"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Calling Distinctive Feature" STRING "Rhymes of Lore" FIXED
            ^"Shadow Path" STRING "Lure of Secrets" FIXED
            ^"Shadow Path Description" STRING "Inquisitiveness and curiosity are desirable virtues in an individual, but knowledge can be put to malicious use, and learned individuals can look down on others as ignorant fools. Secrets are dangerous, as the very desire of uncovering them may corrupt the heart." FIXED
            ^"Description" STRING "For you, knowledge makes the wild world a less threatening place. Yellowed maps in lost books replace a fear of the unknown with curiosity and wonder, songs composed in ages past strengthen the weariest of hearts. A love of learning guides your every step, and illuminates the way for you and those who listen to your advice." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # TREASURE HUNTER
    # ─────────────────────────────────────────────
    ^"Treasure Hunter" DEF {
        EXTENDS ^"Calling"
        PROPERTIES {
            ^"Calling Name" STRING "Treasure Hunter" FIXED
            ^"Favoured Skills" LIST ["Explore", "Scan", "Stealth"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Calling Distinctive Feature" STRING "Burglary" FIXED
            ^"Shadow Path" STRING "Dragon-Sickness" FIXED
            ^"Shadow Path Description" STRING "Adventurers who find themselves on the Road to seek lost riches run the risk of catching the age-old disease capable of turning a pile of enchanted gold into bitter ashes. As the Shadow tightens its grip on their hearts, the world shrinks around them and their closely guarded possessions." FIXED
            ^"Description" STRING "The world has seen the passing of the glory of many Dwarven kings and Elven lords, and their heritage is now buried in Orc-infested dungeons. Hoards of stolen gold and jewels, guarded by fell beasts, beckon all who dare to find them. You seek to recover what is lost, even when it means braving unspeakable dangers." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # WARDEN
    # ─────────────────────────────────────────────
    ^"Warden" DEF {
        EXTENDS ^"Calling"
        PROPERTIES {
            ^"Calling Name" STRING "Warden" FIXED
            ^"Favoured Skills" LIST ["Awareness", "Healing", "Insight"] FIXED
            ^"Choose Favoured" INTEGER 2 FIXED
            ^"Calling Distinctive Feature" STRING "Shadow-Lore" FIXED
            ^"Shadow Path" STRING "Path of Despair" FIXED
            ^"Shadow Path Description" STRING "Self-doubt is often the way that the Shadow chooses to reach the heart of those who oppose it. For they know that the Enemy is strong and terrible and that those they protect are too naive or weak to fend for themselves. Every day they ask themselves: will my strength be enough to prevail, or will I drag down the innocent in defeat?" FIXED
            ^"Description" STRING "In this age of the world, when shadows grow deeper with every passing year, you have sworn to defend all who cannot defend themselves. Often, your choice forces you to forsake civilised areas, to better guard their inhabitants from what lurks right outside their fences. This has made you a stranger in the eyes of the common folk, a threatening figure like those you are protecting them from." FIXED
        }
    }
    SPEC_VERSION "0.4"
    # Virtues are earned at WISDOM 2+ and represent a Hero's deep self-knowledge.
    # Standard Virtues are available to all cultures.
    # Cultural Virtues are unlocked only by Heroes of the matching culture.
    # ─────────────────────────────────────────────
    # STANDARD VIRTUES (advancement — post-creation only)
    # ─────────────────────────────────────────────
    # A Player-hero may choose a new Virtue each time they gain a new rank
    # in Wisdom. Each Virtue can be acquired only once. These are available
    # to heroes from all cultures. NOT the same as Starting Virtues (which
    # are in core-base.ttrpg and are only available during character creation).
    ^"Confidence" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Confidence" FIXED
            ^"Description" STRING "Overcoming difficulties has reinforced your spirit and renewed your faith in a brighter future." FIXED
            ^"Culture" STRING "Standard" FIXED
            ^"Minimum Wisdom" INTEGER 1 FIXED
            ^"Effect" STRING "Raise your maximum Hope rating by 2 points." FIXED
        }
    }
    ^"Dour-handed" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Dour-handed" FIXED
            ^"Description" STRING "Your blows have become more forceful and your aim steadier, allowing you to do greater harm." FIXED
            ^"Culture" STRING "Standard" FIXED
            ^"Minimum Wisdom" INTEGER 1 FIXED
            ^"Effect" STRING "When inflicting Special Damage in combat, add +1 to your STRENGTH rating on a Heavy Blow, and +1 to the Feat Die numerical result on a Pierce." FIXED
        }
    }
    ^"Hardiness" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Hardiness" FIXED
            ^"Description" STRING "Your determination and stamina have improved through hardship and toil." FIXED
            ^"Culture" STRING "Standard" FIXED
            ^"Minimum Wisdom" INTEGER 1 FIXED
            ^"Effect" STRING "Raise your maximum Endurance rating by 2 points, or by your WISDOM rating, whichever is higher." FIXED
        }
    }
    ^"Mastery" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Mastery" FIXED
            ^"Description" STRING "You have practised certain skills until they have become as natural as breathing." FIXED
            ^"Culture" STRING "Standard" FIXED
            ^"Minimum Wisdom" INTEGER 1 FIXED
            ^"Effect" STRING "Choose two Skills and make them Favoured." FIXED
        }
    }
    ^"Nimbleness" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Nimbleness" FIXED
            ^"Description" STRING "Your skill (or fortune?) in battle has increased with your growth in wisdom." FIXED
            ^"Culture" STRING "Standard" FIXED
            ^"Minimum Wisdom" INTEGER 1 FIXED
            ^"Effect" STRING "Raise your Parry rating by 1 point." FIXED
        }
    }
    ^"Prowess" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Prowess" FIXED
            ^"Description" STRING "Adventuring is honing your inborn talents." FIXED
            ^"Culture" STRING "Standard" FIXED
            ^"Minimum Wisdom" INTEGER 1 FIXED
            ^"Effect" STRING "Lower one of your Attribute TNs by 1." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — BARDINGS
    # ─────────────────────────────────────────────
    ^"Cram" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Cram" FIXED
            ^"Description" STRING "You have been taught the ancient recipe of cram, a biscuit-ish cake that keeps good indefinitely, made by your folk for long journeys. Albeit certainly not entertaining (and in fact, mostly a chewing exercise), it is doubtlessly sustaining and very nutritious." FIXED
            ^"Culture" STRING "Bardings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Each time you gain Fatigue from a Journey Event, you gain 1 point less. Additionally, when you take a Short Rest, you and all members of the Company regain an extra amount of lost Endurance equal to your WISDOM rating." FIXED
        }
    }
    ^"Dragon-slayer" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Dragon-slayer" FIXED
            ^"Description" STRING "The legend of Bard the Bowman has inspired many young men and women from Dale, so much so that they long to prove their worth with the killing of a great monster. As many have before you, you have long pondered on the ways to deal with large creatures, hoping one day to gain renown defeating them." FIXED
            ^"Culture" STRING "Bardings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you are fighting creatures with Might 2 or more, all your attack rolls are Favoured." FIXED
        }
    }
    ^"Dwarf-friend" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Dwarf-friend" FIXED
            ^"Description" STRING "The days of the Dragon have forged a strong alliance between the Bardings and the Dwarves of Erebor." FIXED
            ^"Culture" STRING "Bardings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "If your Fellowship focus is a Dwarf, whoever among you is fighting in a Defensive stance may attempt the Protect Companion combat task to benefit the other as a secondary action. Additionally, Dwarves are always considered to be Friendly towards you during the Interaction stage of a council." FIXED
        }
    }
    ^"Fierce Shot" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Fierce Shot" FIXED
            ^"Description" STRING "The Black Arrow that brought down Smaug the Dragon may have been fated to do so, but the hand that sent it flying so fiercely was exceedingly strong. When you throw a spear or bend your bow, you make sure that your grip is steady and your aim true." FIXED
            ^"Culture" STRING "Bardings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you score a Piercing Blow on a ranged attack, the PROTECTION roll of the target is Ill-favoured." FIXED
        }
    }
    ^"High Destiny" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "High Destiny" FIXED
            ^"Description" STRING "Stories tell that those who belong to the bloodline of Dale are destined for greatness, a fact proven true by your King and his story. Do you share the same destiny of those of the line of Girion?" FIXED
            ^"Culture" STRING "Bardings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Endurance rating by 1. The first time that you receive a Wound that would normally kill you — a deadly wound — you are saved by some miraculous circumstance that leaves you Wounded but alive, and you immediately raise your maximum Hope rating by 1 point. Then, your destiny is completed (you can do this only once)." FIXED
        }
    }
    ^"The Language of Birds" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "The Language of Birds" FIXED
            ^"Description" STRING "Stories told in the North speak of how Dalemen can become so wise as to comprehend the speech of birds, and so by understanding their song be forewarned of impending threats, or be able to spot a weakness in their enemies' defences." FIXED
            ^"Culture" STRING "Bardings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "You can communicate with any bird with appropriate Skill rolls, usually using COURTESY, PERSUADE, or SONG, to receive tidings, deliver messages, and so on. Additionally, when you are outside, once during each Combat, Council or Journey, you can choose to become Inspired on any one roll." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — DWARVES OF DURIN'S FOLK
    # ─────────────────────────────────────────────
    ^"Baruk Khazâd!" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Baruk Khazâd!" FIXED
            ^"Description" STRING "The secret tongue of the Dwarves is guarded as a treasure of the past, yet their battle-cry is well-known and feared by their chief foes." FIXED
            ^"Culture" STRING "Dwarves of Durin's Folk" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Once per combat, when you fight in a Forward stance you can make your attack roll Favoured and attempt the Intimidate Foe combat task as a secondary action." FIXED
        }
    }
    ^"Broken Spells" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Broken Spells" FIXED
            ^"Description" STRING "In ancient times, the Dwarves made mighty spells. You have been taught fragments of old enchantments that retain some power to this day." FIXED
            ^"Culture" STRING "Dwarves of Durin's Folk" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Choose three Skills in which you possess at least one rank and mark them on your character sheet. Whenever you use any one of the three marked Skills, you can spend 1 Hope to achieve a Magical success." FIXED
        }
    }
    ^"Dark for Dark Business" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Dark for Dark Business" FIXED
            ^"Description" STRING "Your kind is not troubled by mere darkness in itself, as most of the members of other cultures are. On the contrary, you have grown to like the dark better than the light, finding yourself at ease in its cold embrace." FIXED
            ^"Culture" STRING "Dwarves of Durin's Folk" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you are in the dark (at night, or underground) you are Inspired on all your rolls." FIXED
        }
    }
    ^"Durin's Way" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Durin's Way" FIXED
            ^"Description" STRING "The Dwarves have fought many wars in deep places beneath the earth. You have been taught how to best defend yourself while fighting underground. As a result, you know how to exploit corners, darkness, and other natural obstacles to your advantage." FIXED
            ^"Culture" STRING "Dwarves of Durin's Folk" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Add +2 to your Parry rating when fighting underground, or in otherwise cramped quarters, like inside a building." FIXED
        }
    }
    ^"Stone-hard" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Stone-hard" FIXED
            ^"Description" STRING "The Dwarves were made to be strong and to endure, for they came unto the world when a great evil ruled Middle-earth. As long as your spirit supports your strength, you can resist any hurt of the body more hardily than most." FIXED
            ^"Culture" STRING "Dwarves of Durin's Folk" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Endurance rating by 1. All your PROTECTION rolls are Favoured, as long as you are not Miserable." FIXED
        }
    }
    ^"Untameable Spirit" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Untameable Spirit" FIXED
            ^"Description" STRING "Dwarves were made from their beginning to resist any form of domination. You have strengthened your resolve against all but the most subtle of the weapons of the Enemy." FIXED
            ^"Culture" STRING "Dwarves of Durin's Folk" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Hope rating by 1 point. You gain (1d) on all Shadow Tests made to resist the effects of Sorcery." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — ELVES OF LINDON
    # ─────────────────────────────────────────────
    ^"Against the Unseen" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Against the Unseen" FIXED
            ^"Description" STRING "Elves can perceive creatures that dwell in the wraith-world, be they spirits or ghosts, even when they are normally invisible to the eyes of the living and appear only as a chilling whisper of voices. You have learnt to strengthen your heart against such terrors." FIXED
            ^"Culture" STRING "Elves of Lindon" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "All your Shadow Tests due to Dread are Favoured, and you additionally gain (1d) on those rolls forced upon you by an evil spirit or ghost (including creatures possessed by one)." FIXED
        }
    }
    ^"Deadly Archery" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Deadly Archery" FIXED
            ^"Description" STRING "Elves possess a natural talent for hitting the mark when using their bows. You have honed this talent almost to perfection, and your arrows find their target with uncanny precision." FIXED
            ^"Culture" STRING "Elves of Lindon" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When using a Bow (not a Great Bow) and fighting in Rearward Stance, you may attempt the Prepare Shot combat task as a secondary action." FIXED
        }
    }
    ^"Elbereth Gilthoniel!" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Elbereth Gilthoniel!" FIXED
            ^"Description" STRING "The name of Elbereth, the Queen of the Stars, is revered by all the Eldar still dwelling in Middle-earth. You have resorted to calling on her name in moments of great need, asking the Kindler to bestow her grace upon you." FIXED
            ^"Culture" STRING "Elves of Lindon" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Hope rating by 1 point. During the Adventuring Phase you can become Inspired on a number of rolls equal to your WISDOM rating." FIXED
        }
    }
    ^"Elvish Dreams" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Elvish Dreams" FIXED
            ^"Description" STRING "The spirit of Elves is so strong that their bodies recover swiftly from many ills and injuries. As your WISDOM has grown you have felt less and less the need to lie down to get better. Instead, you can recover from your exertions while awake, finding repose in the secret way of your folk." FIXED
            ^"Culture" STRING "Elves of Lindon" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "You don't need to sleep, as long as you can engage in simple, repetitive activities. When you take a Short Rest you are considered to have had a Prolonged Rest instead." FIXED
        }
    }
    ^"Gleam of Wrath" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Gleam of Wrath" FIXED
            ^"Description" STRING "Your folk have seen many defeats, and many fruitless victories in their wars against the Shadow. The deadly rage that your kindred harbour for the Enemy infuses your weapons with a gleam of chill flame." FIXED
            ^"Culture" STRING "Elves of Lindon" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "On a successful attack roll your adversary additionally loses one point of Hate or Resolve, plus one point for each Success icon." FIXED
        }
    }
    ^"Memory of Ancient Days" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Memory of Ancient Days" FIXED
            ^"Description" STRING "Long centuries and uncounted generations of Men seem but a little while to the Elves. Your memories go back to a time before Eriador became desolate, and your knowledge of the land is returning to you now that you are traveling again outside the boundaries of your realm." FIXED
            ^"Culture" STRING "Elves of Lindon" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you are targeted by a Journey Event while you are in a Wild Land, roll on the Journey Events table as if you were in a Border Land, and as if you were in a Wild Land if you are in a Dark Land. Moreover, in addition to your chosen role you are always allowed to cover the Scout role." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — HOBBITS OF THE SHIRE
    # ─────────────────────────────────────────────
    ^"Art of Disappearing" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Art of Disappearing" FIXED
            ^"Description" STRING "Hobbits are said to have little or no magic about them, but the way they can choose to disappear quickly and quietly can be described by others only as supernatural. You have learnt to choose exactly the right moment to turn away from the attention of others, sometimes unconsciously anticipating the need to disappear." FIXED
            ^"Culture" STRING "Hobbits of the Shire" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "If a location or a situation offers even the smallest opportunity to hide or sneak silently away, make a STEALTH roll: if you succeed, you simply disappear. You can choose to reveal yourself at any moment by simply stepping out into the open from your hiding place." FIXED
        }
    }
    ^"Brave at a Pinch" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Brave at a Pinch" FIXED
            ^"Description" STRING "One of the Wise once said that you have to put a Hobbit in a tight place before you find out what is in them. You prefer to avoid finding yourself in one, but you are also sure you would be able to take good care of yourself in the circumstances." FIXED
            ^"Culture" STRING "Hobbits of the Shire" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "As long as you are Miserable, Weary, or Wounded, you are Inspired on all your rolls." FIXED
        }
    }
    ^"Small Folk" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Small Folk" FIXED
            ^"Description" STRING "Hobbits are a little people, but their resourcefulness far exceeds their stature. You have learnt how to exploit your small size to your advantage in a fight." FIXED
            ^"Culture" STRING "Hobbits of the Shire" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you are engaged in close combat with a creature bigger than you (very often!) you add +2 to your Parry rating. Additionally, you can assume a Rearward stance in combat even if there is only one other Company member fighting in a Close Combat stance." FIXED
        }
    }
    ^"Sure at the Mark" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Sure at the Mark" FIXED
            ^"Description" STRING "Hobbits are nimble and keen-eyed, qualities that make them good archers. You have honed this natural talent to perfection, so much so that you just need to stoop for a stone to find yourself armed with a deadly weapon." FIXED
            ^"Culture" STRING "Hobbits of the Shire" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "All your ranged attacks are Favoured. If you attack by throwing a stone, the roll produces a Piercing Blow on a result of the Gandalf rune, with an Injury rating of 12." FIXED
        }
    }
    ^"Three is Company" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Three is Company" FIXED
            ^"Description" STRING "The Wise say that it is sometimes best to trust to friendship than to great wisdom. This is particularly true for Hobbits, as everyone knows that it is hardly possible to separate them from their friends. You have given your trust to your fellow Company members, and a true friendship has grown from the bond unifying you." FIXED
            ^"Culture" STRING "Hobbits of the Shire" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your Company's Fellowship rating by 1 point. Additionally, you may select a second Fellowship Focus." FIXED
        }
    }
    ^"Tough as Old Tree-roots" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Tough as Old Tree-roots" FIXED
            ^"Description" STRING "They say that Hobbits are difficult to dismay or kill, and that they recover their health at a prodigious pace if allowed to enjoy some peace and quiet. You have discovered that you recover wonderfully from falls and bruises (at the cost of some considerable pain)." FIXED
            ^"Culture" STRING "Hobbits of the Shire" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you are Wounded and must roll to determine the severity of your injury, you roll two Feat Dice instead of one and choose the better of the two results. In addition, double your STRENGTH score when calculating the number of Endurance points you recover when resting." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — MEN OF BREE
    # ─────────────────────────────────────────────
    ^"Bree-pony" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Bree-pony" FIXED
            ^"Description" STRING "Bree-ponies are very similar to their owners, the Bree-folk — they don't seem to have anything special compared to their peers in other parts of Middle-earth, and yet some of them display uncommon courage and exceptional memory. You have acquired an unusually brave and intelligent beast that follows you everywhere." FIXED
            ^"Culture" STRING "Men of Bree" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Hope rating by 1 point. Additionally, your pony has a Vigour rating of 4 (regardless of your Standard of Living). Your pony never leaves your side. If you are forced to abandon it, you can choose to find the pony where you left it when you return, or to have it find its way back to Bree." FIXED
        }
    }
    ^"Defiance" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Defiance" FIXED
            ^"Description" STRING "Many realms have risen and fallen in the Lone-lands of Eriador since the Elder Days. Only ruins remain to mark their boundaries. Yet, the Bree-men have endured, revealing an unexpected reserve of strength and vigour in the face of adversity." FIXED
            ^"Culture" STRING "Men of Bree" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Endurance rating by 1. At the end of each Combat scene, if you are not Wounded or Miserable, you recover a number of Endurance points equal to your HEART or WISDOM score." FIXED
        }
    }
    ^"Desperate Courage" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Desperate Courage" FIXED
            ^"Description" STRING "You have lived all your life on the edge of the Wild, but the worst news that has come to Bree in your time concerned only brigands or packs of hungry wolves. You don't know yet what the likes of you can do against the Shadow in the East, but you are sure you will stand against it, no matter the cost." FIXED
            ^"Culture" STRING "Men of Bree" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you choose to spend Hope on a roll, you can choose to also gain 1 Shadow to be Inspired for that roll." FIXED
        }
    }
    ^"Friendly and Familiar" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Friendly and Familiar" FIXED
            ^"Description" STRING "Since you started your adventures, you have realised that your folk's custom of trading with foreigners may help you in your endeavours. Your nice manners and friendly demeanor easily gain the sympathies of those you meet, and your ability to inquire about the doings of strangers, without letting curiosity get the better of you, provide you with many opportunities to learn from those you meet along the way." FIXED
            ^"Culture" STRING "Men of Bree" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise by 1 the maximum number of Skill rolls that you may attempt in the course of a council. Additionally, the folk encountered are always considered Friendly towards you." FIXED
        }
    }
    ^"Strange as News from Bree" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Strange as News from Bree" FIXED
            ^"Description" STRING "It is indeed true that the affairs of the four villages are the chief concern of the Bree-folk, but the most inquisitive among the inhabitants are always ready to gather what tidings come from distant lands. You have learnt that listening to the strange tales that travellers often talk about can prove to be very precious." FIXED
            ^"Culture" STRING "Men of Bree" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "During each Fellowship Phase, you receive a rumour from the Loremaster. In addition, if you are in the Bree-land, you gain (1d) on all INSIGHT and RIDDLE rolls." FIXED
        }
    }
    ^"The Art of Smoking" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "The Art of Smoking" FIXED
            ^"Description" STRING "You have mastered the art of smoking pipe-weed, and you always carry your pipe with you, as well as a bag of tobacco, for using it grants you patience and clarity of mind." FIXED
            ^"Culture" STRING "Men of Bree" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Whenever you regain one or more points of Hope, you recover one additional Hope point (regardless of whether it's the Adventuring or Fellowship Phase)." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — RANGERS OF THE NORTH
    # ─────────────────────────────────────────────
    ^"Endurance of the Ranger" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Endurance of the Ranger" FIXED
            ^"Description" STRING "They say that a Ranger with a clear trail to follow can never be weary. You hope the saying will prove true, as it will be your fate to often travel in haste, to seek distant lands on urgent errands or to relentlessly hunt your enemies." FIXED
            ^"Culture" STRING "Rangers of the North" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Endurance rating by 1 point. If you wear a suit of Leather armour (with no helm) or no armour at all, and carry no shield, you never gain Fatigue during a journey." FIXED
        }
    }
    ^"Foresight of their Kindred" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Foresight of their Kindred" FIXED
            ^"Description" STRING "The Rangers of the North still possess a measure of the foresight that their ancestors possessed in full. In the Twilight of the Third Age, this gift manifests as a sense of watchfulness, and of fear, arising to warn a Ranger of a danger that has not yet come to pass." FIXED
            ^"Culture" STRING "Rangers of the North" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "During an Adventuring Phase, you may invoke your gift of foresight a number of times equal to your WISDOM rating, to bestow it upon yourself or on another member of the Company. This gift can be spent at any moment to reroll all the dice involved in any one roll, whether made by the Player-hero or an adversary targeting them." FIXED
        }
    }
    ^"Heir of Arnor" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Heir of Arnor" FIXED
            ^"Description" STRING "The days of your folk have darkened, and not many of you remain; but ever the memory of the Kings is passed from generation to generation. An artefact going back to the days of Lost Arnor has been in possession of your family in line unbroken. Now you have been deemed worthy to become its keeper." FIXED
            ^"Culture" STRING "Rangers of the North" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "With the help of the Loremaster, create either a Marvellous Artefact, or a Famous Weapon possessing a single Enchanted Reward and up to 2 normal Rewards." FIXED
        }
    }
    ^"Royalty Revealed" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Royalty Revealed" FIXED
            ^"Description" STRING "Your kin belongs to a bloodline of kings, but they have learnt to hide from their enemies in the twilight years of their kingdom. Should you choose to reveal your heritage, your noble bearing will cause your allies to cast away their doubts. You reveal yourself by shouting an ancestral battle-cry, or unsheathing a weapon of high lineage, or by showing a device or coat of arms." FIXED
            ^"Culture" STRING "Rangers of the North" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Once per combat, when you fight in an Open stance you may attempt the Rally Comrades combat task as a secondary action. Additionally, all members of the Company (you included) are Inspired on all their rolls in the following round." FIXED
        }
    }
    ^"Strength of Will" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Strength of Will" FIXED
            ^"Description" STRING "You have been raised in a land dotted with desolate ruins and burial mounds. You have heard the dead whisper with cold voices out of lonely barrows, while ghostly lights dance on haunted hills. When your will strengthens your heart, there is hardly anything in this world that can dismay you." FIXED
            ^"Culture" STRING "Rangers of the North" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "You gain (1d) on all Shadow Tests made to resist the effects of Dread." FIXED
        }
    }
    ^"Ways of the Wild" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Ways of the Wild" FIXED
            ^"Description" STRING "The Rangers of the North roam ceaselessly, hunting for wicked things and guarding all frontiers. For you the Wild has become as familiar as the road that leads home is familiar to Hobbits, and the land itself may reveal useful tidings." FIXED
            ^"Culture" STRING "Rangers of the North" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Whenever you are making a roll using EXPLORE, HUNTING, or TRAVEL, you can spend 1 Hope to achieve a Magical success. Additionally, you are always allowed to cover more than one role during a journey." FIXED
        }
    }
    SPEC_VERSION "0.4"
    # The Shadow is the corrupting influence of the Enemy upon the Free
    # Peoples. Player-heroes accumulate Shadow points during the
    # Adventuring Phase and may lose them through Shadow Tests, Harden
    # Will, or Spiritual Recovery during a Fellowship Phase.
    # 
    # Each Calling is tied to a Shadow Path — a particular form of
    # corruption. Flaws are gained through bouts of madness, not from
    # failed Shadow Tests. Four Flaws = the hero succumbs to the Shadow.
    # ─────────────────────────────────────────────
    # SHADOW POINTS
    # ─────────────────────────────────────────────
    SHADOW_POINTS {
        DESCRIPTION "Challenging an almost all-powerful Enemy and facing its terrible minions is bound to instil a sense of fear and doubt in the Player-heroes, a sentiment that in time comes to weigh heavily on their hearts and minds. This burden is represented by the accumulation of Shadow points, and by the sources that force their gain."
        TRACKING "Shadow points are kept track of by marking them in the appropriate box on the character sheet, next to a hero's Hope rating."
        MAXIMUM "Heroes cannot accumulate Shadow in excess of their maximum Hope score — any additional points gained do not raise a hero's Shadow score."
        FLOW "In the course of play, the Player-heroes see their Shadow score ebb and flow, as they gain points during the Adventuring Phase as a consequence of their actions, and then they possibly lose them by making a Shadow Test, by strengthening their resolve (see Harden Will), or by mending their spiritual hurt during a Fellowship Phase (see Spiritual Recovery)."
    }
    # ─────────────────────────────────────────────
    # SHADOW TESTS
    # ─────────────────────────────────────────────
    SHADOW_TESTS {
        DESCRIPTION "A number of sources of Shadow allow players to make a roll to cancel, or at least reduce, the amount of points gained. Called Shadow Tests, these rolls are based using either VALOUR or WISDOM, depending on the specific source of Shadow."
        RESOLUTION "Shadow Tests are resolved as any other roll, by using a Feat die, plus a number of Success dice equal to the character's appropriate rating."
        EFFECT "When a Shadow Test is passed, the hero reduces the number of Shadow points gained by 1 point on a success, plus 1 for each Tengwar icon rolled."
    }
    # ─────────────────────────────────────────────
    # CONSEQUENCES OF SHADOW
    # ─────────────────────────────────────────────
    CONSEQUENCES_OF_SHADOW {
        MISERABLE {
            TRIGGER "When the number of Shadow points accumulated by a Player-hero matches or overcomes their current Hope score."
            EFFECT "Player-heroes become Miserable, and see all their rolls hampered by the fact that rolling an Eye of Sauron on the Feat die results in failure, regardless of the TN and the actual result obtained by the roll."
        }
        ILL_FAVOURED {
            TRIGGER "Player-heroes whose Shadow score reaches their maximum Hope rating."
            EFFECT "Player-heroes are so overburdened by their fears that they become Ill-favoured on all rolls."
            RECOVERY "There is only one way to recover from such depths of desperation — the Player-hero must experience a bout of madness."
        }
    }
    # ─────────────────────────────────────────────
    # HARDEN WILL
    # ─────────────────────────────────────────────
    HARDEN_WILL {
        DESCRIPTION "Adventurers who are struggling under the burden of the Shadow may tap into their innermost reserves of spiritual energy to harden their determination, before it's too late."
        CONDITION "Player-heroes whose accumulated Shadow does not yet match their maximum Hope score."
        EFFECT "The Player-hero may choose to remove all their current Shadow, replacing it with a single Shadow Scar."
        SHADOW_SCAR "A Shadow Scar is a permanent Shadow point that can be removed only during a Yule Fellowship Phase, by choosing the Heal Scars undertaking, but is otherwise considered as a normal Shadow point for all purposes."
    }
    # ─────────────────────────────────────────────
    # SOURCES OF SHADOW
    # ─────────────────────────────────────────────
    SHADOW_SOURCES {
        DREAD {
            DESCRIPTION "Terror is a spear in the hand of the Enemy. Adventurers gain Shadow points whenever they witness something capable of striking fear or sowing doubts into their hearts."
            SHADOW_TEST "VALOUR"
            ^"Natural but unexpected tragic event, or very grievous occurrence"
            {
                SHADOW 1
                EXAMPLE "Serious or mortal accident, death in the family, natural catastrophe"
            }
            ^"Gruesome killing, dreadful experience, Orc-work"
            {
                SHADOW 2
                EXAMPLE "Discovering villagers savagely mutilated, experiencing slavery"
            }
            ^"Harrowing experience, physical and spiritual torment"
            {
                SHADOW 3
                EXAMPLE "Experiencing torture, being haunted by a Wight"
            }
            ^"Experiencing directly the power of the Enemy"
            {
                SHADOW 4
                EXAMPLE "Seeing the mustering of a Shadow army, seeing the Eye in a Palantir"
            }
        }
        GREED {
            DESCRIPTION "Hoards of gold and great stores of enchanted weapons and armour lie in forgotten caves. Heroes risk being corrupted by their own desire whenever they put their hands on gold and precious objects that were tainted by laying in the dark for a long time."
            TRIGGER "When the Player-heroes find a hoard of treasure, they may gain a number of Shadow points if the hoard was tainted."
            SHADOW_TEST "WISDOM"
        }
        MISDEEDS {
            DESCRIPTION "Companions often confront challenges that are so demanding that they might be tempted to adopt extreme measures, especially if they aim to achieve a noble goal. When this happens, the Loremaster must consider if a course of action can be considered a Misdeed."
            NO_TEST "A Misdeed is a special instance of Shadow gain, as it cannot be reduced or cancelled by a Shadow Test of any kind."
            WARNING "The Loremaster should usually warn the players when they are about to carry out a Misdeed."
            ^"Violent threats and malicious lies; heedless cruelty"
            SHADOW 1
            ^"Manipulating others; abusing your authority; deliberate cruelty"
            SHADOW 2
            ^"Theft or plunder; oathbreaking or cowardice; treachery"
            SHADOW 3
            ^"Torment or torture; killing or crippling a surrendered foe or harmless folk"
            SHADOW 4
            ^"Murder; willingly taking actions in the service of the Enemy"
            SHADOW "4 plus 1 Shadow Scar"
            INTENTION {
                DESCRIPTION "Merely attempting to do something despicable is a Misdeed, regardless of whether the action succeeds or not."
                UNKNOWING "It is possible to commit a Misdeed unknowingly — for example, attacking someone considered to be guilty of a heinous crime, but who later turns out to be innocent. In this case, the Player-heroes should not gain Shadow automatically, but only if they don't attempt to make reparations when their mistake comes to light."
                CONTRITION "If their reaction is one of contrition and they show an earnest attempt to put the situation right, then they can be allowed to make a Shadow Test (WISDOM) to reduce or cancel the Shadow gain."
            }
        }
        SORCERY {
            DESCRIPTION "Those who are in the favour of the Dark Lord are often rewarded with evil knowledge. Some are able to wield such knowledge to terrible effect, twisting it into a form of dark magic. Adventurers gain Shadow when they fall victim of the dreadful spells of the Enemy and his minions."
            AMOUNT "The number of Shadow points gained by the Player-heroes depends on the power of the sorcerous spell."
            ADDITIONAL "Often, gaining Shadow points as the consequence of Sorcery has additional negative consequences."
            SHADOW_TEST "WISDOM"
        }
    }
    # ─────────────────────────────────────────────
    # MADNESS
    # ─────────────────────────────────────────────
    MADNESS {
        TRIGGER "Player-heroes whose Shadow score reaches their maximum Hope rating become Ill-favoured on all rolls. Once they reach this point, they can get rid of Shadow only in one way — by playing out a bout of madness."
        DESCRIPTION "A bout of madness is a violent reaction marking a significant step in their downward course towards degeneration. To play out a bout of madness, players must describe how their characters lose control for a short period of time, doing something they will later regret."
        GUIDANCE "To describe their loss of control, players should take into consideration the source of the last Shadow gain that pushed their heroes beyond their limit, a character's Shadow Path, or one of their Flaws."
        EXAMPLES {
            BETRAYAL "The Player-hero fails to keep their word or to perform an assigned duty, and the Company suffers the consequences."
            FEAR "The heroes fall prey to their fears, and flee from any source of danger, thinking only about preserving themselves from any threat."
            LUST "Lusting characters feel an irresistible desire for an object not belonging to them, and try to take it, secretly or overtly."
            RAGE "Raging characters brood over real or imaginary wrongs until they react aggressively to a perceived threat or source of opposition."
            DEFAULT "If nothing seems to fit the circumstances, a standard bout of madness can take the form of an aggression of any type, verbal or physical, upon the most likely and available target (a character's Fellowship Focus often qualifies as such)."
        }
        RECOVERY "Player-heroes quickly regain control of themselves once their bout of madness passes. They are no longer Ill-favoured and remove all their current Shadow points, but they advance one step along their Shadow Path."
        TIMING "A bout of madness must take place during the current Adventuring Phase. Player-heroes ending the Adventuring Phase with a Shadow score matching their maximum Hope can be considered to have left the Company and are retired from the game."
    }
    # ─────────────────────────────────────────────
    # SHADOW PATHS
    # ─────────────────────────────────────────────
    ^"ShadowPath" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Associated Calling" STRING REQUIRED
            ^"Flaws" LIST OF ^"Flaw" REQUIRED
        }
    }
    USING_FLAWS {
        DESCRIPTION "Every time heroes develop a Flaw they are renouncing their higher ambitions and embracing simpler, more primitive emotions. They are trading respect for arrogance, love for lust, trust for suspicion."
        RULE "If a Player-hero is using a Skill that can plausibly be affected by a Flaw, the roll is made Ill-favoured."
        LOREMASTER_NOTE "The Loremaster should take into account the effects of a Flaw whenever the performance of a Player-hero can be made worse by it."
    }
    FLAWED_HEROES {
        NOTE "Flawed adventurers haven't lost the possibility of being heroes. Many of the characters described in the books display the influence of the Shadow to some measure — certainly Boromir, or Frodo, but also Aragorn and even Gandalf. In most cases, they were able to keep their weaknesses in check, avoiding corruption's most dire consequences."
    }
    ^"Curse of Vengeance" DEF {
        EXTENDS ^"ShadowPath"
        PROPERTIES {
            ^"Name" STRING "Curse of Vengeance" FIXED
            ^"Associated Calling" STRING "Champion" FIXED
        }
        FLAWS {
            RANK 1 ^"Spiteful" {
                "You often repay real or imagined wrongs with vicious rudeness. Depending on the provocation, you may simply be very impolite, or downright insulting."
            }
            RANK 2 ^"Brutal" {
                "You react violently to provocations and show little restraint under most circumstances."
            }
            RANK 3 ^"Cruel" {
                "You don't care if your actions cause pain and suffering to others, and are needlessly savage with your enemies."
            }
            RANK 4 ^"Murderous" {
                "You become Murderous when you start to consider killing as a perfectly natural way to achieve a goal or simply to make things go your way."
            }
        }
    }
    ^"Dragon-sickness" DEF {
        EXTENDS ^"ShadowPath"
        PROPERTIES {
            ^"Name" STRING "Dragon-sickness" FIXED
            ^"Associated Calling" STRING "Treasure Hunter" FIXED
        }
        FLAWS {
            RANK 1 ^"Grasping" {
                "If you become Grasping, you seek to accumulate gold and precious items above all else, just for the sake of possessing them."
            }
            RANK 2 ^"Mistrustful" {
                "When your prized possessions start to weigh you down and become a treasure to be guarded, even the good advice of friends appears to mask dubious intentions."
            }
            RANK 3 ^"Deceitful" {
                "You feel no shame in misleading others with lies and stratagems, as long as your machinations further your ends and corrupted needs."
            }
            RANK 4 ^"Thieving" {
                "You have discovered that anything you desire can be yours — you just have to take it. You have earned the right to take all you want when you sacrificed the love of your peers and your own self-respect."
            }
        }
    }
    ^"Lure of Power" DEF {
        EXTENDS ^"ShadowPath"
        PROPERTIES {
            ^"Name" STRING "Lure of Power" FIXED
            ^"Associated Calling" STRING "Captain" FIXED
        }
        FLAWS {
            RANK 1 ^"Resentful" {
                "You risk becoming bitter and angry with the people you ought to lead. You often feel that you risk your life for individuals that fail to see the wisdom of your words."
            }
            RANK 2 ^"Arrogant" {
                "You don't miss an opportunity to underline your own importance, often belittling your peers and companions."
            }
            RANK 3 ^"Overconfident" {
                "Overconfidence denotes overweening pride, a sentiment that blinds you to your own limits and weaknesses. You endeavour to do anything you set your mind upon, regardless of the consequences that might befall others."
            }
            RANK 4 ^"Tyrannical" {
                "You escalate your actions and desires to the level of a just cause. Your disregard for the lives of others is so profound that you go to any lengths to achieve your ends, regardless of the cost or methods employed to accomplish them. Any dissenting opinion is considered as utter betrayal."
            }
        }
    }
    ^"Lure of Secrets" DEF {
        EXTENDS ^"ShadowPath"
        PROPERTIES {
            ^"Name" STRING "Lure of Secrets" FIXED
            ^"Associated Calling" STRING "Scholar" FIXED
        }
        FLAWS {
            RANK 1 ^"Haughty" {
                "You don't recognise easily the wisdom found in the words and actions of others, and tend to turn aside all advice and offers of help."
            }
            RANK 2 ^"Scornful" {
                "You treat the propositions of others with disdain, making use of every opportunity to mock them for their presumed inadequacy."
            }
            RANK 3 ^"Scheming" {
                "You keep your thoughts and intentions to yourself at all times, never giving advice and heeding only your own judgement. You might sometimes agree with the propositions of others, but only to be free to follow your own choices later."
            }
            RANK 4 ^"Traitorous" {
                "When you become Traitorous you cannot be trusted to keep your word. You are ready to betray your own friends and allies, if it would turn to your advantage."
            }
        }
    }
    ^"Path of Despair" DEF {
        EXTENDS ^"ShadowPath"
        PROPERTIES {
            ^"Name" STRING "Path of Despair" FIXED
            ^"Associated Calling" STRING "Warden" FIXED
        }
        FLAWS {
            RANK 1 ^"Troubled" {
                "You feel a sense of disquiet that makes it hard for you to read a situation clearly and offer counsel to others."
            }
            RANK 2 ^"Wavering" {
                "Caution can be the enemy of action, and when you become Wavering you cannot set your mind upon a choice quickly and effectively. You vacillate between the various options you see before you."
            }
            RANK 3 ^"Guilt-ridden" {
                "The curse of those who defend others is to feel remorse when their actions go amiss, pushing you to refuse any daring course of action."
            }
            RANK 4 ^"Fearful" {
                "When you become Fearful you are so beset by worries and concerns that you cannot force yourself to risk doing anything that will potentially endanger yourself and those you care for."
            }
        }
    }
    ^"Wandering-madness" DEF {
        EXTENDS ^"ShadowPath"
        PROPERTIES {
            ^"Name" STRING "Wandering-madness" FIXED
            ^"Associated Calling" STRING "Messenger" FIXED
        }
        FLAWS {
            RANK 1 ^"Idle" {
                "It takes a lot to stir Idle adventurers into action. You are easily distracted, and must be cajoled to fully participate in endeavours."
            }
            RANK 2 ^"Forgetful" {
                "Being Forgetful indicates that you are often daydreaming and absent-minded, and find it difficult to remember even important things."
            }
            RANK 3 ^"Uncaring" {
                "When you become Uncaring you lose touch with the world outside of yourself. You can't bring yourself to feel compassion, and quickly lose interest in matters that do not concern you directly."
            }
            RANK 4 ^"Cowardly" {
                "You care only for your own safety under any circumstances, and will go to any lengths to save yourself when a threat arises."
            }
        }
    }
    SUCCUMBING_TO_THE_SHADOW {
        TRIGGER "Heroes who develop the full complement of four Flaws risk succumbing totally to the Shadow. The next time that their Shadow score reaches their maximum Hope rating they do not become Ill-favoured but are taken out of play instead."
        LOST_TO_MADNESS "When Men, Hobbits, or Dwarves fall under the Shadow, they succumb to madness. More often than not, this results sooner or later in their death, as they threaten others to the extent that they end up being killed, or starve to death in some solitary place, forsaken by folk and beasts."
        RETURN_TO_VALINOR "When the burden of the Shadow overpowers Elves, they seek to leave Middle-earth as soon as possible, to sail for the Uttermost West and be healed of the sadness and misery of this world."
        COLLABORATION "The details about the fate of a Player-hero who descends a Shadow Path to its bottom are up to the Loremaster and the player controlling the fallen character. They should work together to find a way to incorporate the hero's destiny into the ongoing game."
    }
    # ─────────────────────────────────────────────
    # FELLOWSHIP PHASE SHADOW REMOVAL
    # ─────────────────────────────────────────────
    SHADOW_REMOVAL {
        # Main Fellowship Phase Shadow removal rule (1-3 scale based on deeds):
        # see SPIRITUAL_RECOVERY.SHADOW_REMOVAL in tor2e-2e-core-fellowship.ttrpg
        EXCEPTION_ELVES "Elves of Lindon: maximum 1 Shadow removed per Fellowship Phase."
        EXCEPTION_RANGERS "Rangers of the North (not Yule): recover Hope up to half HEART score only."
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # FELLOWSHIP PHASE OVERVIEW
    # ─────────────────────────────────────────────
    # A Fellowship Phase marks the conclusion of each Adventuring Phase.
    # Unlike the Adventuring Phase (Loremaster-driven), the Fellowship
    # Phase is player-driven: players elaborate upon their Player-heroes'
    # stories and ambitions, and mark their adventurers' progression.
    FELLOWSHIP_PHASE_OVERVIEW {
        DESCRIPTION "A Fellowship Phase is a gameplay instance driven by the players' choices. While during the Adventuring Phase players react to the Loremaster's storytelling prompts, during a Fellowship Phase they get to elaborate upon their Player-heroes' stories and ambitions, and to mark their adventurers' progression. The Loremaster is invited to sit back and follow what the players have to say about their characters."
        NARRATION "Players are encouraged to narrate in detail what they do during a Fellowship Phase, not necessarily limiting themselves to those activities with a direct gaming effect."
        LIMITS {
            TEMPORAL "Players must keep in mind the length of a Fellowship Phase."
            GEOGRAPHICAL "Players must keep in mind the geographical limits of a Fellowship Phase."
            NO_NEW_BACKGROUND "Players must not introduce new background information — such as exploring a location their Player-hero has never visited before, making the acquaintance of personalities they haven't encountered yet. They should not do what is better suited to an Adventuring Phase."
        }
        TIMING "A Fellowship Phase marks the conclusion of each Adventuring Phase, and ideally takes place at the end of a gaming session. Otherwise, it can open a new session and precede the next Adventuring Phase."
    }
    # ─────────────────────────────────────────────
    # FELLOWSHIP PHASE STRUCTURE
    # ─────────────────────────────────────────────
    FELLOWSHIP_PHASE_STRUCTURE {
        STEP_1 "Set Duration"
        STEP_2 "Choose Destination"
        STEP_3 "Perform Updates"
        STEP_4 "Choose Undertakings"
    }
    # ─────────────────────────────────────────────
    # STEP 1: SET DURATION
    # ─────────────────────────────────────────────
    SET_DURATION {
        DESCRIPTION "A Fellowship Phase usually covers a longer period of time than the average Adventuring Phase. Events are described in broader strokes — days and weeks pass while the Player-heroes relax, or busy themselves with their own personal work or studies."
        MINIMUM "One week"
        MAXIMUM "An entire season"
        YULE_NOTE "The longest Fellowship Phase is normally taken during the mid-winter festivities (Yule)."
    }
    # ─────────────────────────────────────────────
    # STEP 2: CHOOSE DESTINATION
    # ─────────────────────────────────────────────
    CHOOSE_DESTINATION {
        DESCRIPTION "Once the length of the Fellowship Phase has been determined, the players must decide where they will spend it. Generally, the Player-heroes stop at a safe haven to spend the phase as a group, unless the year's end festivities are near."
        PROXIMITY "The players should choose a place within a reasonable distance from the area where the Company was adventuring during the recent sessions of play, also taking into consideration how long the Fellowship Phase will last."
        VISITED_LOCATIONS "The players are free to select any location the Company has visited so far."
        BEHIND_THE_SCENES "The journey required to reach the chosen destination is considered to take place behind the scenes, unless the players have a mind to play out the details."
        SAFE_HAVENS "Places like the town of Bree or Rivendell are the ultimate safe havens, as they are particularly suited to resting and the mending of wounds, and are inhabited by a host willing to welcome travellers."
    }
    # ─────────────────────────────────────────────
    # STEP 3: PERFORM UPDATES
    # ─────────────────────────────────────────────
    # Players spend accumulated Experience Points to improve Skills,
    # Combat Proficiencies, and Valour/Wisdom ranks.
    # Cost table: see ADVANCEMENT_COSTS in tor2e-2e-core-base.ttrpg
    PERFORM_UPDATES {
        TRAINING {
            DESCRIPTION "Players spend Skill points to develop their Player-hero's Skill ratings, using the Experience Points Costs table."
            SAVING "Players don't have to spend all their points at once — Skill points can be saved to acquire more expensive upgrades during a later Fellowship Phase."
            LIMIT "During a single Fellowship Phase, players can buy a maximum of one rank in each Skill."
        }
        GROWTH {
            DESCRIPTION "Players spend Adventure points to buy a new rank in either Wisdom or Valour, or to enhance an adventurer's Combat Proficiencies."
            SAVING "Players do not have to spend all their Adventure points at once, but can save them to acquire more expensive upgrades later."
            REWARD_OR_VIRTUE "When Player-heroes reach a new Valour or Wisdom rank, they also gain a new Reward or Virtue."
            COMBAT_PROFICIENCY_LIMIT "During a single Fellowship Phase, players can acquire a maximum of one rank in each Combat Proficiency."
            VALOUR_WISDOM_LIMIT "Players can buy a rank in either Wisdom or Valour, but not in both, during a single Fellowship Phase."
            UPDATE_SCORES "If a new attribute value is attained, the scores of all related abilities and features must be updated accordingly."
        }
        SPIRITUAL_RECOVERY {
            # Hope recovery during Fellowship Phase: see RECOVERING_HOPE.FELLOWSHIP_PHASE in tor2e-2e-core-base.ttrpg
            HOPE "All Player-heroes automatically recover a number of Hope points equal to their Heart score. They recover all Hope at Yule."
            SHADOW_REMOVAL {
                CONDITION "If the Adventuring Phase resulted in a positive outcome in the fight against the encroaching Shadow, all members of the Company get to remove a number of Shadow points."
                ADJUDICATION "The Loremaster must weigh the actions of the Company against the broader context of the Twilight of the Third Age."
                MARGINAL 1
                DESCRIPTION "The Company's actions can be considered to have at least marginally interfered with the return of the Shadow."
                ACTIVE 2
                DESCRIPTION "Their deeds can be considered to have actively hindered or damaged the Enemy."
                NOTEWORTHY 3
                DESCRIPTION "The Player-heroes have committed feats that would gain the attention of the Dark Lord himself, or at least that of one of his major servants."
            }
        }
    }
    # ─────────────────────────────────────────────
    # STEP 4: CHOOSE UNDERTAKINGS
    # ─────────────────────────────────────────────
    CHOOSE_UNDERTAKINGS {
        DESCRIPTION "Undertakings are time-consuming endeavours that Player-heroes can accomplish exclusively during a lengthy stop like a Fellowship Phase."
        SELECTION_RULES {
            ORDINARY "During an ordinary Fellowship Phase, the Company as a group chooses one single undertaking."
            YULE "During a Yule Fellowship Phase, each player chooses one undertaking instead."
            FREE "During each Fellowship Phase (ordinary or Yule), the Company is entitled to choose one additional undertaking, selecting it among those listed as free, based on the Callings represented among the Player-heroes."
            SUMMARY_ORDINARY "During an ordinary Fellowship Phase the Company will choose a maximum of two undertakings."
            SUMMARY_YULE "During Yule, a number of undertakings equal to the number of Player-heroes plus one."
            UNIQUENESS "Players must always select different undertakings, unless they are marked as Yule activities — such endeavours can be chosen by any number of Player-heroes."
        }
        # ── Free Undertaking by Calling ──
        FREE_UNDERTAKING_BY_CALLING {
            ^"Captain" "Strengthen Fellowship"
            ^"Champion" "Write a Song"
            ^"Messenger" "Meet Patron"
            ^"Scholar" "Ponder Storied and Figured Maps"
            ^"Treasure Hunter" "Study Magical Items"
            ^"Warden" "Gather Rumours"
        }
        # ── Undertakings ──
        GATHER_RUMOURS {
            DESCRIPTION "Player-heroes gathering rumours try to separate facts from fireside-tales, and to gather stories that may prove useful in their adventures."
            EFFECT "Choose this undertaking to receive a rumour from the Loremaster. A rumour can be a story about an individual, a place, or a coming event, pointing specifically to something that the Company can explore, prevent, or aspire to achieve. Otherwise, a rumour can be something specific that the Player-hero is inquiring about, and directly related to the current adventuring circumstances of the Company."
            FREE_FOR "Warden"
        }
        HEAL_SCARS {
            YULE_ACTIVITY
            TRUE
            DESCRIPTION "Heroes feel the burden of the Shadow weigh heavily upon their shoulders long after their adventures are over. Only the passage of time can heal such wounds."
            EFFECT "Spend 5 Adventure points and remove 1 Shadow Scar."
        }
        MEET_PATRON {
            DESCRIPTION "After a few years of adventuring, the Company will probably count several of the Wise and the Great among their allies. Some of these can be chosen as Patrons of the Company."
            EFFECT "Choose this undertaking to meet one of the Company's friends and allies when spending the Fellowship Phase in a location where that individual can be found, and if the Patron is available for a meeting."
            ENCOUNTER "The Loremaster can work with the Player-hero to set up the encounter. The reasons to see a patron vary based on the current circumstances of a campaign, but generally revolve around the Player-hero asking for some sort of assistance, possibly accepting a task requested by the patron in return."
            FREE_FOR "Messenger"
        }
        PONDER_STORIED_AND_FIGURED_MAPS {
            DESCRIPTION "A Player-hero choosing this undertaking studies every map and scroll of lore they can find, to learn as much as possible about the perils the Company may face while on a journey."
            EFFECT "Until the next Fellowship Phase, apply a modifier of +1 to all Feat die rolls made to determine the nature of events during the Event Resolution step of a Journey."
            FREE_FOR "Scholar"
        }
        RAISE_AN_HEIR {
            YULE_ACTIVITY
            TRUE
            DESCRIPTION "Wise adventurers sooner or later realise that all they have done in their lives can avail to nothing if they meet an untimely end. To avoid squandering their legacy, they should spend some money and time choosing and raising a worthy successor."
            EFFECT "Spend up to 5 Treasure and an equal number of Adventure points to add to your heir's starting Previous Experience reserve: for each Adventure point spent, raise the reserve by 1."
            FIRST_TIME "If this is the first time that this undertaking has been chosen, the player must also choose a name for the designated heir."
            # Full heir creation rules: see RAISE_AN_HEIR in tor2e-2e-core-base.ttrpg
        }
        RECOUNT_A_STORY {
            YULE_ACTIVITY
            TRUE
            DESCRIPTION "Player-heroes give a personal account of an event they took part in, describing the episode to members of their own folk in a public place or event, or recording it in a book. Players are encouraged to improvise a short narration."
            EFFECT "Replace one of your Distinctive Features with a new trait, choosing a quality that you displayed in the narrated episode."
            # Distinctive Feature trait list: see DISTINCTIVE_FEATURES in tor2e-2e-core-base.ttrpg
        }
        STRENGTHEN_FELLOWSHIP {
            DESCRIPTION "The bond shared by the members of a Company is put to the test by the odds they face in the course of their adventures, and can be reinforced when the Player-heroes are enjoying a moment of respite."
            EFFECT "Raise the Fellowship rating by +1 until the next Fellowship Phase."
            FREE_FOR "Captain"
        }
        STUDY_MAGICAL_ITEMS {
            DESCRIPTION "When heroes come into possession of a strange ring, an ancient jewel, or a rune-scored staff, they might not know much about their properties, especially if they are not immediately observable."
            EFFECT "Learn all there is to be discovered about the qualities of all Marvellous Artefacts and Wondrous Items in the Company's possession."
            FREE_FOR "Treasure Hunter"
        }
        WRITE_A_SONG {
            DESCRIPTION "All Cultures of Middle-earth play and sing songs to remember things that are fair and to celebrate life."
            EFFECT "Compose a song, choosing whether it will be a Lay, a Song of Victory, or a Walking-song. The new composition is added to the Company's list of songs. The player is encouraged to come up with a song title, or its lyrics."
            FREE_FOR "Champion"
            SONG_TYPES {
                LAY "A short narrative poem, particularly appropriate to narrate heroic deeds, meant to be recited or sung at gatherings."
                VENTURE "Council"
                SONG_OF_VICTORY "Warriors sing stirring songs in combat, to lift their spirit and renew their lust for battle."
                VENTURE "Combat"
                WALKING_SONG "Travellers trudging along the final hours of a long day of travelling may find it helpful to hum a merry song, especially when they are drawing near to their destination."
                VENTURE "Journey"
            }
        }
    }
    # ─────────────────────────────────────────────
    # SINGING SONGS
    # ─────────────────────────────────────────────
    SINGING_SONGS {
        DESCRIPTION "When the Company is involved in a Council, Combat, or Journey, the Player-heroes may sing a song and rouse themselves to pursue their goals with renewed strength of purpose."
        PROCEDURE "Choose a song from the Company's song list that is appropriate to the current venture (Combat, Journey, or Council). Then, make a Song roll."
        SUCCESS "Heroes succeeding in the roll ignore the effects of being Weary for the length of the heroic venture."
        COMBAT_NOTE "Singing a song in combat is considered a secondary action."
        USAGE "Each song may be used by the Company once for each Adventuring Phase. Mark a song off the list once it has been spent. A song must be marked off whether it has been used successfully or not."
    }
    # ─────────────────────────────────────────────
    # YULE
    # ─────────────────────────────────────────────
    YULE {
        FREQUENCY "Approximately once every three Fellowship Phases, winter comes, and with it the end of the current year."
        DESCRIPTION "Normally, the Company spends the entire cold season as a single, prolonged Fellowship Phase."
        DISBAND "In most cases, the Company disbands temporarily on occasion of the Yule festivities, as each Player-hero takes the chance to return home and enjoy some time among family and folk."
        TRAVEL "Three months are enough for any Player-hero to return home from any location other than the most remote."
        PASSAGE_OF_THE_YEARS {
            AGING "When Yule comes, all Player-heroes have aged one year."
            FULL_HOPE_RECOVERY "During Yule, all Player-heroes recover all Hope."
            YULE_SKILL_BONUS "Player-heroes earn a number of bonus Skill points equal to their Wits rating, and add this amount to the total they accumulated during the last Adventuring Phase."
            WORLD_UPDATES "The Loremaster should take the chance offered by a Yule Fellowship Phase to update the Company on the changes that are taking place in the world and that their Player-heroes should know about, tailoring the information based on the current circumstances and whereabouts of the Company."
        }
    }
    # ─────────────────────────────────────────────
    # CHANGE USEFUL ITEMS
    # ─────────────────────────────────────────────
    CHANGE_USEFUL_ITEMS {
        RULE "During each Fellowship Phase, the players are free to change the selection of their Player-heroes' Useful Items, always respecting the maximum number of items allowed by their current Standard of Living."
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # COUNCIL OVERVIEW
    # ─────────────────────────────────────────────
    # Councils are one of three Heroic Ventures (alongside
    # Combat and Journeys). They represent social encounters
    # reserved for formal gatherings and high-stakes situations
    # — not everyday exchanges.
    COUNCIL_RULES {
        DESCRIPTION "Councils are social encounters reserved for formal gatherings and high-stakes situations — not everyday exchanges. They represent moments when Player-heroes must use words and wits to achieve their goals."
        # ─────────────────────────────────────────────
        # COUNCIL SEQUENCE
        # ─────────────────────────────────────────────
        # A council follows three steps in order:
        # 1. Set Resistance
        # 2. Introduction
        # 3. Interaction
        COUNCIL_SEQUENCE {
            # Step 1: Set Resistance
            SET_RESISTANCE {
                DESCRIPTION "The Loremaster sets the Resistance of the council based on how likely the audience is to grant the request."
                RESISTANCE_VALUES {
                    REASONABLE 3
                    BOLD 6
                    OUTRAGEOUS 9
                }
            }
            # Step 2: Introduction
            INTRODUCTION {
                DESCRIPTION "A spokesperson for the Company makes a Skill roll to set the tone and determine the time limit for the council."
                TIME_LIMIT {
                    FAILURE 3
                    SUCCESS "4 + 1 per Tengwar icon"
                }
                USEFUL_SKILLS {
                    AWE "Impress the audience, but may reveal information about the Company."
                    COURTESY "Establish smooth relations and put the audience on friendly terms."
                    RIDDLE "Extract information from the audience, but risk creating mistrust."
                }
            }
            # Step 3: Interaction
            INTERACTION {
                DESCRIPTION "Players take turns making Skill rolls to accumulate successes. The council succeeds when the Company accumulates a number of successes equal to or greater than the Resistance within the time limit. Each Tengwar icon produced by a roll counts as an additional success."
                AUDIENCE_ATTITUDES {
                    RELUCTANT "Lose (1d) on Skill rolls."
                    OPEN "No modifier."
                    FRIENDLY "Gain (1d) on Skill rolls."
                }
                USEFUL_SKILLS {
                    ENHEARTEN "Draw the attention of a crowd and raise its spirit."
                    INSIGHT "Evaluate the emotions and intentions of the audience."
                    PERSUADE "Win the minds of listeners through reasoning."
                    RIDDLE "Engage in a riddle-game or gather information."
                    SONG "Perform at social gatherings or diplomatic occasions."
                }
            }
        }
        # ─────────────────────────────────────────────
        # EFFECTIVE ROLEPLAYING
        # ─────────────────────────────────────────────
        EFFECTIVE_ROLEPLAYING {
            DESCRIPTION "The Loremaster may award bonus dice for relevant and well-delivered roleplaying during a council."
            GOOD_ROLEPLAYING "(1d) bonus on a Skill roll."
            EXCEPTIONAL_ROLEPLAYING "(2d) bonus on a Skill roll."
        }
        # ─────────────────────────────────────────────
        # END OF COUNCIL
        # ─────────────────────────────────────────────
        END_OF_COUNCIL {
            SUCCESS "The Company accumulates successes equal to or greater than the Resistance. The audience grants the request."
            FAILURE_WITH_WOE "The Company fails to meet the Resistance, but may still achieve the goal at a price."
            DISASTER "The Company fails all rolls, or fails after a botched Introduction. The audience perceives the Company as a threat."
        }
    }
    # ─────────────────────────────────────────────
    # COUNCIL STRUCTURE
    # ─────────────────────────────────────────────
    # Summary of stages and their useful skills.
    COUNCIL_STRUCTURE {
        INTRODUCTION_STAGE {
            USEFUL_SKILLS [^"Awe", ^"Courtesy", ^"Riddle"]
        }
        INTERACTION_STAGE {
            USEFUL_SKILLS [^"Enhearten", ^"Insight", ^"Persuade", ^"Riddle", ^"Song"]
        }
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # COMBAT OVERVIEW
    # ─────────────────────────────────────────────
    COMBAT_RULES {
        DICE "Roll 1 Feat Die (d12) + a number of Success Dice (d6) equal to Combat Proficiency rank."
        FEAT_DIE_RESULTS {
            "Gandalf rune (12)"
            "Automatic Piercing Blow — proceed immediately to the target's Protection roll regardless of success icons."
            "Eye of Sauron (11)"
            "The adversary immediately spends 1 Hate (or Resolve) to make a Special Attack using any weapon in its Combat Profile (Loremaster's choice). No roll required — the Special Damage takes effect automatically. If the adversary has no Hate or Resolve remaining, the Eye result has no further effect."
            "Numbers 1–10"
            "Used directly as the Feat Die result for success comparison and Piercing Blow threshold."
        }
        SUCCESS_DIE_RESULTS {
            "Tengwar rune (6)"
            "Success icon — counts as 1 success toward the attack TN."
            "Numbers 1–5"
            "No success."
        }
        ATTACK_RESOLUTION {
            HERO_TARGET_NUMBER "Attack TN = the attacking hero's own Strength TN + the adversary's Parry rating. Each hero computes their own TN when attacking; different heroes may face a different TN against the same adversary."
            ADVERSARY_TARGET_NUMBER "The difficulty of all attack rolls made by adversaries against Player-heroes are equal to the target hero's PARRY score."
            HIT "A successful attack roll inflicts damage on its target in the form of an Endurance Loss based on the weapon used, and may inflict additional Special Damage types based on the Quality of Success of the roll. Finally, attacks may cause more long-lasting injuries if a Piercing Blow is scored."
            MISS "Feat Die result + number of Success icons < TN: attack misses."
        }
        # ── ENDURANCE LOSS ──────────────────────────
        ENDURANCE_LOSS {
            RULE "When a melee or ranged attack roll succeeds, the target suffers an immediate loss of Endurance equal to the Damage rating of the weapon used."
            WEARY "Player-heroes seeing their Endurance decrease to match or go below their total Load score become Weary."
            ZERO_ENDURANCE "If their Endurance is reduced to zero, they drop unconscious."
            ADVERSARIES "Adversaries do not normally become Weary due to Endurance loss, but are normally eliminated upon reaching zero Endurance."
            KNOCKBACK {
                RULE "Once each round, Player-heroes can halve the Endurance loss caused by a successful attack (rounding fractions up) by choosing to be knocked back: they will spend their next main action recovering their fighting position."
                ADVERSARIES "Adversaries cannot choose to be knocked back."
            }
        }
        # ── SPECIAL DAMAGE ──────────────────────────
        # If a successful attack roll produces one or more Success icons
        # (Tengwar), they can be used to trigger one or more special
        # results, based on the war gear of the attacker. Multiple
        # Success icons can be used to trigger different results, or the
        # same one multiple times.
        SPECIAL_DAMAGE {
            RULE "If a successful attack roll produces one or more Success icons (Tengwar), they can be used to trigger one or more special results, based on the war gear of the attacker. Multiple Success icons can be used to trigger different results, or the same one multiple times."
            HEAVY_BLOW {
                WEAPONS "Any weapon"
                EFFECT "Spend 1 Success icon to inflict to your adversary an additional loss of Endurance equal to your STRENGTH rating. Raise the loss of Endurance by an additional +1 if you are using a two-handed weapon."
            }
            FEND_OFF {
                WEAPONS "Any close combat weapon"
                EFFECT "Spend 1 Success icon to modify your Parry rating for the round by +1 using Axes and all Brawling weapons, +2 using Swords, and by +3 using Spears."
            }
            PIERCE {
                WEAPONS "Bows, Spears, and Swords"
                EFFECT "Spend 1 Success icon to modify the Feat Die numerical result of your attack by +1 if using Swords, +2 if using Bows, and by +3 if using Spears, up to a maximum of 10 — thus possibly triggering a Piercing Blow. Eye of Sauron and Gandalf Rune results are unaffected."
            }
            SHIELD_THRUST {
                WEAPONS "Shield"
                EFFECT "If your STRENGTH is greater than the target's Attribute Level, spend 1 Success icon to push back your target. The adversary is inflicted a penalty, losing (1d) for the length of the round. If this special damage is triggered multiple times, it must be employed to push back different opponents."
            }
        }
        # ── PIERCING BLOWS ──────────────────────────
        PIERCING_BLOWS {
            RULE "In addition to causing the loss of Endurance points, any successful attack may inflict a Piercing Blow."
            TRIGGER "An attack roll produces a Piercing Blow on a 10 or Gandalf Rune result on the Feat Die."
            KEEN "A Keen weapon lowers the Piercing Blow threshold to 9."
            PROTECTION_TEST "Characters hit by a Piercing Blow must immediately roll a Feat Die, plus a number of Success Dice equal to the PROTECTION value of the armour worn. If the attack made the character Weary, the Protection test is made before the Weariness sets in."
            TARGET_NUMBER "The Target Number for the roll is equal to the Injury rating of the weapon used by the attacker."
            FAILURE "If the roll fails, then the target of the attack has received a life-threatening blow — a Wound."
        }
    }
    # ─────────────────────────────────────────────
    # COMBAT SEQUENCE
    # ─────────────────────────────────────────────
    # The Loremaster should make sure that not all battles unfold in
    # the same way, basing the circumstances on the ongoing story and
    # paying particular attention to the plans and preparations of
    # the players and their strategic options. Descriptive details
    # (terrain, weather, positioning) should have repercussions on
    # how combat is resolved — for example, influencing how many
    # opening volleys to allow, or whether any combatants should be
    # made unavailable as eligible targets for engagement.
    COMBAT_SEQUENCE {
        # Once a combat encounter is initiated, the following steps
        # must be applied in order:
        # 1. Opening Volleys
        # 2. Close Quarters Rounds
        OPENING_VOLLEYS {
            RULE "At the start of a battle, the sides involved are still separated by a distance, potentially allowing for a brief exchange of volleys using ranged weapons before combat at close quarters is initiated."
            NUMBER_OF_VOLLEYS "The Loremaster must determine how many volleys to allow, if any at all, based on the circumstances of the fight."
            DEFAULT "Under most circumstances, all combatants are entitled to at least one volley using a bow or a thrown weapon (a spear or a short spear)."
            GREATER_DISTANCE "If the two sides are separated by a greater distance, then the Loremaster might allow combatants using a bow to let loose two volleys, or even more."
            RESOLUTION "All volley attacks are resolved as normal ranged attacks."
            SHIELD_BONUS "Player-heroes carrying a shield double its Parry modifier if aware of the incoming attack (a hero advancing to join a confrontation definitely would be)."
            ORDER "Normally, the volley exchange is resolved with the Player-heroes launching their volleys first, unless the Loremaster considers the circumstances to favour the opposition."
            TRANSITION "When the opening volleys are completed, the combatants cover the distance that separates them and begin fighting at close quarters."
        }
        CLOSE_QUARTERS_ROUNDS {
            RULE "Once fighting at close quarters is initiated, the gameplay is broken down into a cycle of rounds, played one after the other until the end of the battle."
            # Each round fought at close quarters follows this sequence:
            # 1. STANCE — The Company chooses their stances.
            # 2. ENGAGEMENT — All combatants in Close Combat are paired
            # with one or more opponents.
            # 3. ACTION RESOLUTION — The actions of all combatants are
            # resolved in Stance order from Forward to Rearward.
            ROUND_SEQUENCE ["Stance", "Engagement", "Action Resolution"]
            ACTION_RESOLUTION_ORDER "Actions are resolved in Stance order from Forward to Rearward."
        }
        # ── ENGAGEMENT ──────────────────────────────
        # Once all players have determined their stance, all combatants
        # fighting in close combat must engage one or more opponents.
        # Player-heroes in Rearward cannot be engaged. Using miniatures,
        # cardboard stand-ups, or tokens to represent the Player-heroes
        # and their opponents can speed up this process. Since characters
        # from either side can be killed, knocked out, or forced to leave
        # the fight, altering the odds, the engagement process is likely
        # to change from round to round.
        ENGAGEMENT {
            RULE "Once all players have determined their stance, all combatants fighting in close combat must engage one or more opponents. Player-heroes in Rearward cannot be engaged."
            DYNAMIC "Since characters from either side can be killed, knocked out, or forced to leave the fight, altering the odds, the engagement process is likely to change from round to round."
            MORE_ENEMIES_THAN_HEROES {
                RULE "When a round sees more enemies than Player-heroes, engagement is handled by the Loremaster."
                STEP_1 "The Loremaster assigns one opponent to each unengaged Player-hero fighting in a Close Combat stance."
                STEP_2 "Then, for each remaining foe, the Loremaster chooses between engaging a Player-hero in a Close Combat stance who is already engaged, or standing back, possibly to attack using a ranged weapon. Enemies who stand back to use a ranged weapon may attack any Player-hero involved in the fight."
            }
            MORE_HEROES_THAN_ENEMIES_OR_EQUAL {
                RULE "When a round sees the Company outnumbering its foes or matching them in number, engagement is chosen by the players."
                STEP_1 "Player-heroes in a Close Combat stance choose an unengaged adversary to face, from among those introduced by the Loremaster as eligible targets. If there are not enough free enemies to engage, Player-heroes in Close Combat left without an adversary must engage an enemy already engaged by another Player-hero."
                STEP_2 "If one or more of the Company is fighting in Rearward, it is possible that there will be enemies left when everyone fighting in close combat has engaged an adversary. If this happens, the Loremaster chooses whether the 'spare' enemies engage a Player-hero who is already fighting in a Close Combat stance, or stand back to attack with a ranged weapon. Enemies who stand back to use a ranged weapon may attack any Player-hero involved in the fight."
            }
            ENGAGEMENT_LIMITS {
                PER_HERO "Player-heroes can be engaged in Close Combat by up to three human-sized creatures or two large creatures (such as Trolls). Heroes engaged by multiple foes choose which adversary to attack when it is their turn to act."
                PER_ENEMY "Up to a maximum of three Player-heroes may engage in Close Combat against a human-sized opponent at the same time, while up to six can engage an enemy greater than human-sized (such as a Troll). When an enemy is engaged by multiple Player-heroes, the Loremaster chooses which opponent they attack when their turn comes."
            }
            UNENGAGED_HEROES {
                RULE "During a combat round, it may happen that a hero who was previously engaged in close combat finds themself unengaged when their turn to act comes — for example, their main adversary has been killed by another Player-hero's attack, or the enemy escaped from the field of battle. When this happens, the hero is free to choose another adversary to attack in close combat from among the available foes (engaged or unengaged), keeping in mind the engagement limits."
            }
        }
        # ── ACTION RESOLUTION ──────────────────────────
        # The actions of all combatants are now resolved, with all
        # members of the Company going first.
        ACTION_RESOLUTION {
            TURN_ORDER "All members of the Company act first. When all Player-heroes have resolved their actions, the Loremaster resolves the actions of all the adversaries involved in the fight."
            PLAYER_HERO_ACTIONS {
                STANCE_ORDER "When it is the Company's turn to act, all players resolve their actions in stance order, with Player-heroes in Forward stance going first, and progressing through the stances until those in a Rearward stance have acted. If two or more Player-heroes are fighting in the same stance, the order of action is up to the players."
                MAIN_AND_SECONDARY "When it is their turn to act, players must choose one main action for their Player-hero to perform, and one secondary action, to accomplish before or after the main one. A main action is a task that requires a hero's full attention — it is generally used to make an attack roll, or to complete a Combat Task. Secondary actions are faster, simpler undertakings, or tasks that can be accomplished while focusing on a main action."
                MAIN_ACTION_EXAMPLES ["Attacking or performing a Combat Task", "Recovering your position after a knockback", "Recovering your weapon, helm, or shield that was previously dropped", "Carrying a fallen comrade to safety", "Moving across the battlefield"]
                SECONDARY_ACTION_EXAMPLES ["Advancing or retreating while fighting", "Trying to locate someone on the battlefield", "Drawing a weapon", "Removing a helm or dropping a shield or weapon, for example to reduce Load"]
            }
            LOREMASTER_ACTIONS {
                RULE "When it is the enemies' turn to act, the Loremaster chooses their actions, again in stance order (using the stance of the Player-hero they are attacking). The actions of enemies who stood back unengaged to attack with ranged weapons are resolved last."
                ADVERSARY_ACTIONS "In general terms, adversaries may perform a main action and a secondary action, just like the Player-heroes do. Often, the Loremaster will opt to have them simply take one main action to speed up gameplay."
                GUIDANCE "The description of an adversary, and their special abilities in particular, should guide the Loremaster in making tactical choices, but much can also be derived from the context of the adventure itself. What is the enemy trying to do (apart from harming the Company)? Are they trying to protect a place? Or are they looking for something, or someone? Having the sketch of a plan in mind can provide the Loremaster with many helpful twists to make combat exciting and fun."
            }
            OTHER_ACTIONS {
                RULE "Combat Tasks include a number of non-combat action options, but players can always propose something unusual or unexpected. The Loremaster should encourage this by allowing the action whenever possible."
                TIME "Can you perform the action in one round, or will it take more time? Consider a round to last a maximum of 30 seconds."
                DIFFICULTY "Does the action require a die roll? If so, both success and failure must have clear consequences. Generally, if succeeding at an action will grant an advantage to the Company, a failure should cause a disadvantage of equal importance."
            }
        }
    }
    # ─────────────────────────────────────────────
    # SURPRISE ATTACKS
    # ─────────────────────────────────────────────
    # A surprise attack happens when the Company is ambushed by a foe,
    # or when the Company succeeds in springing a trap upon unsuspecting
    # enemies. If all sides involved in combat are aware of the presence
    # of enemies, skip this phase.
    SURPRISE_ATTACKS {
        RULE "The Loremaster must consider the circumstances and decide whether a test is required to resolve the situation or not. A well-planned ambush made against an enemy without lookouts or individuals on watch allows the opposition to attack automatically with the benefit of complete surprise."
        COMPANY_AMBUSHED {
            SKILL "AWARENESS"
            RULE "When enemies are trying to take the Company by surprise, all Player-heroes in the Company must make a roll of AWARENESS."
            FAILURE "Player-heroes who fail their roll have been caught off-guard — they won't be able to make an opening volley roll nor to take actions in the first Close Quarters Round."
        }
        AMBUSHING_ENEMIES {
            SKILL "STEALTH"
            RULE "If the Company is trying to waylay their enemies, they must make a STEALTH roll. All players participating in an ambush must succeed in their roll for the surprise attack to succeed."
            SUCCESS "The surprised enemies won't be able to make opening volleys and lose (1d) on all combat rolls in the first Close Quarters Round."
        }
        ALTERNATIVE_SKILLS {
            DETECTING_AMBUSH "Other plausible Skill choices to avoid being surprised include BATTLE, which represents military preparation, or HUNTING, especially when in the wild or if the ambushing enemy is a wild creature."
            AMBUSHING_WITH_BATTLE "BATTLE is particularly appropriate when the situation involves larger groups, but only if there is sufficient time for careful planning."
            AMBUSHING_WITH_HUNTING "HUNTING is more appropriate in areas offering ample opportunities for hiding, and when the encounter isn't expected and you have not been able to prepare beforehand."
            AMBUSHING_WITH_STEALTH "STEALTH can be the best choice when you need to get close to your opponents, and when remaining silent is most important; for example, when the action is taking place inside a building."
        }
    }
    # ─────────────────────────────────────────────
    # WOUNDS
    # ─────────────────────────────────────────────
    # Most adversaries are killed outright when Wounded. Player-heroes
    # can resist being Wounded once without serious consequences, but
    # risk their lives if injured a second time.
    WOUNDS {
        FIRST_WOUND {
            RULE "When Player-heroes are Wounded for the first time they immediately check the Wounded box on their character sheet, and then proceed to roll on the Wound Severity table using a Feat Die, to determine the extent of their injury."
            RESTING "Player-heroes whose Wounded box is checked recover Endurance slowly."
        }
        SECOND_WOUND {
            RULE "Player-heroes who are wounded a second time (they receive a Wound when their Wounded box was already checked) see their Endurance drop to zero, they fall unconscious and are now Dying."
            NOTE "A second Wound is not recorded on the character sheet, and the severity roll is skipped."
        }
        WOUND_SEVERITY_TABLE {
            NOTE "Roll the Feat Die (d12) to determine the severity of the wound."
            "Gandalf Rune (12)"
            "Moderate Injury — the blow received was violent enough to expose you to the risk of worse consequences if injured again, but no real lasting damage was inflicted. At the end of the combat you will recover fully in a matter of hours (remove the Wounded check)."
            "1–10"
            "Severe Injury — the value indicates how long it will take for the injury to mend, expressed in days (write the result in the Injury box on the character sheet)."
            "Eye of Sauron (11)"
            "Grievous Injury — you are knocked unconscious with zero Endurance and are now Dying (as if Wounded twice)."
        }
        FIRST_AID {
            SKILL "HEALING"
            RULE "Player-heroes may reduce the severity of their injury with a HEALING roll. Player-heroes who are not unconscious may attempt the roll themselves."
            EFFECT "A successful HEALING roll reduces the severity of an injury by 1 day, plus 1 day for each Tengwar icon scored (to a minimum of 1 day)."
            LIMIT "Each hero may be administered a successful First Aid only once. A failed HEALING roll cannot be repeated until at least a day has passed, as the failure of the treatment isn't immediately apparent."
        }
        DYING_HEROES {
            TRIGGERS "Heroes are considered to be Dying if they are Wounded twice, or if they roll an Eye of Sauron on their Wound severity roll (or as the result of some sources of injury)."
            RULE "Dying heroes must receive a successful HEALING roll within approximately 1 hour or they will die."
            SUCCESS "If the roll is a success, their life has been saved and they come back to their senses in about 1 hour, at 1 Endurance. If Wounded, heroes must add 10 days to the time required for their injury to mend (minus the days removed by the HEALING roll)."
            PERMANENT_MARK "Finally, their injury leaves a permanent mark (the details are up to the player — a scar, a limp, a missing finger)."
        }
    }
    # ─────────────────────────────────────────────
    # COMPLICATIONS AND ADVANTAGES
    # ─────────────────────────────────────────────
    COMPLICATIONS_AND_ADVANTAGES {
        RULE "The difficulty of an attack can be affected negatively by a range of factors, or combatants may find themselves enjoying an advantage. The Loremaster can set a level of complication or advantage, imposing a bonus or a penalty to the attack rolls made by a combatant involved in the fight (either a Player-hero or an adversary)."
        COMPLICATIONS {
            MODERATELY_HINDERED {
                MODIFIER "Lose (1d)"
                CLOSE_COMBAT "Standing on difficult terrain, suffering unfavourable weather conditions, or in cramped quarters."
                RANGED "Target is at medium range, or is under good cover (trees in a sparse wood)."
            }
            SEVERELY_HINDERED {
                MODIFIER "Lose (2d)"
                CLOSE_COMBAT "Almost blinded by heavy snow, knee-deep in mud or swift-running water, or in darkness."
                RANGED "Target is at long range, is very small (a bird), or protected by darkness or ample cover (trees in a dense wood)."
            }
        }
        ADVANTAGES {
            MODERATE_ADVANTAGE {
                MODIFIER "Gain (1d)"
                CLOSE_COMBAT "Attacking from the high ground, exploiting a favourable terrain feature."
                RANGED "Target is moving slowly, is big, or available cover is scarce."
            }
            GREATER_ADVANTAGE {
                MODIFIER "Gain (2d)"
                CLOSE_COMBAT "The defender is hindered, is blinded by heavy snow, knee-deep in mud or swift-running water, etc."
                RANGED "Target is stationary, is very big (a Dragon), or without available cover."
            }
        }
        BATTLE_ROLL {
            RULE "If the Loremaster deems it appropriate, a Player-hero can make a BATTLE roll as their main action for the round to impose or remove a complication or to gain an advantage, based on the description of the battlefield and the tactical choices of the combatants."
            SUCCESS "On a success, the acting player can either gain an advantage on their next attack roll, remove a complication from it, or impose a complication on the next attack roll made against them. The modifier can benefit an additional Player-hero for each Tengwar icon rolled."
        }
    }
    # ─────────────────────────────────────────────
    # TALKING WITH THE ENEMY
    # ─────────────────────────────────────────────
    TALKING_WITH_THE_ENEMY {
        RULE "Often, the Company faces creatures capable of speech. This means that violence need not be the only way to survive a combat encounter. Some good roleplaying and clever thinking might allow the Player-heroes to find a way out of a dangerous situation — for example, tricking an excessively powerful enemy into thinking that the heroes are much stronger than they really are, or by outright deceiving them."
        LOREMASTER_NOTE "A cunning adversary might also find a way to trick the Player-heroes and lure them into a trap, or put them in a disadvantageous position using only words."
    }
    # ─────────────────────────────────────────────
    # COMBAT STANCES
    # ─────────────────────────────────────────────
    # All players select a combat stance for their heroes at the start of
    # each round. Adversaries do not choose stances: this rule portrays
    # exclusively a Player-hero's point of view.
    # 
    # There are three Close Combat stances (Forward, Open, Defensive) and
    # one Ranged Combat stance (Rearward). The first three allow combatants
    # to exchange blows in the thick of the fight using close combat weapons.
    # Rearward is the only stance which allows ranged attacks after opening
    # volleys.
    # 
    # Heroes can freely assume any close combat stance at the start of a
    # round, while the Rearward stance can be selected only if certain
    # requirements are met.
    # 
    # The Loremaster may allow more Player-heroes to assume a Rearward
    # stance than would normally be possible — for example, if the Company
    # is fighting on a narrow ledge, a mountain path, or similar features
    # that make ranged attacks easier. The same applies when the Company
    # outnumbers the opposition by at least two adventurers to one
    # human-sized enemy fighter (or four adventurers to one greater than
    # human-sized opponent).
    ^"Forward Stance" DEF {
        PROPERTIES {
            ^"Name" STRING "Forward Stance" FIXED
            ^"Type" STRING "Close Combat" FIXED
            ^"Effect" STRING "You seek to exploit any opportunity to attack, to the point of exposing yourself to the retaliation of your enemies. Your attack rolls gain (1d). All close combat attacks aimed at you gain (1d)." FIXED
            ^"Combat Task" STRING "Intimidate Foe" FIXED
            ^"Main Actions" LIST ["Attack", "Intimidate Foe"]
        }
    }
    ^"Open Stance" DEF {
        PROPERTIES {
            ^"Name" STRING "Open Stance" FIXED
            ^"Type" STRING "Close Combat" FIXED
            ^"Effect" STRING "You fight without sparing yourself, but giving proper attention to your enemies' actions. No advantage or disadvantage." FIXED
            ^"Combat Task" STRING "Rally Comrades" FIXED
            ^"Main Actions" LIST ["Attack", "Rally Comrades"]
        }
    }
    ^"Defensive Stance" DEF {
        PROPERTIES {
            ^"Name" STRING "Defensive Stance" FIXED
            ^"Type" STRING "Close Combat" FIXED
            ^"Effect" STRING "You fight conservatively, trying to protect yourself or others and holding your ground. All close combat attacks aimed at you lose (1d). Your attack rolls lose (1d) for each opponent engaging you." FIXED
            ^"Combat Task" STRING "Protect Companion" FIXED
            ^"Main Actions" LIST ["Attack", "Protect Companion"]
        }
    }
    ^"Rearward Stance" DEF {
        PROPERTIES {
            ^"Name" STRING "Rearward Stance" FIXED
            ^"Type" STRING "Ranged Combat" FIXED
            ^"Effect" STRING "You stay away from the press of the fighting to attack your foes from a distance. You can attack your adversaries using only ranged weapons, and you can only be targeted by attackers using similar weapons." FIXED
            ^"Combat Task" STRING "Prepare Shot" FIXED
            ^"Main Actions" LIST ["Attack (ranged)", "Prepare Shot"]
            ^"Requirements" STRING "Player-heroes are allowed to assume a Rearward stance only if the total number of enemies isn't more than twice the number of adventurers in the Company. Furthermore, for each Player-hero in Rearward there must be two other adventurers fighting in Close Combat stances." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # COMBAT TASKS
    # ─────────────────────────────────────────────
    COMBAT_TASKS {
        # NOTE: Heavy Blow, Fend Off, Pierce, and Shield Thrust are
        # Special Damage results (triggered by spending Success icons
        # after a successful hit), not Combat Tasks. See SPECIAL_DAMAGE.
        # 
        # All Combat Tasks use the hero's main action for the round
        # (instead of attacking). Each stance has one specific Combat Task.
        # Stance is chosen at step 1 of each Close Quarters round
        # (see ROUND_SEQUENCE), not as an action during resolution.
        ATTACK {
            DESCRIPTION "Player-heroes attack their enemies as a main action. They attack in close combat by fighting in Forward, Open, or Defensive stance, or from a distance using ranged weapons from a Rearward stance. Adversaries make close combat attacks if they are engaged in a Close Combat stance, and can use ranged weapons only if they stand back and remain unengaged."
            AVAILABLE_IN ["Forward Stance", "Open Stance", "Defensive Stance", "Rearward Stance"]
        }
        INTIMIDATE_FOE {
            DESCRIPTION "Make an AWE roll as a main action. On a success, all opponents with a Might rating of 1 are made Weary for the length of the round. If the roll produces one Tengwar icon, all opponents with a Might rating of 2 or lower are affected. If two or more Tengwar icons are rolled, all adversaries are affected."
            AVAILABLE_IN ["Forward Stance"]
            SKILL "AWE"
        }
        RALLY_COMRADES {
            DESCRIPTION "Make an ENHEARTEN roll as a main action. Only one Player-hero per round may attempt to Rally Comrades. On a success, all members of the Company fighting in a Forward stance gain (1d) on their rolls in the following round. If the roll produces one Tengwar icon, all members fighting in an Open stance gain (1d) as well. If two or more Tengwar icons are rolled, all members of the Company fighting in any Close Combat stance are affected."
            AVAILABLE_IN ["Open Stance"]
            SKILL "ENHEARTEN"
            LIMIT "Only one Player-hero per round may attempt to Rally Comrades."
        }
        PROTECT_COMPANION {
            DESCRIPTION "Make an ATHLETICS roll as a main action. On a success, the next attack aimed at the protected companion loses (1d). Every Tengwar icon produced by the roll further reduces the attack by an additional (1d)."
            AVAILABLE_IN ["Defensive Stance"]
            SKILL "ATHLETICS"
        }
        PREPARE_SHOT {
            DESCRIPTION "Make a SCAN roll as a main action. On a success, you gain (1d) on your next ranged attack. Every Tengwar icon produced by the roll grants an additional (1d) on the attack."
            AVAILABLE_IN ["Rearward Stance"]
            SKILL "SCAN"
        }
        FLY_YOU_FOOLS {
            DESCRIPTION "Heroes wishing to escape combat have two options."
            OPTION_1 "Assume a Rearward stance — the hero may leave the battlefield on their next turn without rolling, as long as no one stops them."
            OPTION_2 "Assume a Defensive stance and roll for an attack. If the attack is successful, instead of inflicting damage the hero disengages and escapes. If the attack fails, the hero remains engaged."
            UNENGAGED_ENEMIES "If enemies that have stood back and remained unengaged have no reason to fight, they may flee by the same means."
        }
    }
    # ─────────────────────────────────────────────
    # WEAPONS
    # ─────────────────────────────────────────────
    ^"Weapon" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Group" ENUM ["Axes", "Bows", "Spears", "Swords", "Brawling"] REQUIRED
            ^"Damage" INTEGER MIN 1 REQUIRED
            ^"Injury" INTEGER MIN 12
            ^"Load" INTEGER MIN 0 REQUIRED
            ^"Hands" ENUM ["1H", "2H", "1H or 2H"] DEFAULT "1H"
            ^"Notes" STRING
            ^"Throwable" BOOLEAN DEFAULT false
        }
    }
    # BRAWLING
    ^"Unarmed" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Unarmed" FIXED
            ^"Group" STRING "Brawling" FIXED
            ^"Damage" INTEGER 1 FIXED
            ^"Load" INTEGER 0 FIXED
            ^"Notes" STRING "Includes throwing stones. Cannot cause a Piercing Blow." FIXED
        }
    }
    ^"Dagger" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Dagger" FIXED
            ^"Description" STRING "One-handed blades have a range of uses, from skinning animals to settling disputes among brutes. Daggers and knives are very common, and in the wild areas of the land, no-one is found without one in their belt." FIXED
            ^"Group" STRING "Brawling" FIXED
            ^"Damage" INTEGER 2 FIXED
            ^"Injury" INTEGER 14 FIXED
            ^"Load" INTEGER 0 FIXED
            ^"Notes" STRING "Can trigger Pierce as if it was a Sword." FIXED
        }
    }
    ^"Short Sword" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Short Sword" FIXED
            ^"Description" STRING "Large daggers and knives, or smaller swords created for close-quarters combat." FIXED
            ^"Group" STRING "Swords" FIXED
            ^"Damage" INTEGER 3 FIXED
            ^"Injury" INTEGER 16 FIXED
            ^"Load" INTEGER 1 FIXED
        }
    }
    ^"Sword" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Sword" FIXED
            ^"Description" STRING "A straight-bladed, two-edged sword, wielded in one hand to hew or thrust. This is the most common type of sword." FIXED
            ^"Group" STRING "Swords" FIXED
            ^"Damage" INTEGER 4 FIXED
            ^"Injury" INTEGER 16 FIXED
            ^"Load" INTEGER 2 FIXED
        }
    }
    ^"Long Sword" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Long Sword" FIXED
            ^"Description" STRING "Only superior smiths can produce longer blades. These wonderful Elven and Dwarven weapons, and the keen blades forged from strange metals by the Men of the West, are often known as long swords. A long sword may either be wielded with one hand, or used to hack and sweep with two hands." FIXED
            ^"Group" STRING "Swords" FIXED
            ^"Damage" INTEGER 5 FIXED
            ^"Injury" INTEGER 16 FIXED
            ^"Load" INTEGER 3 FIXED
            ^"Hands" STRING "1H or 2H" FIXED
            ^"Notes" STRING "Injury 18 when used two-handed." FIXED
        }
    }
    # AXES
    ^"Axe" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Axe" FIXED
            ^"Description" STRING "A fighting variation on the common woodcutting tool, axes hang from the belt of many adventurers raised in or near forests." FIXED
            ^"Group" STRING "Axes" FIXED
            ^"Damage" INTEGER 5 FIXED
            ^"Injury" INTEGER 18 FIXED
            ^"Load" INTEGER 2 FIXED
        }
    }
    ^"Long-hafted Axe" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Long-hafted Axe" FIXED
            ^"Description" STRING "Borne with one or two hands, a long-hafted axe is designed to hack through the toughest of armour. It is difficult to manoeuvre but when mastered it is a fearful weapon. A skilled fighter learns to fight with the long haft as well as the heavy axe head." FIXED
            ^"Group" STRING "Axes" FIXED
            ^"Damage" INTEGER 6 FIXED
            ^"Injury" INTEGER 18 FIXED
            ^"Load" INTEGER 3 FIXED
            ^"Hands" STRING "1H or 2H" FIXED
            ^"Notes" STRING "Injury 20 when used two-handed." FIXED
        }
    }
    ^"Great Axe" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Great Axe" FIXED
            ^"Description" STRING "The great axe is an impressive weapon that can only be wielded with two hands. Its heavy head can leave both a deep dint on armour as a club and cleave it as a sword." FIXED
            ^"Group" STRING "Axes" FIXED
            ^"Damage" INTEGER 7 FIXED
            ^"Injury" INTEGER 20 FIXED
            ^"Load" INTEGER 4 FIXED
            ^"Hands" STRING "2H" FIXED
        }
    }
    ^"Mattock" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Mattock" FIXED
            ^"Description" STRING "A heavy digging implement sporting a curved head with a point on one side and a spade-like blade on the other. It was used to fearsome effect by the Dwarves who followed Dain Ironfoot during the Battle of Five Armies." FIXED
            ^"Group" STRING "Axes" FIXED
            ^"Damage" INTEGER 7 FIXED
            ^"Injury" INTEGER 18 FIXED
            ^"Load" INTEGER 3 FIXED
            ^"Hands" STRING "2H" FIXED
        }
    }
    # SPEARS
    ^"Short Spear" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Short Spear" FIXED
            ^"Description" STRING "Approximately six feet in length, a spear can be hurled as a javelin, or deftly thrust with one hand." FIXED
            ^"Group" STRING "Spears" FIXED
            ^"Damage" INTEGER 3 FIXED
            ^"Injury" INTEGER 14 FIXED
            ^"Load" INTEGER 2 FIXED
            ^"Throwable" BOOLEAN true FIXED
        }
    }
    ^"Spear" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Spear" FIXED
            ^"Description" STRING "Maybe the most versatile weapon of all, a spear can be thrown, or used with one or two hands." FIXED
            ^"Group" STRING "Spears" FIXED
            ^"Damage" INTEGER 4 FIXED
            ^"Injury" INTEGER 14 FIXED
            ^"Load" INTEGER 3 FIXED
            ^"Hands" STRING "1H or 2H" FIXED
            ^"Notes" STRING "Injury 16 when used two-handed. Can throw." FIXED
            ^"Throwable" BOOLEAN true FIXED
        }
    }
    ^"Great Spear" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Great Spear" FIXED
            ^"Description" STRING "With a shaft longer than any other spear, a great spear cannot be used as a ranged weapon, and must be wielded with two hands." FIXED
            ^"Group" STRING "Spears" FIXED
            ^"Damage" INTEGER 5 FIXED
            ^"Injury" INTEGER 16 FIXED
            ^"Load" INTEGER 4 FIXED
            ^"Hands" STRING "2H" FIXED
        }
    }
    # BOWS
    ^"Bow" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Bow" FIXED
            ^"Description" STRING "The simple bow is not very different from a hunting-bow. It never measures more than five feet in length, so as to be strung more quickly." FIXED
            ^"Group" STRING "Bows" FIXED
            ^"Damage" INTEGER 3 FIXED
            ^"Injury" INTEGER 14 FIXED
            ^"Load" INTEGER 2 FIXED
            ^"Hands" STRING "2H" FIXED
            ^"Notes" STRING "Ranged weapon." FIXED
        }
    }
    ^"Great Bow" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Great Bow" FIXED
            ^"Description" STRING "As tall as a Man and offering superior potency, a great bow can only be used by warriors with the height and stature to bend it fully. An arrow from a great bow can pierce the toughest of armour." FIXED
            ^"Group" STRING "Bows" FIXED
            ^"Damage" INTEGER 4 FIXED
            ^"Injury" INTEGER 16 FIXED
            ^"Load" INTEGER 4 FIXED
            ^"Hands" STRING "2H" FIXED
            ^"Notes" STRING "Ranged weapon. Cannot be used by Dwarves or Hobbits." FIXED
        }
    }
    # BRAWLING (improvised / simple)
    ^"Cudgel" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Cudgel" FIXED
            ^"Description" STRING "A cudgel is any bashing implement used with one hand, like a small club or short staff." FIXED
            ^"Group" STRING "Brawling" FIXED
            ^"Damage" INTEGER 3 FIXED
            ^"Injury" INTEGER 12 FIXED
            ^"Load" INTEGER 0 FIXED
        }
    }
    ^"Club" DEF {
        EXTENDS ^"Weapon"
        PROPERTIES {
            ^"Name" STRING "Club" FIXED
            ^"Description" STRING "A club is probably the simplest form of weapon. It may consist of a crude, heavy piece of wood, a nasty instrument reinforced with iron, or an elaborately-carved staff used also as a symbol of status." FIXED
            ^"Group" STRING "Brawling" FIXED
            ^"Damage" INTEGER 4 FIXED
            ^"Injury" INTEGER 14 FIXED
            ^"Load" INTEGER 1 FIXED
        }
    }
    # ─────────────────────────────────────────────
    # ARMOUR
    # ─────────────────────────────────────────────
    ^"Armour" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Type" ENUM ["Leather armour", "Mail armour"] REQUIRED
            ^"Protection" INTEGER MIN 1 REQUIRED
            ^"Load" INTEGER MIN 0 REQUIRED
            ^"Notes" STRING
        }
    }
    ^"Leather Shirt" DEF {
        EXTENDS ^"Armour"
        PROPERTIES {
            ^"Name" STRING "Leather Shirt" FIXED
            ^"Description" STRING "The simplest suit of armour available, leather armour is made of layers of cured and hardened animal hide sewn together. It is ideal for hunting or travelling as it is lightweight and comfortable, especially compared to mail armour. A leather shirt protects the back, chest, and abdomen." FIXED
            ^"Type" STRING "Leather armour" FIXED
            ^"Protection" INTEGER 1 FIXED
            ^"Load" INTEGER 3 FIXED
        }
    }
    ^"Leather Corslet" DEF {
        EXTENDS ^"Armour"
        PROPERTIES {
            ^"Name" STRING "Leather Corslet" FIXED
            ^"Description" STRING "A close-fitting corslet with long sleeves, extending the protection of leather armour to the wearer's hips." FIXED
            ^"Type" STRING "Leather armour" FIXED
            ^"Protection" INTEGER 2 FIXED
            ^"Load" INTEGER 6 FIXED
        }
    }
    ^"Mail-shirt" DEF {
        EXTENDS ^"Armour"
        PROPERTIES {
            ^"Name" STRING "Mail-shirt" FIXED
            ^"Description" STRING "Mail is the most effective type of armour encountered in Middle-earth at the end of the Third Age. These suits of close-fitting metal rings are created to protect from cutting and thrusting weapons. A mail shirt is a chain garment protecting the back, chest, and abdomen of its wearer." FIXED
            ^"Type" STRING "Mail armour" FIXED
            ^"Protection" INTEGER 3 FIXED
            ^"Load" INTEGER 9 FIXED
            ^"Minimum Standard of Living" STRING "Common" FIXED
            ^"Notes" STRING "See Standard of Living requirements." FIXED
        }
    }
    ^"Coat of Mail" DEF {
        EXTENDS ^"Armour"
        PROPERTIES {
            ^"Name" STRING "Coat of Mail" FIXED
            ^"Description" STRING "A coat of mail is a mail shirt with long sleeves. From the shining hauberks of Elven lords to the black mail of Orc-chieftains, mail armour appears in widely different qualities. Ancient coats of Dwarf-make, when found, are matchless and prized possessions." FIXED
            ^"Type" STRING "Mail armour" FIXED
            ^"Protection" INTEGER 4 FIXED
            ^"Load" INTEGER 12 FIXED
            ^"Minimum Standard of Living" STRING "Prosperous" FIXED
            ^"Notes" STRING "See Standard of Living requirements." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # HELMS
    # ─────────────────────────────────────────────
    ^"Helm" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Protection" INTEGER MIN 1 DEFAULT 1
            ^"Load" INTEGER MIN 0 REQUIRED
            ^"Notes" STRING
        }
    }
    ^"Helm (standard)" DEF {
        EXTENDS ^"Helm"
        PROPERTIES {
            ^"Name" STRING "Helm" FIXED
            ^"Description" STRING "Worn in battle or for ceremonial purposes, helms are usually made of leather or iron, but sometimes of more precious metals. The shape of a helm or its decoration is often distinctive, as it helps identify the wearer or their folk. More often than not, the protective features of the helm, especially nose-guards or close-fitting cheek-guards, obscure the face and make it impossible to recognise the wearer otherwise." FIXED
            ^"Protection" INTEGER 1 FIXED
            ^"Load" INTEGER 4 FIXED
            ^"Notes" STRING "May be removed in combat to lower Load." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # SHIELDS
    # ─────────────────────────────────────────────
    ^"Shield" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Parry Bonus" INTEGER MIN 1 REQUIRED
            ^"Load" INTEGER MIN 0 REQUIRED
            ^"Notes" STRING
        }
    }
    ^"Buckler" DEF {
        EXTENDS ^"Shield"
        PROPERTIES {
            ^"Name" STRING "Buckler" FIXED
            ^"Description" STRING "Circular and made of wood reinforced by a protruding metal boss, bucklers are usually smaller and lighter than regular shields." FIXED
            ^"Parry Bonus" INTEGER 1 FIXED
            ^"Load" INTEGER 2 FIXED
        }
    }
    ^"Shield (standard)" DEF {
        EXTENDS ^"Shield"
        PROPERTIES {
            ^"Name" STRING "Shield" FIXED
            ^"Description" STRING "Round or oval, shields are made of several layers of wood, often reinforced by a large central iron boss, usually decorated and engraved. A regular shield offers good protection from arrows, and is very effective at close quarters." FIXED
            ^"Parry Bonus" INTEGER 2 FIXED
            ^"Load" INTEGER 4 FIXED
            ^"Minimum Standard of Living" STRING "Common" FIXED
            ^"Notes" STRING "See Standard of Living requirements." FIXED
        }
    }
    ^"Great Shield" DEF {
        EXTENDS ^"Shield"
        PROPERTIES {
            ^"Name" STRING "Great Shield" FIXED
            ^"Description" STRING "Kite-shaped, round or barrel-shaped, these shields are carried by the sturdiest of warriors, and are used to carry back their bodies should they fall, but are considered too cumbersome and unwieldy by some." FIXED
            ^"Parry Bonus" INTEGER 3 FIXED
            ^"Load" INTEGER 6 FIXED
            ^"Minimum Standard of Living" STRING "Prosperous" FIXED
            ^"Notes" STRING "See Standard of Living requirements." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # STARTING GEAR
    # ─────────────────────────────────────────────
    STARTING_GEAR {
        WEAPONS "A newly-created character starts with one weapon for each Combat Proficiency for which they have a rating."
        ARMOUR "A newly-created character starts with one suit of armour, and may choose to wear a helm and carry one shield."
        ARMOUR_NOTE "The Protection score of body armour is recorded separately from that of a helm. Shields provide a Parry bonus recorded separately from the main Parry rating, as shields can be smashed by opponent blows."
        TRAVELLING_GEAR "A hero's travelling gear includes belongings carried on a journey in addition to weapons and armour. Travelling gear does not need to be annotated in detail and is not given a Load rating."
    }
    # ─────────────────────────────────────────────
    # LOAD
    # ─────────────────────────────────────────────
    LOAD_RULES {
        DESCRIPTION "Load is monitored only as far as War Gear and Treasure is concerned. All heroes are considered to carry without discomfort a reasonable amount of personal items and gear for a life on the road."
        TRACKING "Players keep track of their hero's Load score and must update it when War Gear or Treasure is added or removed."
    }
    # ─────────────────────────────────────────────
    # USEFUL ITEMS
    # ─────────────────────────────────────────────
    USEFUL_ITEMS {
        DESCRIPTION "Any tool, instrument, or device carried by a Player-hero to perform specific tasks. Each useful item is associated with a Skill, possibly with a brief definition of its use."
        EFFECT "If a Player-hero is making a roll outside of combat using a Skill associated with a useful item, and the Loremaster deems the item relevant, the Player-hero gains (1d). Only one item can benefit the same die roll."
        STARTING_ITEMS_BY_STANDARD_OF_LIVING {
            "Poor"
            0 "Frugal"
            1 "Common"
            2 "Prosperous"
            3 "Rich or Very Rich"
            4
        }
    }
    # ─────────────────────────────────────────────
    # PONIES AND HORSES
    # ─────────────────────────────────────────────
    MOUNTS {
        DESCRIPTION "The number and quality of mounts available to Player-heroes depends on their individual Standard of Living, but mounts are tracked as a shared Company asset."
        FATIGUE_REDUCTION "At the end of a journey, Player-heroes travelling with a mount reduce their Fatigue total by their beast's Vigour rating."
        TREASURE_CAPACITY "Each pack animal can carry Treasure up to 10 points of Load."
        STARTING_MOUNT_BY_STANDARD_OF_LIVING {
            "Poor or Frugal"
            { ^"Mount" STRING "Cannot afford a mount"         ^"Vigour" INTEGER 0 }
            "Common"
            { ^"Mount" STRING "Old horse or half-starved pony" ^"Vigour" INTEGER 1 }
            "Prosperous"
            { ^"Mount" STRING "Decent beast"                  ^"Vigour" INTEGER 2 }
            "Rich or Very Rich"
            { ^"Mount" STRING "Fine beast"                    ^"Vigour" INTEGER 3 }
        }
    }
    # ─────────────────────────────────────────────
    # EQUIPMENT REWARDS (advancement — post-creation only)
    # ─────────────────────────────────────────────
    # A Player-hero chooses a new Reward each time they gain a new rank
    # in Valour. All upgrades can be applied only once to the same piece
    # of gear. The same Reward may be applied to different items.
    # These are the advancement versions of Rewards, gained when Valour
    # increases post-creation. NOT the same as Starting Rewards (which are
    # in core-base.ttrpg and are only available during character creation).
    # Some share names with Starting Rewards but are treated distinctly.
    ^"Close-fitting" DEF {
        EXTENDS ^"Reward"
        PROPERTIES {
            ^"Name" STRING "Close-fitting" FIXED
            ^"Description" STRING "A suit of Close-fitting armour or a helm has been expertly tailored or altered to fit its wearer, and is thus easier to wear and to move about in." FIXED
            ^"Applies To" STRING "Armour or Helm" FIXED
            ^"Effect" STRING "When making a PROTECTION roll, add +2 to the result." FIXED
        }
    }
    ^"Cunning Make" DEF {
        EXTENDS ^"Reward"
        PROPERTIES {
            ^"Name" STRING "Cunning Make" FIXED
            ^"Description" STRING "An item of Cunning Make has been fashioned using superior materials and skills, making it lighter and more flexible." FIXED
            ^"Applies To" STRING "Armour, Helm, or Shield" FIXED
            ^"Effect" STRING "Reduce the Load rating of the selected item by 2 (to a minimum of 0 Load)." FIXED
        }
    }
    ^"Fell" DEF {
        EXTENDS ^"Reward"
        PROPERTIES {
            ^"Name" STRING "Fell" FIXED
            ^"Description" STRING "A Fell weapon has been forged to inflict the deepest wounds, and its Piercing Blows are stopped less easily by armour." FIXED
            ^"Applies To" STRING "Weapon" FIXED
            ^"Effect" STRING "Add 2 to the Injury rating of the selected weapon. A weapon that can be wielded with one or two hands gets the bonus to both its Injury ratings." FIXED
        }
    }
    ^"Grievous" DEF {
        EXTENDS ^"Reward"
        PROPERTIES {
            ^"Name" STRING "Grievous" FIXED
            ^"Description" STRING "A Grievous weapon is strong and heavy, and inflicts terrible harm on its targets." FIXED
            ^"Applies To" STRING "Weapon" FIXED
            ^"Effect" STRING "Add 1 to the Damage rating of the selected weapon." FIXED
        }
    }
    ^"Keen" DEF {
        EXTENDS ^"Reward"
        PROPERTIES {
            ^"Name" STRING "Keen" FIXED
            ^"Description" STRING "A Keen weapon has been ground to a fine edge and always finds the weakest point when it strikes an adversary." FIXED
            ^"Applies To" STRING "Weapon" FIXED
            ^"Effect" STRING "Attack rolls made with a Keen weapon score a Piercing Blow also on a result of 9 on the Feat Die." FIXED
        }
    }
    ^"Reinforced" DEF {
        EXTENDS ^"Reward"
        PROPERTIES {
            ^"Name" STRING "Reinforced" FIXED
            ^"Description" STRING "A Reinforced shield is bound by iron and will endure hard blows." FIXED
            ^"Applies To" STRING "Shield" FIXED
            ^"Effect" STRING "Add 1 to the shield's Parry bonus." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # ITEMS OF SUPERIOR WORTH
    # ─────────────────────────────────────────────
    # A piece of war gear that has been upgraded with one or more Rewards
    # is considered an item of superior worth and enjoys plot immunity.
    ITEMS_OF_SUPERIOR_WORTH {
        PLOT_IMMUNITY "An item of superior worth cannot be lost, stolen, broken, or otherwise taken away from a Player-hero by game events."
        REPLACEMENT "If an item of superior worth is lost due to extraordinary circumstances, the Player-hero finds a suitable replacement the next time they visit a settlement. The Reward upgrades transfer to the new item."
        NON_TRANSFERABLE "Items of superior worth cannot be handed over to another Player-hero."
        ONCE_PER_ITEM "All upgrades can be applied only once to the same piece of gear. The same Reward may be applied to different items."
    }
    # ─────────────────────────────────────────────
    # FELL ABILITIES (adversary special powers)
    # ─────────────────────────────────────────────
    ^"Craven" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Craven" FIXED
            ^"Effect" STRING "When reduced to half Endurance, makes a Shadow Test or flees." FIXED
        }
    }
    ^"Horrible Strength" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Horrible Strength" FIXED
            ^"Effect" STRING "On a Seize result, heroes must pass a Strength test or be automatically wounded." FIXED
        }
    }
    ^"Hideous Toughness" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Hideous Toughness" FIXED
            ^"Effect" STRING "When first reduced to 0 Endurance, roll the Feat Die: on 1–5, the adversary is not defeated yet and keeps fighting at Endurance 1." FIXED
        }
    }
    ^"Orc-poison" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Orc-poison" FIXED
            ^"Effect" STRING "A wound from this weapon is poisoned. The hero continues to lose 1 Endurance per round until healed." FIXED
        }
    }
    ^"Thick Hide" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Thick Hide" FIXED
            ^"Effect" STRING "All hero PROTECTION rolls against this creature are Ill-favoured." FIXED
        }
    }
    ^"Strike Fear" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Strike Fear" FIXED
            ^"Effect" STRING "Heroes must pass a Shadow Test at the start of the first round or be Ill-favoured on all actions that round." FIXED
        }
    }
    ^"Denizen of the Dark" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Denizen of the Dark" FIXED
            ^"Effect" STRING "In darkness, this creature's attack rolls are Favoured." FIXED
        }
    }
    ^"Fear of Fire" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Fear of Fire" FIXED
            ^"Effect" STRING "If a hero exposes this creature to flame, it retreats and makes all rolls Ill-favoured until the flame is extinguished." FIXED
        }
    }
    ^"Hate Sunlight" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Hate Sunlight" FIXED
            ^"Effect" STRING "In direct sunlight, this creature's rolls are Ill-favoured." FIXED
        }
    }
    ^"Fierce" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Fierce" FIXED
            ^"Effect" STRING "This adversary always acts first in the combat round, before any hero." FIXED
        }
    }
    ^"Deathless" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Deathless" FIXED
            ^"Effect" STRING "Normal weapons cannot destroy this creature. Only Magical weapons, fire, or specific weaknesses can reduce it to 0 Endurance permanently." FIXED
        }
    }
    ^"Heartless" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Heartless" FIXED
            ^"Effect" STRING "This creature cannot be Intimidated or frightened; it ignores the effects of Enhearten and similar abilities." FIXED
        }
    }
    ^"Thing of Terror" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Thing of Terror" FIXED
            ^"Effect" STRING "At the start of every round, all heroes must make a Shadow Test or act Ill-favoured." FIXED
        }
    }
    ^"Great Leap" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Great Leap" FIXED
            ^"Effect" STRING "This creature can move from Rearward to Close range in a single action, bypassing normal movement rules." FIXED
        }
    }
    ^"Darker than the Darkness" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Darker than the Darkness" FIXED
            ^"Effect" STRING "Extinguishes all non-magical light sources within range at the start of combat." FIXED
        }
    }
    ^"Dreadful Spells" DEF {
        EXTENDS ^"FellAbility"
        PROPERTIES {
            ^"Name" STRING "Dreadful Spells" FIXED
            ^"Effect" STRING "Once per round, may target one hero with a curse effect as a secondary action (Loremaster determines effect based on Shadow Path)." FIXED
        }
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # JOURNEY OVERVIEW
    # ─────────────────────────────────────────────
    # Journeys are one of three Heroic Ventures (alongside
    # Combat and Councils). A journey is much more than
    # simply a means of getting to a destination — it is
    # synonymous with adventuring.
    JOURNEY_OVERVIEW {
        DESCRIPTION "A Company will often end up travelling across long leagues of inhospitable and unfamiliar areas in the course of their errands and quests. A journey is much more than simply a means of getting to a destination — travelling Player-heroes see the world, witness wondrous events, and face challenges that put their capabilities to the test. Gameplay during a journey is less focused on details; everyone involved should try to blend the structure into an ongoing narrative."
        THERE_AND_BACK_AGAIN {
            DESCRIPTION "Journey rules are not meant to be used every time the Company is on the road. In particular, they should rarely be used when the heroes are on their way back home — the main effects of adventuring are not very relevant if the Company is headed for a safe haven. The journey back should be played out in detail only when an Adventuring Phase may profit from a closing act, or when reaching the destination was just part of the Player-heroes' mission (for example, if they are escorting someone back with them)."
        }
        MAP_RULES {
            DESTINATION "The Company must know at least approximately where their destination is located to be able to reach it."
            PLAYERS_MAP "The Players' Map represents the geographical lore of experienced adventurers — a deeper knowledge than that possessed by the average denizen of Eriador. All locations indicated as villages or towns may be chosen as destinations."
            UPDATING_LORE "Players can update their geographical lore during play by making a copy of the map and writing directly on it, adding the places they visit."
        }
        JOURNEY_LOG "A journey log is a summary sheet used to keep track of all the details concerning a journey. Compiled journey logs work as a journal of the Company's accomplishments."
    }
    # ─────────────────────────────────────────────
    # JOURNEY SEQUENCE
    # Three-step procedure for resolving travel.
    # ─────────────────────────────────────────────
    JOURNEY_SEQUENCE {
        STEP_1 "Set Journey Path — trace an itinerary on the map from starting location to destination, counting hexes (not counting the starting hex). If the journey exceeds 20 hexes, the Loremaster should split it into separate legs."
        STEP_2 "Make Marching Tests — the Guide repeatedly rolls TRAVEL to determine where the next event occurs, resolving events as they arise."
        STEP_3 "End the Journey — when a Marching Test result equals or exceeds the number of hexes remaining to the destination."
    }
    # ─────────────────────────────────────────────
    # MARCHING TEST
    # Made by the Guide using TRAVEL (Heart skill).
    # TN = the Guide's own Heart TN.
    # ─────────────────────────────────────────────
    MARCHING_TEST {
        SKILL "Travel"
        TN_SOURCE "Guide's Heart TN"
        ROLLING_HERO "Guide (exactly one per Company)"
        # The result determines the distance to the next event,
        # NOT whether an event occurs — events always occur eventually.
        ON_FAILURE {
            EVENT_DISTANCE_SPRING_SUMMER "2 hexes ahead"
            EVENT_DISTANCE_AUTUMN_WINTER "1 hex ahead"
            # Eye of Sauron on the Feat Die causes automatic failure;
            # it is NOT an additional separate encounter.
        }
        ON_SUCCESS {
            # Distance = 3 hexes + 1 hex per Success icon
            EVENT_DISTANCE "3 hexes + 1 per Success icon"
        }
        JOURNEY_END "The journey ends when the Marching Test result equals or exceeds the remaining hexes between the Company's current position and the destination."
        JOURNEY_END_ALT "A journey also ends when an unexpected occurrence engages the Company in a different activity for a significant amount of time — the Loremaster adjudicates whether this ends the journey or not."
        NEXT_TEST "After each event is resolved, the Guide makes a new Marching Test."
    }
    # ─────────────────────────────────────────────
    # ROLE ASSIGNMENT RULES
    # All four roles must be covered.
    # ─────────────────────────────────────────────
    ROLE_ASSIGNMENT {
        GUIDE_LIMIT "Exactly one — no other Player-hero can be the Guide"
        SHARED_ROLES "Hunter, Look-out, Scout may be shared by any number of heroes"
        SOLO_RULE "If fewer than four heroes, one hero may cover multiple roles (the Guide may also hold other roles)"
        ALL_COVERED "All four roles must be covered before the journey begins"
    }
    # ─────────────────────────────────────────────
    # EVENT RESOLUTION
    # Three-step procedure applied at each event location.
    # ─────────────────────────────────────────────
    EVENT_RESOLUTION {
        STEP_1 "Select Targets — Loremaster rolls one Success Die (d6) and consults the Event Target table."
        STEP_2 {
            DESCRIPTION "Determine Event — the Loremaster checks the map to see which Region type the event is taking place in, then rolls the Feat Die accordingly."
            # Terrain type determines the Feat Die roll mode (see Favoured/Ill-favoured in ROLL_MECHANICS).
            BORDER_LANDS "Favoured Feat Die roll"
            WILD_LANDS "Normal Feat Die roll"
            DARK_LANDS "Ill-favoured Feat Die roll"
        }
        STEP_3 {
            DESCRIPTION "Resolve the Event — one Player-hero among those selected as targets makes a roll using the Skill identified in step 1. Up to one other Player-hero covering the same role can choose to support the roll."
            SUPPORT "Up to one Player-hero covering the same journey role may support the roll."
            ROADS_AND_HARD_TERRAIN {
                HARD_TERRAIN "If the event takes place in a hex suggesting hard terrain, the Player-hero making the roll loses (1d)."
                ROAD "If the event happens along a road, the Player-hero gains (1d)."
            }
            TARGET_DEFINITION "A consequence indicating 'the target' concerns the Player-hero who made the roll (and the one who gave support, if any)."
            FATIGUE "The rightmost column of the Journey Events Table indicates how many Fatigue points are gained by each Player-hero in the Company."
        }
    }
    # ─────────────────────────────────────────────
    # EVENT TARGET TABLE
    # Rolled with a Success Die (d6) by the Loremaster.
    # Determines which role is challenged and which skill is tested.
    # Note: Guide does not appear — Guide only makes Marching Tests.
    # ─────────────────────────────────────────────
    EVENT_TARGET_TABLE {
        ^"1-2"
        TARGET "Scouts"
        SKILL "Explore"
        ^"3-4"
        TARGET "Look-outs"
        SKILL "Awareness"
        ^"5-6"
        TARGET "Hunters"
        SKILL "Hunting"
    }
    # ─────────────────────────────────────────────
    # JOURNEY EVENTS TABLE
    # Feat Die (d12) result → event type, Fatigue gained by EACH hero
    # in the Company, and consequences of the targeted role's skill roll.
    # ─────────────────────────────────────────────
    JOURNEY_EVENTS_TABLE {
        # Feat Die: Eye of Sauron (automatic failure on Marching Test)
        ^"Eye of Sauron"
        {
            EVENT "Terrible Misfortune"
            FATIGUE_GAINED 3
            ON_FAIL "The target is Wounded."
            NARRATIVE "Something went so badly the Company trudges wearily; the target risked serious harm."
        }
        # Feat Die: 1
        ^"1"
        {
            EVENT "Despair"
            FATIGUE_GAINED 2
            ON_FAIL "Everyone in the Company gains 1 Shadow point (Dread)."
            NARRATIVE "A terrible ordeal connected to the rising Shadow — blighted areas, grisly remains, evil presences."
        }
        # Feat Die: 2–3
        ^"2"
        {
            EVENT "Ill Choices"
            FATIGUE_GAINED 2
            ON_FAIL "The target gains 1 Shadow point (Dread)."
            NARRATIVE "Failing caused the target grief or frustration — wrong paths, scanty provisions, constant fear of danger."
        }
        ^"3"
        {
            EVENT "Ill Choices"
            FATIGUE_GAINED 2
            ON_FAIL "The target gains 1 Shadow point (Dread)."
            NARRATIVE "Failing caused the target grief or frustration — wrong paths, scanty provisions, constant fear of danger."
        }
        # Feat Die: 4–7
        ^"4"
        {
            EVENT "Mishap"
            FATIGUE_GAINED 2
            ON_FAIL "Add 1 day to the length of the journey, and the target gains 1 additional Fatigue."
            NARRATIVE "Adversity slowed or stopped the Company; poor preparation or bad luck caused delay."
        }
        ^"5"
        {
            EVENT "Mishap"
            FATIGUE_GAINED 2
            ON_FAIL "Add 1 day to the length of the journey, and the target gains 1 additional Fatigue."
            NARRATIVE "Adversity slowed or stopped the Company; poor preparation or bad luck caused delay."
        }
        ^"6"
        {
            EVENT "Mishap"
            FATIGUE_GAINED 2
            ON_FAIL "Add 1 day to the length of the journey, and the target gains 1 additional Fatigue."
            NARRATIVE "Adversity slowed or stopped the Company; poor preparation or bad luck caused delay."
        }
        ^"7"
        {
            EVENT "Mishap"
            FATIGUE_GAINED 2
            ON_FAIL "Add 1 day to the length of the journey, and the target gains 1 additional Fatigue."
            NARRATIVE "Adversity slowed or stopped the Company; poor preparation or bad luck caused delay."
        }
        # Feat Die: 8–9
        ^"8"
        {
            EVENT "Short Cut"
            FATIGUE_GAINED 1
            ON_SUCCESS "Reduce the length of the journey by 1 day."
            NARRATIVE "A successful roll allowed faster progress — a shorter path found, a bountiful hunt, no delay needed."
        }
        ^"9"
        {
            EVENT "Short Cut"
            FATIGUE_GAINED 1
            ON_SUCCESS "Reduce the length of the journey by 1 day."
            NARRATIVE "A successful roll allowed faster progress — a shorter path found, a bountiful hunt, no delay needed."
        }
        # Feat Die: 10
        ^"10"
        {
            EVENT "Chance-Meeting"
            FATIGUE_GAINED 1
            ON_SUCCESS "No Fatigue is gained, and the Loremaster improvises an encounter favouring the Company."
            NARRATIVE "The heroes encounter someone useful — other travellers, friendly locals, or possibly a major character."
        }
        # Feat Die: Gandalf Rune (12 — always a great success on the Marching Test)
        ^"Gandalf Rune"
        {
            EVENT "Joyful Sight"
            FATIGUE_GAINED 0
            ON_SUCCESS "Everyone in the Company regains 1 Hope."
            NARRATIVE "An exceptional occurrence lifts the spirit — Wandering Elves, Great Eagles, a benevolent spirit, or one of the Wise."
        }
    }
    # ─────────────────────────────────────────────
    # TRAVEL FATIGUE
    # Fatigue accumulates from events (not from terrain or hexes traversed).
    # See also: Fatigue field on Hero and Weary rules in tor2e-2e-core-base.ttrpg.
    # ─────────────────────────────────────────────
    TRAVEL_FATIGUE {
        SOURCE "Journey Events — amount determined by the Journey Events Table"
        DURING_JOURNEY "Fatigue cannot be removed while the journey is in progress"
        WEARY_INTERACTION "Fatigue temporarily raises a hero's Load total. Weary = Endurance <= (Load + Fatigue). Mounts do NOT affect the Weary condition during a journey."
        END_OF_JOURNEY {
            STEP_1 {
                APPLIES_TO "Heroes travelling with a mount"
                EFFECT "Reduce total Fatigue by the mount's Vigour rating before making the TRAVEL roll"
            }
            STEP_2 {
                APPLIES_TO "All heroes"
                ROLL "Travel"
                ON_SUCCESS "Reduce total Fatigue by 1, plus 1 additional point per Success icon rolled"
            }
            RECOVERY "Any remaining Fatigue is removed at 1 point per Prolonged Rest taken in a sheltered, safe refuge (not on the road)"
        }
    }
    # ─────────────────────────────────────────────
    # MOUNTS AND JOURNEYS
    # Mount DEF and MOUNT_TABLE are defined in tor2e-2e-core-base.ttrpg
    # (under Standards of Living). Journey-specific mount effects only:
    # ─────────────────────────────────────────────
    MOUNT_JOURNEY_EFFECTS {
        SPEED "Horses halve journey length in days where terrain permits (roads and good paths only — heavily wooded regions do not allow horseback travel)"
        FATIGUE_REDUCTION "At end of journey, rider reduces accumulated Fatigue by mount's Vigour rating (applied before TRAVEL roll)"
        WEARY_NOTE "Mounts do not reduce Load or otherwise affect the Weary condition during the journey itself"
    }
    # ─────────────────────────────────────────────
    # PERILOUS AREAS
    # Not regular map hexes — special areas with a Peril rating.
    # ─────────────────────────────────────────────
    PERILOUS_AREAS {
        DESCRIPTION "Locations on the Journey Map not marked with hexagons — thick woodland, steep mountain passes, treacherous marshes, and other hazardous terrain."
        PERIL_RATING "A numerical danger value. When a Marching roll would lead the Company into or across a Perilous Area:"
        PROCEDURE {
            STEP_1 "The Company stops as soon as it enters the Perilous Area"
            STEP_2 "They must face a number of Events equal to the Peril rating (all normal Event Resolution rules apply)"
            STEP_3 "Once all Events are resolved, the Company continues from the first hex outside the Perilous Area, resuming normal Marching rolls"
        }
        NOTE "Supplements may provide special Journey Events Tables for specific Perilous Areas."
    }
    # ─────────────────────────────────────────────
    # JOURNEY LENGTH (optional calculation)
    # ─────────────────────────────────────────────
    JOURNEY_LENGTH {
        BASE "1 day per hex in the journey path"
        HARD_TERRAIN "Add 1 day per hex of hard terrain (hills, woods, marshes, etc.)"
        ON_HORSEBACK "Halve the total (round up) if the entire Company is mounted"
        FORCED_MARCH {
            RATE "1 day per 2 hexes instead of 1 day per hex"
            COST "Each hero accumulates 1 additional Fatigue point per day of forced march"
        }
    }
    # ─────────────────────────────────────────────
    # MAP TERRAIN CLASSIFICATIONS
    # Terrain type determines the Feat Die roll mode in Step 2 of Event Resolution.
    # See Favoured/Ill-favoured in ROLL_MECHANICS (core-base).
    # Virtues that upgrade terrain tier (e.g. treat Wild Lands as Border Lands)
    # improve the Feat Die roll mode for events occurring in that terrain.
    # ─────────────────────────────────────────────
    TERRAIN_TYPES {
        ^"Border Lands"
        {
            DESCRIPTION "Settled or patrolled areas at the edge of civilisation"
            EVENT_FEAT_DIE_ROLL "Favoured"
        }
        ^"Wild Lands"
        {
            DESCRIPTION "Uninhabited wilderness beyond civilised borders"
            EVENT_FEAT_DIE_ROLL "Normal"
        }
        ^"Dark Lands"
        {
            DESCRIPTION "Regions deeply tainted by shadow or actively held by the Enemy"
            EVENT_FEAT_DIE_ROLL "Ill-favoured"
        }
        ^"Impassable Terrain"
        {
            DESCRIPTION "Terrain that cannot normally be crossed (cliffs, deep water, etc.)"
            EVENT_FEAT_DIE_ROLL "N/A — cannot be traversed"
        }
        ^"Perilous Area"
        {
            DESCRIPTION "A specific dangerous location with a Peril rating (see Perilous Areas). Supplements may provide dedicated Journey Events Tables."
            EVENT_FEAT_DIE_ROLL "Normal unless otherwise specified by the supplement"
        }
        SCALE "1 hex = 20 miles"
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # ADVENTURING IN MIDDLE-EARTH
    # Loremaster guidance for designing Adventuring Phases.
    # ─────────────────────────────────────────────
    ADVENTURING_IN_MIDDLE_EARTH {
        DESCRIPTION "This section presents a number of questions that can help the Loremaster to make the world of Middle-earth itself a main element in the adventures of the Player-heroes."
        WHEN {
            DESCRIPTION "When is the Adventuring Phase taking place? Time is an important element to consider in The One Ring, as whatever happens will become an episode in the Player-heroes' lives. Moreover, important events involving the Company will eventually find their rightful place in the game's Tale of Years, alongside the historical facts which make up the Twilight of the Third Age."

            CURRENT_SEASON {
                DESCRIPTION "The passing of the seasons is a powerful descriptive tool. Across the twelve months of the year, the Free Peoples respect seasonal festivals and ceremonies, and the landscape of Middle-earth changes drastically from summer to autumn, and from winter to spring, providing a backdrop to the deeds of the Player-heroes that is always different."
                GAMEPLAY "The Loremaster can add flavour to the game by simply keeping a calendar, and reflecting the changes as the seasons pass. But seasons have a direct effect on the gameplay too — climbing a mountain in winter poses a more serious challenge than doing so in spring, as trails disappear and wolves prowl the land in search of food. The mountains themselves appear to heed a more sinister call when their passes are thick with snow, and the winds rage around their peaks (it is for good reason that a Company generally prefers to sit out the winter months in the warmth and safety of a Fellowship Phase)."
            }

            CURRENT_YEAR {
                DESCRIPTION "There is nothing like taking into consideration the passage of time to make the players feel part of a living world — year after year, the intertwining of the Company's deeds and the events related in the stories and their chronologies creates a campaign with depth and texture."
                INCORPORATION "There are many ways to incorporate wider events into the Player-heroes' adventures. They could witness a great gathering, cross paths with groups involved in the timeline events or discuss the goings-on with the people they encounter on their Journey. Every Adventuring Phase can benefit greatly from making the Company's exploits part of the chronology of Middle-earth, provided that the focus of the narration remains firmly fixed on the Player-heroes' own deeds."
            }
        }
        WHERE {
            DESCRIPTION "Where is the action taking place? There are two answers to this question — either a precise location is vital to the action, and the Loremaster chooses a specific place from those described in this guide or in the source material, or the adventure requires nothing more than a generic setting and any ruin, forest glade or river will do."
            PROXIMITY "In either case, the Loremaster should consider a place that is either close to the current location of the Company, or one that they can reach conveniently (using the Journey rules). In the latter case, the trip itself gives the Loremaster the chance to set up a challenging situation for the Company."
            EXPLORING_MIDDLE_EARTH {
                DESCRIPTION "Every so often, their adventures will bring the Company to one of the places described in Tolkien's books. For many players, this is what roleplaying in Middle-earth is all about. Having the Company enter the Hall of Fire in Rivendell for the first time, or seeing the White Tower of Elostirion on the horizon, can turn an ordinary Adventuring Phase into a particularly meaningful experience."
                INTERACTION "When this happens, the Loremaster should allow the Company to interact with the setting. What players remember of a place they have read about should be brought to life and incorporated into the narrative. One way to achieve this is to challenge their Skills with some simple tests. For example, a Company crossing the Trollshaws in the east of Eriador and passing a roll of SCAN might locate the glade where three Stone-trolls stand, forever frozen in their stupor at having been tricked by a Wizard."
            }
        }
        WHAT {
            DESCRIPTION "What is going on? This question defines the heart of the Adventuring Phase, and summarises the information that a Loremaster presents to the players at the beginning of the first game session."
            STARTING_POINTS "Sometimes, this is summarised by a rumour that the Company has gathered during the last Fellowship Phase, but can otherwise be something tied to what happened in a previous Adventuring Phase — travellers talk of a strange luminescence they see while on the North Road; word of a stolen treasure and the reward offered to recover it reaches the inn at Bree; an important personality the Company was scheduled to meet is kidnapped or killed by an unknown threat. Any situation pointing the Player-heroes in the right direction on their path to adventure is a good starting point."
            DIRECT_CHALLENGE "Another way is to begin an Adventuring Phase with a direct challenge — something that provokes the Company into action right from the start. There's no need to plan a complete series of events, as the Company will provide enough material for the Loremaster to improvise upon as the game progresses."
            SIMPLICITY {
                DESCRIPTION "The objective of an Adventuring Phase doesn't have to be tied to an epic endeavour, or be about a world-threatening menace — at least, not every time. In The One Ring, an epic level of gameplay is reached by playing through many smaller events that reveal their greater significance only when woven together. In time, everything a Player-hero endures will be easily raised to a greater importance, especially when set against the game's overarching motif — the struggle against the Shadow."
                SUGGESTION "Simply picking a worthy opponent from the adversaries chapter, or an interesting location will provide the Loremaster and the Company with enough material to keep the game going for multiple sessions."
            }
            PLOT_TWISTS {
                DESCRIPTION "Once in a while the Loremaster might decide to complicate things by adding a twist or two to an otherwise straightforward Adventuring Phase. The Company will then have to figure out how to 'solve' a situation, instead of simply being asked to endure or overcome a series of difficulties."
                UNRESOLVED "In some cases, the Adventuring Phase might end without providing a clear answer; this opens up an opportunity to investigate the matter further during the Fellowship Phase which follows, or during a subsequent Adventuring Phase."
            }
        }
        WHY {
            DESCRIPTION "Why should the Player-heroes get involved in the current events in the first place? Is there something that interests them personally? This question directly addresses the reasons why the members of the Company choose to become adventurers — heroes brave dangers that other individuals try to stay clear of, usually because they have a personal stake that pushes them to do it."
            MOTIVATION "While the very concept of adventuring provides a simple answer to the question, the Loremaster should focus on those motivational 'buttons' which are far more effective in capturing the players' interest."
            EARLY_GAME "During the first few games, the Callings and Distinctive Features of the Player-heroes composing the Company can provide enough material to build upon."
            LATE_GAME "Once each member of the Company has a number of entries in their personal Tale of Years it will become much easier to find personal reasons for them to get involved in an Adventuring Phase. As the game progresses, the players themselves will start to explore their individual goals, and provide the Loremaster with personalised story hooks."
        }
        WHO {
            DESCRIPTION "Tolkien has populated his stories with a multitude of memorable characters, and the Loremaster will need to do the same for an adventure to be successful. Will one or more familiar personalities feature in the story? Will the adventure introduce a new recurring character? The personalities that the Loremaster controls are a fundamental element of any game, as much as any other feature of Middle-earth."
            ROLE_MODELS {
                DESCRIPTION "The deeds of a familiar character can be a powerful inspiration for a player looking for an example of what it means to live in Middle-earth. Meeting their favourite hero helps players to integrate into the epic tapestry of the campaign, adding as it does an additional layer of involvement in the events that the Company is witnessing."
            }
            SUPPORTING_CAST {
                DESCRIPTION "Loremaster characters should be used sparingly and with careful judgement. Players don't like to see their Player-heroes play second fiddle to a powerful individual. To avoid this, the Loremaster could try the opposite — have the famous character in need of the Player-heroes' help, or even need rescuing outright (a twist that Tolkien himself often utilised)."
            }
            PATRONS {
                DESCRIPTION "During play, the Company may adopt an important personality as their Patron. This provides an excellent source of story hooks and support, and is an easy way to make a familiar hero a recurring motif in the Company's adventuring. However, the Loremaster must make sure that a Patron is not simply reduced to a gameplay asset; instead they should be worked into the narrative as an active element."
            }
        }
        KEEPING_IT_THEMATIC {
            DESCRIPTION "A simple way to start out on the right foot with a The One Ring campaign is to pay tribute to the source material at the very beginning. This is a quick and easy way to establish the right atmosphere, showing players that they really are in Middle-earth now."
            METHOD "The Loremaster can propose rumours and story hooks that reference the stories directly in a way that the players will easily recognise. For example, they may choose a chapter title from either The Hobbit or The Lord of the Rings, and be a little creative with it, always trying to weave in a level of personal investment."
            EXAMPLES {
                ^"The Shadow of the Past" "The first meeting of the Company is observed by, or has been organised by, their main Patron. Otherwise, an old letter from a relative who disappeared a long time ago involves the Company in a larger scheme of events."
                ^"There and Back Again" "The Company uncovers a rumour about a long-lost place, item or treasure hoard that a renowned character from the stories tried to reclaim a long time ago and failed."
                ^"Over Hill and Under Hill" "The session starts with the Company already on a Journey, travelling to reach a place connected to one of the heroes."
                ^"A Knife in the Dark" "A safe place, such as the inn where the Company meets, turns dangerous as an agent of the Shadow attempts to murder one of the Player-heroes."
                ^"Riddles in the Dark" "The Company encounters a dark, ancient creature they heard about as a folk tale in their homelands."
            }
        }
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # ADVERSARY RULES — FORMAT OF PRESENTATION
    # ─────────────────────────────────────────────
    ADVERSARY_RULES {
        ATTRIBUTE_LEVEL {
            DESCRIPTION "This single value replaces the three Attributes used to describe Player-heroes and can be used to gauge the threat level posed by a single adversary of a type."
            COMBAT_USE "In combat, this numerical rating is applied as a modifier to several mechanics, like for example a number of Special Damage opportunities and Fell Abilities."
        }
        MIGHT_AND_ENDURANCE {
            ENDURANCE "Endurance measures the resistance of the adversary to the exhaustion of combat and harm."
            MIGHT "Might indicates the number of Wounds required to slay a foe outright, and the number of attacks it can take during a round of combat."
            ZERO_ENDURANCE "All adversaries are taken out of combat if their Endurance is reduced to zero."
            MULTIPLE_ATTACKS "Adversaries can make a number of attacks up to their Might score, targeting multiple foes in the same round, or the same opponent multiple times."
            NO_KNOCKBACK "Adversaries can never opt to be knocked back to reduce the severity of a loss of Endurance."
        }
        HATE_AND_RESOLVE {
            DESCRIPTION "Each Adversary description includes a numerical rating measuring their fighting drive and fuelling their special abilities — in game terms, Hate and Resolve serve a function that is similar to that of Hope for the Player-heroes."
            SPEND_FOR_BONUS "The Loremaster can reduce an adversary's Hate or Resolve score to make them gain (1d) on a die roll during combat (generally, attack or Protection rolls)."
            FELL_ABILITIES "Often, an expenditure of Hate or Resolve is required by several Fell Abilities."
            WEARY "A creature without Hate or Resolve is considered Weary."
            MAX_PER_ROUND "Each combat round, an adversary can spend a maximum of Hate/Resolve equal to their Might."
            HATE {
                DESCRIPTION "Adversaries with a Hate point rating are to be considered minions or servants of the Enemy. Their actions always aim at hurting or otherwise damaging the Player-heroes, desiring only to satisfy their Master's will. They may opt to flee if in a disadvantageous position, but will never yield or surrender, nor give quarter unless forced by circumstances or direct orders."
                NOTE "All minions of Sauron and all monstrous creatures have a Hate rating."
            }
            RESOLVE {
                DESCRIPTION "Adversaries that are given a Resolve score are not sworn enemies of the Free Folk, but may take up arms to oppose a Company of heroes as a consequence of their choice of allegiance, or due to unfortunate circumstances. Foes with a Resolve score lack the relentless motivation that drives the minions of the Dark Lord, and may surrender when outnumbered, or when casualties become excessive."
                NOTE "Evil Men and other non-monstrous adversaries often have a Resolve rating."
            }
            HATE_VS_RESOLVE {
                RULE "While fighting minions of the Enemy can hardly call the integrity of the Player-heroes into question, the act of attacking or killing an adversary with a Resolve rating should always be evaluated by the Loremaster as a possible Misdeed."
                EVALUATION "To ascertain this, Loremasters can ask themselves some simple questions: was the fight provoked by the Player-heroes or were they attacked? Was there another option to combat? Was killing necessary, or were the adversaries prone to surrender?"
            }
        }
        PARRY {
            RULE "An adversary's Parry rating is a numerical modifier that is added to the Strength TN of any Player-hero trying to hit the adversary in combat."
        }
        ARMOUR {
            RULE "An adversary's Armour rating works in the same way as a hero's — it is used by the Loremaster to make a Protection test when the adversary is hit by a Piercing Blow."
        }
        COMBAT_PROFICIENCIES {
            DESCRIPTION "Each adversary features a primary and a secondary Combat Proficiency, representing its main means of attack. Each listed attack form is followed first by its rating, then by its stats as Damage/Injury, and finally by the Special Damage opportunities available to that Adversary type."
        }
        ADVERSARY_SPECIAL_DAMAGE {
            DESCRIPTION "Similarly to what happens with the Player-heroes, if a successful attack roll made by an adversary produces one or more Success icons (Tengwar), the Loremaster can spend them to trigger special results."
            COST "All special results listed here require 1 Success icon to be triggered. Multiple results can be used to trigger different results, or the same one multiple times."
            HEAVY_BLOW_ALWAYS "All adversaries can always choose to trigger a Heavy Blow special damage result."
            BREAK_SHIELD {
                EFFECT "The attack strikes repeatedly at the shield of the targeted Player-hero, smashing it to pieces. The target loses their shield's bonus to Parry."
                EXCEPTION "A shield enhanced by Rewards or magical qualities cannot be smashed and thus is not affected."
            }
            HEAVY_BLOW {
                EFFECT "The attack inflicts an additional loss of Endurance equal to the Attribute Level of the attacker."
            }
            PIERCE {
                EFFECT "The attacker scores a well-aimed strike, modifying the Feat die result of the attack roll by +2."
            }
            SEIZE {
                EFFECT "The attacker holds on to the target — the victim can only fight in a Forward stance making Brawling attacks."
                ESCAPE "Seized heroes may free themselves spending a Tengwar icon from a successful attack roll."
            }
        }
        FELL_ABILITIES_RULES {
            DESCRIPTION "Most adversaries display an array of special talents, representing their innate powers and behavioural oddities."
            LAST_POINT "The Loremaster is entitled to make use of a Fell Ability even when it requires the expenditure of the last Hate or Resolve point possessed by the adversary."
            ADDITIONAL "Unless otherwise noted, an adversary may use a Fell Ability in addition to attacking, so long as they have the necessary points to spend."
        }
        OUT_OF_COMBAT {
            RULE "Once a victorious battle is over, the Player-heroes often must deal with the dead and dying. If the information is relevant, the Loremaster can consider that adversaries that were taken out of combat reducing them to zero Endurance could be still barely alive when a fight has ended, and might even survive if rescued."
        }
        FEAT_DIE_FOR_ADVERSARIES {
            DESCRIPTION "When the Loremaster is making a die roll to resolve an action attempted by a servant of the Shadow, it can be considered more appropriate to the theme to switch the meaning of the two special icons on the Feat Die."
            EYE_OF_SAURON "The Eye of Sauron icon becomes the highest result possible and yields an automatic success."
            GANDALF_RUNE "The Gandalf rune becomes the lowest result possible and is read as 0."
            PIERCING_BLOW "Most adversaries score a Piercing Blow on a roll of 10 or Eye of Sauron result on their Feat Die."
        }
        ADVERSARY_DISTINCTIVE_FEATURES {
            RULE "The Loremaster may give an additional level of depth to the description of adversaries by giving them one or two Distinctive Features, to be used following the rules for Loremaster Characters as Obstacles."
            # See LOREMASTER_CHARACTERS.AS_OBSTACLES in tor2e-2e-core-base.ttrpg
        }
    }
    # ─────────────────────────────────────────────
    # ADVERSARY INDEX
    # ─────────────────────────────────────────────
    # Individual stat blocks are in adversaries/ as .actor files.
    # Prefix "tor2e-2e-core-" denotes Core Rulebook adversaries.
    ADVERSARY_INDEX {
        ORCS {
            DESCRIPTION "Bred by the first Dark Power in the early years of the world to serve him in many wars, Orcs are once again multiplying. They are strong and agile creatures, quick and robust, and ready to learn or devise new methods or instruments of torment."
            SHARED_FELL_ABILITIES {
                HATRED "When targeting the object of their hate, all attacks are Favoured."
                HATE_SUNLIGHT "The creature loses 1 Hate for each round it is exposed to the full light of the sun."
            }
            GREAT_ORCS {
                DESCRIPTION "A powerful breed of Orc, Great Orcs are said to descend from servant spirits that once took an Orcish shape to serve the Dark Power's purposes. King Golfimbul, the Great Goblin, Azog and his son Bolg were Great Orcs."
                ACTORS ["tor2e-2e-core-great-orc-chief.actor", "tor2e-2e-core-great-orc-bodyguard.actor"]
            }
            ORCS_OF_THE_NORTH {
                DESCRIPTION "Among the most numerous of the malicious creatures serving the Shadow, the Orcs of the Mountains are used to living and making war in the deep places beneath the earth, where their sight is keener than any other Orc. When they are encountered in their mines, they are savage fighters and reckless in assault, but they leave the dark under the mountains only when marching to war or to avenge their fallen kind, as they suffer badly the light of the sun."
                ACTORS ["tor2e-2e-core-goblin-archer.actor", "tor2e-2e-core-orc-soldier.actor", "tor2e-2e-core-orc-guard.actor", "tor2e-2e-core-orc-chieftain.actor", "tor2e-2e-core-burzgul.actor"]
            }
        }
        EVIL_MEN {
            DESCRIPTION "Cruel individuals like brigands, marauders and slavers prowling the Lone-lands of Middle-earth fall within this category. Their malicious will notwithstanding, Evil Men are not servitors of Sauron, and they can end up opposing the Player-heroes for reasons not depending on an allegiance with the Dark Lord."
            HOSTILE_SOUTHERNERS {
                DESCRIPTION "The people of Bree call 'Southerner' every foreigner coming up the Greenway. The vast majority are simply moving away from some trouble, looking for lands where they can find some peace. Others are not so well-meaning..."
                ACTORS ["tor2e-2e-core-southerner-raider.actor", "tor2e-2e-core-southerner-champion.actor"]
            }
            RUFFIANS {
                DESCRIPTION "Local robbers, cut-throats, brigands and other assorted criminals fall within this category of potential adversaries. Such foes can be encountered on the lonely roads of Eriador, but they are as likely to be met in a dark alley in Bree."
                ACTORS ["tor2e-2e-core-footpad.actor", "tor2e-2e-core-ruffian-chief.actor", "tor2e-2e-core-highway-robber.actor"]
            }
        }
        TROLLS {
            DESCRIPTION "Trolls were created by the Great Enemy in the Elder Days — to fight in many bitter wars. They were made strong and powerful, and appear monstrous and misshapen, as if left unfinished by their cruel maker."
            SHARED_FELL_ABILITIES {
                HIDEOUS_TOUGHNESS "The creature is unaffected by unarmed attacks. Additionally, when an attack inflicts damage to the creature that would cause it to go to zero Endurance, it causes a Piercing Blow instead. Then, if the creature is still alive its Endurance score is set back at half its maximum rating."
                DULL_WITTED "Player-heroes can attempt a special combat task against the creature while in Forward stance. The acting player makes a RIDDLE roll as the main action for the round: on a success, the Troll loses 1 point of Hate, plus 1 point for each Success icon rolled."
            }
            CAVE_TROLLS {
                DESCRIPTION "Cave-trolls were created to fight and hunt deep under the earth. They have a dark skin with a greenish hue, covered with tight, robust scales, and appear shorter than other Trolls, as they are extremely hunched and often advance on all fours walking on their knuckles."
                ACTORS ["tor2e-2e-core-great-cave-troll.actor", "tor2e-2e-core-cave-troll-slinker.actor"]
            }
            STONE_TROLLS {
                DESCRIPTION "Stone-trolls are predators, living in small groups in filthy caves strewn with the remains of unwary travellers. They seem to be somewhat more intelligent than other Troll types, maybe thanks to their habit of prowling in the proximity of populated areas. A very ancient breed, Stone-trolls owe their name to the fact that they turn to stone if exposed to the light of the Sun."
                ACTORS ["tor2e-2e-core-stone-troll-robber.actor", "tor2e-2e-core-stone-troll-chief.actor"]
            }
        }
        UNDEAD {
            DESCRIPTION "Many horrors haunt the lonely lands of old Arnor, in the shadow of the darker woods and under the still waters of rotting marshes. Whatever is their true nature, all Undead creatures are hard to defeat and provoke a sentiment of horror in those who encounter them."
            SHARED_FELL_ABILITIES {
                DEATHLESS "Spend 1 Hate to cancel a Wound. When an attack inflicts damage to the creature that would cause it to go to zero Endurance, spend 1 Hate to bring the creatures back to full Endurance instead. This ability is ineffective against Player-heroes wielding a magical weapon enchanted with spells for the Bane of the Undead."
                HEARTLESS "The creature is not affected by the Intimidate Foe combat task, unless a Magical success is obtained."
                THING_OF_TERROR "At the start of the first round of the battle all Player-heroes in sight of one or more creatures with this ability gain 3 Shadow points (Dread). Those who fail their Shadow test are daunted and cannot spend Hope for the rest of the fight."
            }
            WIGHTS {
                DESCRIPTION "Wights are malevolent creatures inhabiting the cold flesh of the dead. They hunger for the life and warmth of those who are so unlucky to stumble into a region troubled by their presence. They strike from the cover of thick mists, or under the cloak of night, seeking to subdue their prey with their spells. They are hard to kill, and even if their body is destroyed, the spirit that animates them is unharmed, and flees to find some other barren place to haunt."
                ACTORS ["tor2e-2e-core-barrow-wight.actor", "tor2e-2e-core-wight-king.actor"]
            }
            WRAITHS {
                DESCRIPTION "It is said that many who fought in the wars against Angmar fell victim to the Black Shadow, a terrible illness spread by the Nazgul. Many did not perish, and were slowly consumed by it instead. Wraiths are creatures that once were living beings but whose lives were consumed by sorcery or by another evil power. They are now undead, and live in both the living world and the wraith-world."
                ACTORS ["tor2e-2e-core-fell-wraith.actor"]
            }
            MARSH_DWELLERS {
                ACTORS ["tor2e-2e-core-marsh-dwellers.actor"]
            }
        }
        WOLVES_OF_THE_WILD {
            DESCRIPTION "By the time of Bilbo's adventures, Wargs and Werewolves could be encountered at night in the eastern vales close to the Misty Mountains, where they prowl in search of prey. Years later, packs of Wolves have crossed the Hithaeglir, and can be found across Eriador."
            SHARED_FELL_ABILITIES {
                GREAT_LEAP "Spend 1 Hate to attack any Player-hero, in any combat stance, including Rearward."
            }
            WARGS {
                DESCRIPTION "Wargs are a particularly evil breed of Wolves, possessing wicked cunning and displaying malicious intent. They communicate using a dreadful language, foul to the ears of listeners not sharing their love for cruel and hateful deeds. Wargs generally look like lean and powerfully-built grey wolves, with eyes shining in the dark, but their size and appearance vary according to age and experience."
                ACTORS ["tor2e-2e-core-wild-wolf.actor", "tor2e-2e-core-wolf-chieftain.actor", "tor2e-2e-core-ash.actor"]
            }
            WEREWOLVES {
                DESCRIPTION "It is suspected by the most learned among the Wise that the cruelest packs of Wargs might be led by the foulest of creatures: trusted servants of the Dark Lord returned from the Ancient World to serve him once again. Devouring spirits trapped in wolf-form, they hate the very soil they walk upon, and desire only to defile and ruin in an attempt to quench the dreadful hunger that consumes their mortal bodies."
                ACTORS ["tor2e-2e-core-hound-of-sauron.actor"]
            }
        }
        NAMELESS_THINGS {
            DESCRIPTION "There are older and fouler things than Orcs in the deep places of the world. The darkest legends of the Dwarves whisper of ancient things living in the pools and lakes of remote dales, and lurking in dark tunnels dug before the Orcs came to the mountains. So little is known about these beings that no one ever gave them a name. They do not seem creations of the Great Enemy, Morgoth, for they are older than his lieutenant Sauron, and unknown to him. Their accursed breed might be akin to that of the monstrous Ungoliant, the mother of all Spiders, but they might be something else entirely. Whence they came no one can say — they are evil, but they do not heed the call of the Shadow. What is certain about all of them is that they are always a horrible sight to behold, and that they are very dangerous. They are not just simple beasts, but have a primitive intelligence, linked to their survival instinct, certainly, but often betraying some deeper drive or craving. They all hate the light, and thus live in the darkest recesses of the earth, or in the depths of lakes or underground rivers, which is the reason why no one has ever seen one of them in their entirety. If they come to the surface, they do it for a short time, enough to spread fear and despair, and then they return to their hidden lairs to rest undisturbed."
            IN_THE_ONE_RING {
                DESCRIPTION "Nameless Things can be introduced to the game by a Loremaster looking for a formidable adversary for their Company of heroes. Differently from most opponents presented in this volume, they do not really belong to a specific breed, and thus must be designed by the Loremaster personally, using the guidelines offered below. The result will be a unique creature, complete with a level of backstory, to underline the long years that the creature has spent troubling the unhappy world."
            }
            CHILDREN_OF_DARKNESS {
                DESCRIPTION "To create a Nameless Thing, the Loremaster must make a number of rolls on the tables presented in this section, using either a Feat die or a Success die, or by directly choosing the entries they see to be most fitting. The tables numbered from 1 to 5 are used to create the identity of the thing, and give it a story. Table 1 is used to determine how the Thing is referred to. Table 2 is used to generate its general description. Table 3 is used to determine what the Player-heroes notice moments before the Thing appears, and then what they see first. Table 4 is used to generate a rumour about the Thing. Table 5 is used to discover where the Thing is remembered. Tables 6 to 8 are instead used to determine the characteristics of the Nameless Thing in gaming terms. Table 6 determines all the usual stats required to use the Thing as an adversary, including the number of Fell Abilities it should possess. Table 7 is used to determine the forms of attack that the Thing employs. Table 8 lists all the Fell Abilities available to give the thing the powers it requires. Finally, all Nameless Things display tremendous resistance to damage but suffer badly under the light of the sun — they all possess the Hate Sunlight and Hideous Toughness Fell Abilities."
            }
            SHARED_FELL_ABILITIES {
                HATE_SUNLIGHT "The thing loses 1 Hate at the start of each round it is exposed to the full light of the sun."
                HIDEOUS_TOUGHNESS "The creature is unaffected by unarmed attacks. Additionally, when an attack inflicts damage to the creature that would cause it to go to zero Endurance, it causes a Piercing Blow instead. Then, if the creature is still alive its Endurance score is set back at half its maximum rating."
            }
            TABLE ^"1: The Thing is Referred to As..." {
                INSTRUCTION "Roll a Feat die once for the name. Roll a Success die once for each remaining column."
                FEAT_DIE ^"Name" {
                    EYE "The Bane"
                    1 "The Scourge"
                    2 "The Horror"
                    3 "The Terror"
                    4 "The Defiler"
                    5 "The Devourer"
                    6 "The Stalker"
                    7 "The Hunter"
                    8 "The Watcher"
                    9 "The Crawler"
                    10 "The Lurker"
                    GANDALF "The Flame"
                }
                SUCCESS_DIE ^"Location" {
                    1 "...in the Dark"
                    2 "...of the Abyss"
                    3 "...in the Deep"
                    4 "...of the Pit"
                    5 "...of Udûn"
                    6 "...in the Water"
                }
                SUCCESS_DIE ^"Association" {
                    1 "...by Men"
                    2 "...by Elves"
                    3 "...by Dwarves"
                    4 "...by Orcs"
                    5 "...by the Wise"
                    6 "...in ancient lore"
                }
            }
            TABLE ^"2: The Thing Can Be Described As..." {
                INSTRUCTION "Roll a Feat die once for the form, roll a Success die once for the additional feature."
                FEAT_DIE ^"Form" {
                    EYE "Bat-like"
                    1 "Spider-like"
                    2 "Fish-like"
                    3 "Slug-like"
                    4 "Worm-like"
                    5 "Centipede-like"
                    6 "Insect-like"
                    7 "Crustacean-like"
                    8 "Octopus-like"
                    9 "Man-like"
                    10 "Toad-like"
                    GANDALF "Troll-like"
                }
                SUCCESS_DIE ^"Feature" {
                    1 "...with remorseless eyes"
                    2 "...with great horns"
                    3 "...with luminous skin"
                    4 "...with a huge head"
                    5 "...with a swollen body"
                    6 "...yet greater"
                }
            }
            TABLE ^"3: When First Encountered..." {
                INSTRUCTION "Roll a Feat die once for each column."
                FEAT_DIE ^"Before You See It, You..." {
                    EYE "...notice a deadly silence"
                    1 "...hear a sinister hissing"
                    2 "...hear a low growl"
                    3 "...see the bones of its victims"
                    4 "...feel your skin crawl"
                    5 "...hear a deafening sound or scream"
                    6 "...notice its tracks"
                    7 "...hear a terrifying scream"
                    8 "...smell a hideous stench"
                    9 "...feel a violent gust of air"
                    10 "...hear a piping sound"
                    GANDALF "...feel a terrible cold"
                }
                FEAT_DIE ^"What You See First..." {
                    EYE "...is a great shadow, in the middle of which is a dark form"
                    1 "...are its great claws"
                    2 "...are its eyes, glowing in the dark"
                    3 "...is that its body is flaccid and translucent, as if composed of gelatinous material"
                    4 "...is its gaping mouth, opening and closing as if gasping for air"
                    5 "...is a large maw, with fangs eerily similar to human teeth"
                    6 "...is that swarms of insects or other vermin are crawling before it"
                    7 "...is a long, sinuous tentacle, slithering towards you"
                    8 "...are its huge fangs, so big and long that it cannot close its mouth"
                    9 "...are its wide, blind eyes"
                    10 "...are many twisted horns of stained ivory"
                    GANDALF "...is a vision of a beautiful creature, a phantom of the mind"
                }
            }
            TABLE ^"4: A Rumour About the Thing" {
                INSTRUCTION "Roll a Feat die once."
                FEAT_DIE {
                    EYE "When Sauron reoccupied Dol Guldur, he sought the allegiance of the many dark things living in Mirkwood. Some refused, and were imprisoned in the vast dungeons of the fortress. When the White Council attacked, one such creature was still kept there in chains, dying. Later, it managed to break free and vanish into the darkness, a sworn enemy of any living being."
                    1 "When Annúminas was young, the Men of Arnor disturbed something monstrous that had been sleeping on the bottom of Lake Evendim for millennia. One summer night, the thing lashed out in fury at several ships anchored near the harbour, dragging them into the depths, along with their crews. Then, it disappeared again. For a while."
                    2 "Forced long ago to serve Sauron, the thing fought at the battle of Dagorlad, spreading terror among the ranks of the Elves. Since no one had the courage to face it, Gil-galad himself had to intervene. Surprised by the steadfastness of the High King and the splendour of Aiglos, his great spear, the thing chose to retreat. With the defeat of its master, the thing regained its free will and fled across Middle-earth."
                    3 "After the Great Plague, the once wealthy Tharbad fell into decay, and its population diminished. One night, some among those who still lived in the city saw a large black shadow slowly approach the bridge, encompassing it. After a few moments, with a great roar, the bridge crumbled into a thousand pieces."
                    4 "Ohtar, Isildur's squire who was among the few to save himself from the ambush of the Orcs, escaped the disaster of the Gladden Fields, taking with him the sword of Elendil. Some say he was chased for a long time by a monstrous creature, which moved only at night. The thing seemed able to 'smell' his movements."
                    5 "Fornost didn't fall by normal means. The Witch-king of Angmar unleashed against the city a terrifying creature that owed the Wraith-king a debt of gratitude. It was this enemy of all light and life that disrupted the defenses and brought them down. The debt paid, it returned to the darkness from which it had been called."
                    6 "The Dwarves spoke of many horrors haunting the Grey Mountains. Emerging from who knows where, they crawled into the mines, killing and destroying. Eventually the Dwarves managed to drive them out, but one of them just wouldn't go away. It is said that it was Thorin I who defeated and drove it away, in a long duel that took place in the dark depths of the mine."
                    7 "For a long time, the thing dwelt in a deep cave in the northernmost foothills of the Misty Mountains. The Hillmen worshipped it as a god, feeding and caring for it. Then war came to those territories. Armies of Elves and Men drove out the Hillmen, and the thing was deprived of its followers, developing an irrepressible hatred against the invaders."
                    8 "Centuries ago, the thing dwelt in the darkest recesses of a valley on the east side of the Misty Mountains. One day, it came to a village of the Woodmen, when the hunters were away. When they returned, they were met by a gruesome scene: dismembered bodies, destroyed houses, a terrible smell that filled the air. No survivors."
                    9 "Once every certain number of years, the thing returns to the Mountains of Mirkwood. When it does, hundreds of Spiders, large and small, swarm as if crazed to the south or west, overwhelming whatever they encounter in their path."
                    10 "The thing is greedy. Not for treasure, but for bones. Animal ones are easy to get, and so are those of Orcs, Men, or Dwarves — this has made the thing hungry for the bones of Elves."
                    GANDALF "When Beleriand was broken, many creatures fled its ruin. Among them is a thing that is particularly large and cruel. Since that time, it has been moving east."
                }
            }
            TABLE ^"5: Where the Thing is Remembered" {
                INSTRUCTION "Roll a Feat die once."
                FEAT_DIE {
                    EYE "Orcs hate the evil things that crawl in the dark perhaps even more than Men, Elves, and Dwarves. For they are more often the ones who end up as food to feed them. Being able to talk to an Orc could prove very useful, if the thing is nearby."
                    1 "The Great Eagles see many things from above, but they don't speak of them unless they have a good reason. They do not tell, for example, of the monstrosity that after darkness haunted the banks of the Great River long ago, devouring lonely travellers. They spied it incessantly. One day, it was gone. The Eagles searched the surroundings for a long time, but to no avail."
                    2 "There is only one Elven song that tells of the mournings caused by the thing, but being immensely sad, it is seldom sung in the Hall of Fire of Rivendell. Some say that if it's nighttime and you fear the thing is nearby, singing the whole song will keep it from getting closer."
                    3 "A sentence carved onto the wall of a dark cave in the north near the Grey Waste, reads: 'Here Belegorn son of Bergil of Dol Amroth banished the thing from the Abyss but died of its foul wounds. Glorfindel of the Elves retrieved his body to return to his family'"
                    4 "Among the ancient scrolls and books preserved in Minas Tirith, there is a brief chronicle of the times when the city itself was built. Despite numerous missing pieces of text, it is clear that it concerns the presence of an evil thing under Mount Mindolluin, horrible to look upon and very aggressive."
                    5 "Few traces remain of the countless generations of Northmen who inhabited the southeastern edge of Mirkwood. Among them is a burial monument covered in soft moss. An inscription speaks of the death of Crinna, a village chief probably, caused by a terrible thing that came out of the woods at night and could only be kept at bay by lighting large fires."
                    6 "Since many Hobbits are afraid of the water, there is a common test of courage among the youth of the Eastfarthing that involves reciting a nursery rhyme while sitting on the shore of the Brandywine, at night. The rhyme, handed down since the dawn of time, speaks of a thing made of darkness, which comes out of the water and devours those who look at their reflection in the moonlight."
                    7 "The Rangers tell many tales of the horrible and mysterious things that prowl in Eriador. Most are made up, the Elves laughingly say, but one is definitely not. A creature that can suddenly appear at your side while you're sleeping. The Elves speak of it as well, but they are less concerned, since they never sleep..."
                    8 "Saruman loves secrets. And he is adept at keeping quiet about his well-stocked collection of texts concerning the presence of dark creatures roaming Middle-earth. He tried to classify them once, but soon desisted: too many, and too different from each other."
                    9 "The Seeing Stone on the tower of Elostirion, in the Emyn Beraid, constantly looks westwards, beyond the sea. Only on very few occasions does it turn its gaze elsewhere, when a creature as ancient and evil approaches the Grey Havens. It follows this hideous thing in all its movements, and only when it passes out of sight does the Stone return to look towards the immortal lands."
                    10 "In the private library of Elrond, in Rivendell, there is a parchment entirely dedicated to the creature, with many indications about its habits and the places where it might lurk."
                    GANDALF "Only the wisest of Middle-earth know anything about this dark creature as old as the earth. And they fear it. But by asking them directly, some good advice might be acquired. If you want to avoid it or flee from it of course, not on how to fight it, for no one would be so foolish..."
                }
            }
            TABLE ^"6: Characteristics" {
                INSTRUCTION "Roll a Feat die once to determine the stats of the Nameless Thing."
                NOTE "A Nameless Thing should be given a Parry modifier if the concept suits the description of a creature that can deftly avoid the attacks of its enemies (ranging from +1 to +3). If the thing is slow and bulky, no Parry modifier should be applied (and a negative modifier could be considered instead)."
                FEAT_DIE {
                    EYE
                    ATTRIBUTE_LEVEL_AND_HATE 12
                    ARMOUR "5d"
                    ENDURANCE 120
                    MIGHT 3
                    COMBAT_PROFICIENCY 4
                    FELL_ABILITIES 5 "1"
                    -2
                    ATTRIBUTE_LEVEL_AND_HATE 11
                    ARMOUR "4d"
                    ENDURANCE 110
                    MIGHT 3
                    COMBAT_PROFICIENCY 3
                    FELL_ABILITIES 4 "3"
                    -4
                    ATTRIBUTE_LEVEL_AND_HATE 10
                    ARMOUR "4d"
                    ENDURANCE 100
                    MIGHT 3
                    COMBAT_PROFICIENCY 3
                    FELL_ABILITIES 4 "5"
                    -6
                    ATTRIBUTE_LEVEL_AND_HATE 9
                    ARMOUR "3d"
                    ENDURANCE 90
                    MIGHT 2
                    COMBAT_PROFICIENCY 3
                    FELL_ABILITIES 3 "7"
                    -8
                    ATTRIBUTE_LEVEL_AND_HATE 8
                    ARMOUR "3d"
                    ENDURANCE 80
                    MIGHT 2
                    COMBAT_PROFICIENCY 3
                    FELL_ABILITIES 3 "9"
                    -10
                    ATTRIBUTE_LEVEL_AND_HATE 7
                    ARMOUR "3d"
                    ENDURANCE 70
                    MIGHT 2
                    COMBAT_PROFICIENCY 3
                    FELL_ABILITIES 2
                    GANDALF
                    ATTRIBUTE_LEVEL_AND_HATE 6
                    ARMOUR "2d"
                    ENDURANCE 60
                    MIGHT 2
                    COMBAT_PROFICIENCY 2
                    FELL_ABILITIES 2
                }
            }
            TABLE ^"7: Attack Forms" {
                INSTRUCTION "Roll a Success die twice to determine the primary and secondary attacks of the Nameless Thing."
                SUCCESS_DIE {
                    1
                    -2 ^"Crush"
                    EXAMPLES "hooves, paws"
                    DAMAGE "Attribute Level"
                    INJURY 12
                    SPECIAL "Break Shield"
                    3
                    -4 ^"Bite"
                    EXAMPLES "bite, beak"
                    DAMAGE "Attribute Level −2"
                    INJURY 14
                    SPECIAL "Pierce"
                    5
                    -6 ^"Rend"
                    EXAMPLES "fangs, claws"
                    DAMAGE "Attribute Level −2"
                    INJURY 16
                    SPECIAL "Seize"
                }
            }
            TABLE ^"8: Fell Abilities" {
                INSTRUCTION "Roll a Feat die once for each Fell Ability the Nameless Thing possesses, as determined by Table 6."
                FEAT_DIE {
                    EYE ^"Thing of Terror" {
                        DESCRIPTION "At the start of the first round of the battle all Player-heroes in sight of one or more creatures with this ability gain 3 Shadow points (Dread). Those who fail their Shadow test are daunted and cannot spend Hope for the rest of the fight."
                    }
                    1 ^"Deadly Wound" {
                        DESCRIPTION "Wounded targets make an Ill-favoured Feat die roll to determine the severity of the injury."
                    }
                    2 ^"Denizen of the Dark" {
                        DESCRIPTION "All rolls are Favoured while in darkness."
                    }
                    3 ^"Great Leap" {
                        DESCRIPTION "Spend 1 Hate to attack any Player-hero, in any combat stance, including Rearward."
                    }
                    4 ^"Horrible Strength" {
                        DESCRIPTION "If the creature hits and causes a Piercing Blow, spend 1 Hate to make the target's Protection roll Ill-favoured."
                    }
                    5 ^"Poison" {
                        DESCRIPTION "If an attack results in a Wound, the target is also poisoned."
                    }
                    6 ^"Heartless" {
                        DESCRIPTION "The creature is not affected by the Intimidate Foe combat task, unless a Magical success is obtained."
                    }
                    7 ^"Thick Hide" {
                        DESCRIPTION "Spend 1 Hate point to gain (2d) on a Protection roll."
                    }
                    8 ^"Strike Fear" {
                        DESCRIPTION "Spend 1 Hate to make all Player-heroes in sight gain a number of Shadow points (Dread) equal to the Might rating of the creature. Those who fail their Shadow test are daunted and cannot spend Hope for the rest of the fight."
                    }
                    9 ^"Snake-like Speed" {
                        DESCRIPTION "When targeted by an attack, spend 1 Hate to make the attack roll Ill-favoured."
                    }
                    10 ^"Foul Reek" {
                        DESCRIPTION "Spend 1 Hate point to cause all combatants engaged with the thing to lose (1d) on all rolls for the round."
                    }
                    GANDALF ^"Fear of Fire" {
                        DESCRIPTION "The thing loses 1 Hate at the start of each round it is engaged in close combat with an adversary wielding a torch or other sort of burning item."
                    }
                }
            }
        }
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # TREASURE RULES
    # ─────────────────────────────────────────────
    TREASURE_RULES {
        DESCRIPTION "Travelling across a land that has seen three Ages of the world, the adventurers are sooner or later bound to discover some form of treasure, and possibly claim it for themselves. Treasure provides the Company with a focus for their adventuring, a means for the Player-heroes to raise their personal prosperity, and another way to bring to light obscure tales from previous ages of Middle-earth."
        HOARDS {
            DESCRIPTION "Any source of Treasure points encountered by the Company when exploring caverns, lairs, and old ruins qualifies as a Hoard. Not all Hoards that Player-heroes can discover are equal though — they are ranked in three levels of increasing rarity: lesser, greater, and marvellous, based on how rich, old, or unspoilt they are."
            FREQUENCY "On average, the Company should find a maximum of two Hoards during the same Adventuring Phase — a lesser Hoard and a greater one; or, a single marvellous Hoard."
            VALUE "The value of a Hoard in Treasure points is determined by rolling from 1 to 3 Success dice, based on its type, and by multiplying the result by the number of Player-heroes in the Company."
            DIVISION "It is up to the members of the Company to divide the resulting value among themselves, splitting the Treasure rating as they see fit, and recording their share on their character sheets."
        }
        HOARD_TABLE {
            LESSER {
                EXAMPLES "Solitary Troll's loot, Goblin plunder, bandits' hoard"
                TREASURE_VALUE "Roll 1 Success die"
                MAGICAL_ROLLS "Roll the Feat die twice"
            }
            GREATER {
                EXAMPLES "Old hoard, Dwarf-hoard"
                TREASURE_VALUE "Roll 2 Success dice"
                MAGICAL_ROLLS "Roll the Feat die four times"
            }
            MARVELLOUS {
                EXAMPLES "Ancient hoard, Dwarven city's treasure trove, or Dragon-hoard"
                TREASURE_VALUE "Roll 3 Success dice"
                MAGICAL_ROLLS "Roll the Feat die six times"
            }
        }
        MAGICAL_TREASURE_ROLLS {
            DESCRIPTION "Once everyone in the Company has received their share of the treasure, it must be determined if anything possessing exceptional qualities lies buried among the silver and gold. To do this, the players or the Loremaster roll a Feat die a number of times, based on the type of Hoard discovered."
            DISCOVERY "Each Tengwar and Gandalf result corresponds to the discovery of a magical piece of treasure. To find out exactly what each piece is, the players must roll on the Magical Treasure table once."
            ALLOCATION "Once the number and nature of any Magical Treasure discovered has been determined, the Player-heroes must agree on who is going to keep each piece as their possession."
        }
        MAGICAL_TREASURE_TABLE {
            ^"1-3"
            {
                NATURE "Marvellous Artefact"
                DESCRIPTION "An enchanted object graced by a Blessing"
                EYE_RESULT "Gain 1 Shadow (Greed)"
            }
            ^"4-5"
            {
                NATURE "Wondrous Item"
                DESCRIPTION "An enchanted object possessing two Blessings"
                EYE_RESULT "Gain 2 Shadow (Greed)"
            }
            ^"6"
            {
                NATURE "Famous Weapon or Armour"
                DESCRIPTION "A weapon or suit of armour of superior make"
                EYE_RESULT "Gain 3 Shadow (Greed)"
            }
        }
        CARRYING_TREASURE {
            ENCUMBRANCE "Every single point of Treasure, individual Marvellous Artefact or Wondrous Item corresponds to one point of Load. Famous Weapons and Armour have their individual Load ratings, based on the corresponding pieces of War Gear."
            HIDING "If the Player-heroes are not willing to carry the amount of gold, silver, gems, or other valuables they have found while adventuring, the Player-heroes may opt to hide it close to where they found it, with the intention of returning to recover it later."
        }
        PRECIOUS_OBJECTS {
            DESCRIPTION "Precious Objects are gemstones, jewels, and other valuable ornaments whose main quality could be a particular significance as a family heirloom or antique, or an extraordinary and enchanting beauty, possibly due to a prodigious level of craftsmanship or a subtle virtue."
            VALUE "The value of a Precious Object in Treasure points is the amount that the Loremaster assigns to it, out of the rating generated for the Hoard discovered by the Company, but its inclusion in the game might serve a different purpose."
            SENTIMENTAL_VALUE "Should a Player-hero make a gift or otherwise offer such an item to members of a folk whose tradition hearkens back to the time when the item was crafted, they would receive a bonus amount for sentimental value in return."
            DISCOVERY "The capabilities of an object may not be readily apparent upon discovery. A Player-hero may learn about an item's Blessings by choosing the Meet Patron Fellowship Phase undertaking."
        }
        PRECIOUS_OBJECTS_TABLES {
            DESCRIPTION "Roll a Success die for each table and check the result."
            FORM {
                ^"1" "Jewel (single gem)"
                ^"2" "Brooch"
                ^"3" "Necklace"
                ^"4" "Circlet or crown"
                ^"5" "Belt, chain, or armband"
                ^"6" "Ring"
            }
            MAIN_MATERIAL {
                ^"1" "Pearl"
                ^"2" "Sapphire"
                ^"3" "Ruby"
                ^"4" "Amethyst (pink to purple)"
                ^"5" "Roll again: 1-2 Adamant (diamond); 3-4 'white gem'; 5-6 clear crystal"
                ^"6" "Roll again: 1-2 Emerald; 3-4 'green gem'; 5-6 green crystal"
            }
            CRAFTSMANSHIP {
                ^"1" "Mannish, Westernesse"
                ^"2" "Elven, Eregion"
                ^"3" "Dwarven, Khazad-dûm"
                ^"4" "Dwarven, Erebor"
                ^"5" "Dwarven, Beleriand (Nogrod or Belegost)"
                ^"6" "Elven, Beleriand"
            }
        }
        MARVELLOUS_ARTEFACTS_AND_WONDROUS_ITEMS {
            DESCRIPTION "Objects included in this category possess characteristics that mortals wouldn't hesitate to call magical: cloaks that hide their wearers from observing eyes, war-horns capable of setting fear in the hearts of enemies and joy in the hearts of friends, staves blessed with virtues of finding and returning."
            BLESSINGS "Such objects are wound about with powerful enchantments called Blessings. An object possessing one Blessing is called a Marvellous Artefact, while one possessing two Blessings is a Wondrous Item. A single Blessing bestowed upon an object lets its bearer affect the result of all rolls made using a specific Skill."
            EFFECT "The bearer of a Marvellous Artefact or Wondrous Item gains (2d) when making rolls using the Skill corresponding to its Blessing, and allows the Player-hero to achieve a magical success."
            CREATION "When a blessed item is found, the Loremaster either chooses an object included in the Treasure Index, or uses the Blessings tables to create one."
            RARITY "Marvellous Artefacts and Wondrous Items should be rare and unique, lest their worth be diminished in the eyes of the players. The Loremaster should create a limited number of such objects for inclusion in a Treasure Index — two or three per Player-hero at most. Should that list run out, the Loremaster may create additional ones, either taking the time to design them or rolling them up on the spot."
        }
        BLESSINGS_TABLES {
            DESCRIPTION "To determine which skill is affected by a Blessing the Loremaster rolls a Success die twice: the first roll selects the Skill group, the second roll identifies the affected Skill. The procedure must be repeated if the object is a Wondrous Item bestowed with two Blessings."
            OBJECT_TYPES "In brackets are listed options to help the Loremaster in choosing the type of object discovered. If the same item possesses two Blessings, choose the type of object that seems more appropriate."
            ^"1"
            PERSONALITY {
                ^"1-2"
                AWE OBJECTS ["ring", "cloak", "circlet", "collar", "belt", "weapon sheath", "staff", "war-horn"]
                ^"3-4"
                ENHEARTEN OBJECTS ["ring", "cloak", "weapon sheath", "staff", "war-horn"]
                ^"5-6"
                PERSUADE OBJECTS ["ring", "cloak", "circlet", "collar"]
            }
            ^"2"
            MOVEMENT {
                ^"1-2"
                ATHLETICS OBJECTS ["rope", "boots", "shoes"]
                ^"3-4"
                TRAVEL OBJECTS ["staff", "belt", "boots"]
                ^"5-6"
                STEALTH OBJECTS ["ring", "cloak", "shoes"]
            }
            ^"3"
            PERCEPTION {
                ^"1-2"
                AWARENESS OBJECTS ["ring", "circlet", "collar"]
                ^"3-4"
                INSIGHT OBJECTS ["ring", "circlet", "collar"]
                ^"5-6"
                SCAN OBJECTS ["ring", "circlet", "staff"]
            }
            ^"4"
            SURVIVAL {
                ^"1-2"
                HUNTING OBJECTS ["belt", "hunting horn", "staff"]
                ^"3-4"
                HEALING OBJECTS ["unusual, as potions and salves quickly lose their virtue"]
                ^"5-6"
                EXPLORE OBJECTS ["boots", "staff", "coil of rope"]
            }
            ^"5"
            CUSTOM {
                ^"1-2"
                COURTESY OBJECTS ["ring", "circlet", "pair of studs"]
                ^"3-4"
                SONG OBJECTS ["ring", "musical instrument"]
                ^"5-6"
                RIDDLE OBJECTS ["ring"]
            }
            ^"6"
            VOCATION {
                ^"1-2"
                CRAFT OBJECTS ["ring", "crafting tool"]
                ^"3-4"
                BATTLE OBJECTS ["crown", "ring", "staff", "war-horn"]
                # Battle is rare, as it usually pertains to weapons
                ^"5-6"
                LORE OBJECTS ["mirror", "book", "seeing-stone"]
            }
        }
        TREASURE_INDEX {
            DESCRIPTION "A Treasure Index is a list detailing all the magical items that can become part of the campaign. When something is uncovered with a Magical Treasure roll, the Loremaster refers to the Treasure Index to check exactly what has been brought to light."
            PURPOSE "Using the index allows the Loremaster to keep a tight control over the desired level of magic to introduce into the game, avoiding the problem of having too many heroes wandering around Middle-earth wielding Beleriand-forged blades or wearing Mithril armour."
            TIMING "The index lets the Loremaster 'time' the appearance of certain magical items in the campaign — for example, to follow a wide-arcing plot involving the discovery of a particular object."
            UNIQUENESS "The index helps in keeping magical objects unique and wondrous. Finding a magical item should represent a major turning point in a campaign, with definite consequences on the future of a hero."
            COMPILING {
                ARTEFACTS "The Loremaster includes as many Marvellous Artefacts as desired."
                WONDROUS_AND_FAMOUS "A specific list must be made to indicate precisely the number and nature of any Wondrous Items and Famous Weapons and Armour that the Player-heroes will have a chance to find (ideally, 1 to 3 Wondrous Items and 1 to 3 pieces of war gear for each Player-hero in the Company)."
            }
            FATE_AND_PREDESTINATION {
                RULE "Magical Treasure is meant to be strictly individual: heroes should never pass the object found over to a different companion, especially when Famous Weapons and Armour are concerned."
            }
        }
        FAMOUS_WEAPONS_AND_ARMOUR {
            DESCRIPTION "Weapons of extraordinary craftsmanship are already dealt with in the game using the rules for Rewards. While those items could arguably be considered magical, their lineage can hardly be compared with that of swords forged in Gondolin for the Goblin-wars."
            SELECTION "When a Player-hero gains possession of such an extraordinary weapon, the Loremaster must consult the campaign's Treasure Index — if the circumstances are appropriate, the Loremaster may select an item from those added to the Index specifically for the Player-hero."
            DESIGNING {
                DESCRIPTION "To design a magical sword or a wondrous coat of armour for insertion into the Treasure Index, the Loremaster must follow a 5-step process."
                STEP_1_ITEM_TYPE {
                    RULE "Choose what piece of war gear is the object of the design. A Treasure Index must only include items that are designed explicitly for specific members of the Company."
                }
                STEP_2_CRAFTSMANSHIP {
                    DESCRIPTION "Weapons and armour can be of Elven, Dwarven, or Númenórean craftsmanship. The choice determines whether a weapon should feature Banes, and affects the choice of Qualities."
                    ELVEN "The Elves forged many famous long swords, daggers, and enchanted spears. Other weapons or pieces of defensive war gear are not unknown, but more difficult to find."
                    DWARVEN "The smiths of Nogrod and Belegost crafted especially swords and axes, shields, helms, and suits of armour."
                    NUMENOREAN "The Men of Westernesse excelled in the making of many weapons, but rarely devoted themselves to the creation of suits of armour, recognising the greater ability of Dwarf-smiths."
                }
                STEP_3_BANES {
                    DESCRIPTION "Bane weapons describe instruments of war that have been wrought to defeat a specific enemy. If the magical item is of Elven or Númenórean craftsmanship, then it may be attributed with one or more Banes."
                    NUMENOREAN "Choose two types from: Orcs, Trolls, Wolves, Evil Men, Undead."
                    ELVEN "Choose one type from: Orcs, Wolves, or Spiders."
                    ANCIENT "Particularly ancient and rare, some blades may have been wrought for the bane of the Enemy itself, and as such may be particularly dangerous to all his servants and minions."
                }
                STEP_4_QUALITIES {
                    RULE "Upon creation, a number of qualities must be attributed to the magical item, choosing among the Rewards and the Enchanted Rewards."
                    MAXIMUM "A famous weapon or piece of defensive gear should feature a maximum of 3 qualities, and must include a minimum of one Enchanted Reward."
                    ORDERING "All qualities of an item can be recorded on the Magical Treasure Index in any order desired, keeping in mind that the qualities that are listed first are the ones that the owner will discover soonest."
                    NOTE "The first six Enchanted Rewards are enhanced versions of those on the Rewards list — qualities sharing a common descriptor cannot be attributed to the same item."
                    BANE_NOTE "When designing an Elven or Númenórean weapon, the Loremaster should be sure to bestow upon it at least one Enchanted Reward that possesses the Bane requirement."
                }
                STEP_5_NAME {
                    RULE "All pieces of war gear included in a Treasure Index should be given an appropriate name, along with a set of historical notes. The name of an item can be revealed to its bearer who researches it or asks a lore-master about it via the Meet Patron Fellowship Phase undertaking."
                    PLAYER_NAMING "A player is free to name an item themselves much as Bilbo did with Sting — either because the object does not have a known name or the companion is not interested in discovering it."
                }
            }
            HOW_THEY_WORK {
                INITIAL "When a companion first uses a Famous Weapon or Armour, the item displays only the characteristics of the first quality listed in its entry in the Loremaster's Treasure Index."
                DORMANT "The remaining features are secret and considered to be 'dormant'. They may be unlocked in the order that they have been listed on the Treasure Index in one of two ways."
                GAINING_VALOUR {
                    RULE "Each time that the Player-heroes are entitled to gain a new Reward as the consequence of gaining a new rank in VALOUR, they may choose instead to activate one quality of a Famous Weapon or Armour that belongs to them."
                }
                VISITING_THE_TREASURY {
                    DESCRIPTION "When Player-heroes gain possession of a Famous Weapon or Armour, they can return home as a Fellowship Phase undertaking to leave a piece of war gear enhanced by one or more Rewards as a gift to their folk."
                    EFFECT "Upon their visit to the treasury of their folk, Player-heroes trade the number of Rewards possessed by the piece of war gear given as a gift with the activation of an equal number of qualities on a Famous Weapon or Armour."
                }
            }
            BANE_WEAPONS {
                RULE "In addition to being possibly more effective against the types of creatures they were crafted to defeat, Bane weapons are destructive to elements connected to the creatures that are the object of the Bane, and would immediately be recognised as such by them."
            }
        }
        ENCHANTED_REWARDS {
            DESCRIPTION "All the qualities described here set the craftsmanship of an item apart from any other. The extraordinary characteristics of the object may be the result of ancient spells or graven runes, or they may be due to the innate qualities of the materials used for its crafting."
            LIMITS "Loremasters must keep in mind that they may apply a maximum of 3 Rewards (Enchanted or ordinary) to a Famous Weapon or Armour, always including a minimum of 1 Enchanted Reward. All Enchanted Rewards are unique, meaning that they can only be applied once to the same item."
            ANCIENT_CLOSE_FITTING {
                CRAFTSMANSHIP ["Elven", "Dwarven"]
                ITEM ["Armour", "Helm"]
                EFFECT "When you make a PROTECTION roll while wearing a piece of armour or helm with this quality you add 3 to the result, or a bonus equal to your VALOUR rating, whichever is higher."
            }
            ANCIENT_CUNNING_MAKE {
                CRAFTSMANSHIP ["Elven", "Dwarven"]
                ITEM ["Armour", "Helm", "Shield"]
                EFFECT "This quality lowers the Load rating of an item by 3 points, or by your VALOUR rating, whichever is higher (to a minimum of 0 Load)."
            }
            SUPERIOR_FELL {
                CRAFTSMANSHIP ["Elven", "Númenórean"]
                ITEM ["Any weapon"]
                SPECIAL "Bane (if Númenórean)"
                EFFECT "If the weapon is of Elven Craftsmanship, add 4 to its Injury rating. If the weapon is of Númenórean craftsmanship, add 2 to its Injury rating, or a bonus equal to the bearer's VALOUR (whichever is higher) if used against a Bane creature."
            }
            SUPERIOR_GRIEVOUS {
                CRAFTSMANSHIP ["Dwarven", "Númenórean"]
                ITEM ["Any weapon"]
                SPECIAL "Bane (if Númenórean)"
                EFFECT "If the weapon is of Dwarven craftsmanship, add 2 to its Damage rating. If the weapon is of Númenórean craftsmanship, add 1 to its Damage rating, or a bonus equal to the bearer's VALOUR if used against a Bane creature."
            }
            SUPERIOR_KEEN {
                CRAFTSMANSHIP ["Dwarven", "Elven"]
                ITEM ["Any weapon"]
                SPECIAL "Bane (if Elven)"
                EFFECT "If the weapon is of Dwarven craftsmanship, it scores a Piercing Blow on a result of 8+. If the weapon is of Elven craftsmanship, it scores a Piercing Blow on a result of 9+, or on a result of 10 minus a value equal to the bearer's VALOUR if used against a Bane creature."
            }
            SUPERIOR_REINFORCED {
                CRAFTSMANSHIP ["Any"]
                ITEM ["Shield"]
                SPECIAL "Bane (if Elven or Númenórean)"
                EFFECT "This quality adds 2 to a shield's Parry bonus. If the shield is of Númenórean or Elven craftsmanship, add 1 to its Parry bonus, or a bonus equal to the bearer's VALOUR when fighting against a Bane creature."
            }
            BITING_DART {
                CRAFTSMANSHIP ["Elven"]
                ITEM ["Ranged weapon"]
                SPECIAL "Bane"
                EFFECT "When you hit your target using a weapon with this quality you also inflict a loss of 1 point of Hate or Resolve, or 3 points if it is a Bane creature."
            }
            CLEAVING {
                CRAFTSMANSHIP ["Any"]
                ITEM ["Close combat weapon"]
                EFFECT "When you kill a foe with a weapon blessed by this quality, you can immediately attack a second adversary engaged with you."
            }
            FLAME_OF_HOPE {
                CRAFTSMANSHIP ["Dwarven"]
                ITEM ["Close combat weapon"]
                EFFECT "When you hit your target with a weapon blessed by this quality, all members of the Company (you included) recover 1 point of Endurance, plus 1 for each Success icon rolled."
            }
            FOE_SLAYING {
                CRAFTSMANSHIP ["Elven", "Númenórean"]
                ITEM ["Any weapon"]
                SPECIAL "Bane"
                EFFECT "When you score a Piercing Blow on a Bane creature, the PROTECTION roll of the target is Ill-favoured. If the roll was already Ill-favoured for any reason, then the Piercing Blow scores an automatic Wound instead."
            }
            GLEAM_OF_TERROR {
                CRAFTSMANSHIP ["Dwarven"]
                ITEM ["Close combat weapon"]
                EFFECT "When you hit your target using a weapon with this quality you also inflict a loss of 2 points of Hate or Resolve."
            }
            HAMMERING {
                CRAFTSMANSHIP ["Any"]
                ITEM ["Close combat weapon"]
                EFFECT "A creature hit by this weapon and suffering an Endurance loss equal or superior to twice its Attribute level is additionally knocked back and must spend its next main action to stand up."
            }
            HOLLOW_STEEL {
                CRAFTSMANSHIP ["Númenórean"]
                ITEM ["Bows"]
                SPECIAL "No Bane required"
                EFFECT "You are always allowed to make one additional opening volley, even when no opening volleys are allowed (unless you are surprised)."
            }
            LUMINESCENCE {
                CRAFTSMANSHIP ["Elven"]
                ITEM ["Close combat weapon"]
                SPECIAL "Bane"
                EFFECT "This quality makes the weapon's blade shine with a pale, cold light when a Bane creature is nearby. You and all members of the Company succeed automatically on all rolls made to avoid being ambushed by such creatures."
            }
            MITHRIL_ARMOUR {
                CRAFTSMANSHIP ["Dwarven"]
                ITEM ["Mail Armour"]
                EFFECT "A mail shirt and a coat of mail made of Mithril have a Load rating of 3 and 6, respectively."
            }
            RUNE_SCORED_ARMOUR {
                CRAFTSMANSHIP ["Dwarven"]
                ITEM ["Armour"]
                EFFECT "When you make a PROTECTION test while wearing a Rune-scored Armour, you ignore the effects of being Miserable or Weary."
            }
            RUNE_SCORED_HELM {
                CRAFTSMANSHIP ["Dwarven"]
                ITEM ["Helm"]
                EFFECT "When you make a Skill roll attempting any Combat Task while wearing a Rune-scored Helm, you ignore the effects of being Miserable or Weary."
            }
            RUNE_SCORED_SHIELD {
                CRAFTSMANSHIP ["Dwarven"]
                ITEM ["Shield"]
                EFFECT "When you are fighting with a Rune-scored Shield, attack rolls targeting you are made as if the adversary was Weary."
            }
            RUNE_SCORED_WEAPON {
                CRAFTSMANSHIP ["Dwarven", "Elven"]
                ITEM ["Any weapon"]
                EFFECT "When you make an attack roll using a weapon possessing this quality, you ignore the effects of being Miserable or Weary."
            }
            STRAIGHT_FLIGHT {
                CRAFTSMANSHIP ["Any"]
                ITEM ["Ranged weapon"]
                EFFECT "The bearer of such a weapon always enjoys a clean shot, even when they are shooting against a strong wind, or their target is protected by darkness, or other elements that would modify their Attack roll negatively (the attacker ignores any modifiers due to complications)."
            }
        }
        CURSED_ITEMS {
            DESCRIPTION "Items that have been buried in darkness for centuries represent a potential threat to adventurers and their lust for power. Sometimes, a treasure has been left to rot long enough for the Shadow to have wound about it an even darker fate."
            APPLICABILITY "If a Player-hero uncovered a piece of Magical Treasure, be it a Marvellous Artefact, a Wondrous Item, or a Famous Weapon and Armour, the Loremaster may additionally take the chance to introduce a Curse."
            NATURE "A cursed item does not differ from an unmarred one in its virtues. The Loremaster simply proceeds to design the Curse that is laid upon it, either by choosing a Curse designed previously for the campaign, or by creating one on the spot."
            NOTE "A cursed item is not an evil artefact, or a device created by the Enemy or meant to condemn a companion to a life of misery. It is a wonderful object bearing a lasting trace of darkness. While it may make a hero's life more dangerous for a while, the introduction of a cursed item is primarily meant to make the game more exciting."
            REMOVAL "Once a Curse has been removed, the item reverts to being a regular magical item."
            HOW_TO_DESIGN_A_CURSE {
                DESCRIPTION "A Curse bestows an item with an additional feature, similar to a Blessing or a Reward, except that it has a detrimental effect rather than a positive one. The Loremaster may consult the list of sample Curses to select the most appropriate one, or to use them as inspiration to design new ones."
                TRIGGER "A Curse may not be initially apparent, but instead be activated by a specific circumstance. Examples of circumstances that might trigger a Curse include: leaving the area where the cursed item was found; exposing the object to the light of the moon; at the first shedding of blood; in the presence of a specific type of creature; upon entering a dark land."
                LIFTING "When creating a cursed item, the Loremaster must also secretly decide how its Curse can be lifted. This should be no small task and should definitely form the focus of an Adventuring phase in its own right. For example, a Curse might only be lifted at the place of the item's forging, or by the light of the same moon by which it was made. It might require the casting of an ancient spell lost to the ages or by the slaying of a particularly dangerous creature."
            }
            CURSE_OF_WEAKNESS {
                EFFECT "The Cursed Player-hero displays the worst Flaw connected to their own Shadow Path."
                FLAWS {
                    COWARDLY "(Wandering-madness). When the curse takes hold of the bearer, all they can think of is turning tail and fleeing into the night."
                    FEARFUL "(Path of Despair). The curse undermines the spirit of the bearer, casting a shadow of fear and doubt over every action and decision."
                    MURDEROUS "(Curse of Vengeance). A terrible thirst for blood and malevolence lies within the item, provoking the bearer to dark thoughts of violence and murder."
                    THIEVING "(Dragon-sickness). The item glitters with a sickly light that causes the bearer to desire more and more."
                    TYRANNICAL "(Lure of Power). The item foments a sense of overconfidence and arrogance within the bearer, causing them to belittle and undermine their companions."
                    TRAITOROUS "(Lure of Secrets). The item fosters thoughts of paranoia and discord within the mind of its bearer, causing them to mistake their friends for foes."
                }
                NOTE "This Flaw is considered temporary, and does not count for the purposes of Succumbing to the Shadow."
            }
            DARKEN {
                EFFECT "When the item is revealed (a sword is unsheathed, a glove is removed to reveal a ring and so on) all shadows in the area seem to deepen, and all sources of light seem to grow weak. The phenomenon is particularly serious for the bearer of the item, who finds their sight seriously impaired. Since no source of light is able to dispel this darkness, bystanders are confused and disoriented. This causes all appropriate rolls made by the bearer to lose (1d)."
            }
            HUNTED {
                EFFECT "The presence of the item does not go unnoticed, and one type of enemy (Orcs, Evil Men, the Enemy) perceive it when they come near it. In addition, journey events experienced by a travelling Company may be made to revolve around this hunt."
            }
            ILL_LUCK {
                EFFECT "Bad luck dogs the bearer at every turn, their victories turned to defeats by simple — but persistent — misfortune. A roll of an Eye on the Feat die obtained on any roll means an automatic failure for the bearer (as if the Player-hero was Miserable)."
            }
            ILL_OMEN {
                EFFECT "The bearer's arrival is preceded by dark warnings and fell omens, filling the hearts of former allies with dread and fear. This causes all rolls made by the bearer during a Council to lose (1d)."
            }
            MALICE {
                EFFECT "The object does not love its bearer, and will try to cause them harm, or otherwise trouble them. If a roll concerns the item (as in the case of a Skill roll augmented by a Blessing, an attack roll for a weapon, a PROTECTION roll for armour), the companion is prevented from spending Hope to gain bonus dice."
            }
            OWNED {
                EFFECT "The item is owned or was created by another creature, much as the Ring was owned by Sauron. The item may have found its way into the hands of the Player-hero so it might eventually return to its master. The Loremaster should decide upon a specific enemy to be the owner of the item, possibly choosing a recurring villain in the campaign. When in the presence of its owner, the item becomes useless: its special features turn out to be completely ineffective."
            }
            SHADOW_TAINT {
                EFFECT "The item bears a greater shadow-stain upon it than most cursed items. As long as the hero carries the item, their Shadow score is augmented: by 1 point for an artefact with one Blessing, 2 for one with 2 Blessings; in the case of a Famous Weapon or Armour, the Shadow increase is equal to twice the number of Enchanted Rewards on the item. This Shadow increase cannot be removed or healed, and will raise the hero's Shadow score until the Curse is lifted."
            }
            WEAKENING {
                EFFECT "The item's Curse worms away at its bearer, bringing with it a terrible weakness. The Loremaster chooses either STRENGTH, HEART, or WITS. The bearer sees the associated Attribute TN raised by 2 points."
            }
            CURSED_PRECIOUS_OBJECTS {
                RULE "Generally, only Magical Treasure can be cursed, but if the Loremaster wishes, it is of course possible to lay a curse upon a heap of gold or a chest of precious gems, but usually that type of treasure just has an ill feeling about it and a character may struggle to sell it. A cursed Precious Object might be denied any sentimental value."
            }
        }
    }
    # ─────────────────────────────────────────────
    # TREASURE TYPE DEFINITIONS
    # ─────────────────────────────────────────────
    ^"MarvellousArtefact" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Blessing" STRING REQUIRED
            ^"Blessing Skill" STRING REQUIRED
            ^"Source" STRING
        }
    }
    ^"WondrousItem" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Blessings" LIST REQUIRED
            ^"Source" STRING
        }
    }
    ^"FamousWeapon" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Weapon Type" STRING REQUIRED
            ^"Original Bearer" STRING
            ^"Craftsmanship" ENUM ["Elven", "Dwarven", "Númenórean", "Mannish"] REQUIRED
            ^"Banes" LIST
            ^"Qualities" LIST
            ^"Description" STRING
            ^"Source" STRING
        }
    }
    ^"FamousArmour" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Armour Type" STRING REQUIRED
            ^"Original Bearer" STRING
            ^"Craftsmanship" ENUM ["Elven", "Dwarven", "Númenórean", "Mannish"] REQUIRED
            ^"Qualities" LIST
            ^"Description" STRING
            ^"Source" STRING
        }
    }
    # ─────────────────────────────────────────────
    # EREBOR CAMPAIGN TREASURES
    # ─────────────────────────────────────────────
    # MARVELLOUS ARTEFACTS
    ^"The Diamond Studs of Old Took" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "The Diamond Studs of Old Took" FIXED
            ^"Description" STRING "A pair of flawless diamond studs said to have belonged to the Old Took of the Shire himself. Worn, they lend an air of quiet authority and ancient grace." FIXED
            ^"Blessing Skill" STRING "Courtesy" FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"Golden Harp" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "Golden Harp" FIXED
            ^"Description" STRING "A magical golden harp with silver strings that never goes out of tune. Its music carries a peculiar power to move the hearts of listeners." FIXED
            ^"Blessing Skill" STRING "Song" FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"White Belt of the Princeling" DEF {
        EXTENDS ^"MarvellousArtefact"
        PROPERTIES {
            ^"Name" STRING "White Belt of the Princeling" FIXED
            ^"Description" STRING "A belt of pearls and polished crystals crafted to ease movement; the wearer feels as if walking through water parted before them." FIXED
            ^"Blessing Skill" STRING "Athletics" FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    # WONDROUS ITEMS
    ^"The Arkenstone of Thrain" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "The Arkenstone of Thrain" FIXED
            ^"Description" STRING "The Heart of the Mountain — a great white gem of a thousand facets, found at the roots of the mountain by Thrain I. It shines with its own inner light. Kings have died for it; wars have been fought over it. Its beauty is a kind of accusation." FIXED
            ^"Blessings" LIST ["Awe", "Persuade"] FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"The Great Golden Cup of Thror" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "The Great Golden Cup of Thror" FIXED
            ^"Description" STRING "A great two-handed cup of gold, carved with birds and flowers in the fashion of ancient Dwarven craftwork. Wine drunk from it shows the essence of things — what is hidden becomes visible to the drinker's inner eye." FIXED
            ^"Blessings" LIST ["Insight", "Riddle"] FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"The Royal Panoply of Erebor" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "The Royal Panoply of Erebor" FIXED
            ^"Description" STRING "The ceremonial regalia of Erebor's line: a gold-plated ring coat and a silver-hafted axe with a scarlet gemstone set in the grip. When worn together in the presence of Dwarves, the bearer commands instant respect." FIXED
            ^"Blessings" LIST ["Battle", "Enhearten"] FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    # FAMOUS WEAPONS
    ^"Orcrist" DEF {
        EXTENDS ^"FamousWeapon"
        PROPERTIES {
            ^"Name" STRING "Orcrist" FIXED
            ^"Weapon Type" STRING "Sword" FIXED
            ^"Original Bearer" STRING "Thorin Oakenshield" FIXED
            ^"Craftsmanship" STRING "Elven" FIXED
            ^"Banes" LIST ["Orcs"] FIXED
            ^"Qualities" LIST ["Luminescence", "Keen"] FIXED
            ^"Description" STRING "A sword of ancient Gondolin make with a jewelled hilt, called Goblin-cleaver in the Common Tongue and Biter by goblins with good reason. It glows with cold blue light in the presence of Orcs." FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"Sting" DEF {
        EXTENDS ^"FamousWeapon"
        PROPERTIES {
            ^"Name" STRING "Sting" FIXED
            ^"Weapon Type" STRING "Short Sword" FIXED
            ^"Original Bearer" STRING "Bilbo Baggins" FIXED
            ^"Craftsmanship" STRING "Elven" FIXED
            ^"Banes" LIST ["Orcs"] FIXED
            ^"Qualities" LIST ["Fell", "Cleaving", "Foe-slaying"] FIXED
            ^"Description" STRING "An Elven dagger of Gondolin make, dagger-sized in the hands of a man but a proper short sword for a Hobbit. The blade glows cold blue in the presence of Orcs. Named by Bilbo for the sting of a bee — a small name for a weapon that has felled great enemies." FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"Mithril Coat" DEF {
        EXTENDS ^"FamousArmour"
        PROPERTIES {
            ^"Name" STRING "Mithril Coat" FIXED
            ^"Armour Type" STRING "Mail-shirt" FIXED
            ^"Original Bearer" STRING "Bilbo Baggins" FIXED
            ^"Craftsmanship" STRING "Dwarven" FIXED
            ^"Qualities" LIST ["Mithril Armour", "Ancient", "Close-fitting"] FIXED
            ^"Description" STRING "Wrought for a young Elf-prince in ages past, this coat of rings of Mithril weighs no more than a parchment. It can turn blows that would fell a warrior in plate. Given by Thorin to Bilbo — it saved his life when no one knew it." FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"Glamdring" DEF {
        EXTENDS ^"FamousWeapon"
        PROPERTIES {
            ^"Name" STRING "Glamdring" FIXED
            ^"Weapon Type" STRING "Long Sword" FIXED
            ^"Original Bearer" STRING "Gandalf the Grey" FIXED
            ^"Craftsmanship" STRING "Elven" FIXED
            ^"Banes" LIST ["Orcs"] FIXED
            ^"Qualities" LIST ["Luminescence", "Cunning-make", "Hammering"] FIXED
            ^"Description" STRING "The mate to Orcrist, called Foe-hammer in Gondolin and Beater by Goblins. A rune-carved blade that gleams in the dark near Orc-sign. Borne by Gandalf, who found it in a Troll-hoard." FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
    ^"Coat of Silver Mail" DEF {
        EXTENDS ^"FamousArmour"
        PROPERTIES {
            ^"Name" STRING "Coat of Silver Mail" FIXED
            ^"Armour Type" STRING "Coat of Mail" FIXED
            ^"Original Bearer" STRING "Balin" FIXED
            ^"Craftsmanship" STRING "Dwarven" FIXED
            ^"Qualities" LIST ["Ancient", "Cunning-make", "Superior Reinforced"] FIXED
            ^"Description" STRING "Gifted once to a son of Girion of Dale, this silver coat is bright as the moon but strong as triple steel. It has passed through many hands in the long years since Dale fell." FIXED
            ^"Source" STRING "Erebor Campaign" FIXED
        }
    }
