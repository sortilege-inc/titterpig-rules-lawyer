BASE "tor2e" {
    NAME "tor2e — resolved composition"
    VERSION "0.4"
    # Generated by titterpig-synthesist from 32 source file(s).
    # Compiled artifact — do not edit; recompile from the composition manifest.
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # PLAYER TYPES
    # ─────────────────────────────────────────────
    ^"Player" DEF {
        PROPERTIES {
            ^"Description" STRING "A participant in the game who controls one or more Player-heroes." FIXED
        }
    }
    ^"Loremaster" DEF {
        EXTENDS ^"Player"
        PROPERTIES {
            ^"Description" STRING "The Player who controls the game world, all Loremaster Characters and Adversaries, frames scenes, and adjudicates rules. Equivalent to a Game Master in other systems." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # GAME STRUCTURE
    # The game alternates between two phases.
    # ─────────────────────────────────────────────
    GAME_STRUCTURE {
        DESCRIPTION "Gameplay is structured into two distinct phases that alternate: an Adventuring Phase followed by a Fellowship Phase. Together they form the rhythm of a campaign."
        ^"Adventuring Phase" DEF {
            PROPERTIES {
                ^"Description" STRING "The main phase of play, usually taking the largest part of a session or spanning multiple sessions. Played as a series of ^Scenes connected sequentially in a wider narrative arc." FIXED
                ^"Resolution" STRING "Scenes are resolved using Action Resolution rules. Notable exceptions requiring specialised rules: Combat, Council, and Journey scenes." FIXED
            }
        }
        ^"Fellowship Phase" DEF {
            PROPERTIES {
                ^"Description" STRING "A closing phase addressing downtime between adventures. Takes place at the Company's Safe Haven. Players choose one or more Undertakings — downtime activities that directly affect gameplay." FIXED
                ^"Undertakings" STRING "Structured downtime activities chosen by Players during the Fellowship Phase. Each Undertaking produces a specific mechanical effect." FIXED
                ^"Activities" LIST ["Recover Hope", "Remove Shadow Points", "Advance (spend AP/SP)", "Convert Shadow Points to Shadow Scars", "Loremaster advances the calendar and introduces new rumours"] FIXED
            }
        }
    }
    # ─────────────────────────────────────────────
    # CHARACTER CREATION
    # ─────────────────────────────────────────────
    CHARACTER_CREATION {
        DESCRIPTION "Each Player creates one Player-Hero by following three sequential phases."
        PHASE_1 "Choose a Heroic Culture" {
            DESCRIPTION "Select a Heroic Culture from the Free Peoples of the Westlands."
            OPTIONS [^"Bardings", ^"Dwarves of Durin's Folk", ^"Elves of Lindon", ^"Hobbits of the Shire", ^"Hobbits of the Bree-land", ^"Men of Bree", ^"Rangers of the North"]
            # See tor2e-2e-core-cultures.ttrpg for full culture definitions.
            STEPS {
                1 "Record your Cultural Blessing"
                2 "Determine your Attributes — choose a set or roll a Success Die"
                3 "Calculate Target Numbers — each TN equals 20 minus its corresponding Attribute score"
                4 "Calculate Derived Stats: Endurance, Hope, and Parry"
                5 "Record your Skill and Combat Proficiency ratings"
                6 "Choose your Distinctive Features"
                7 "Choose a Name and Age"
            }
        }
        PHASE_2 "Answer the Call to Adventure" {
            DESCRIPTION "Finalise the Player-Hero by choosing a Calling and spending creation resources."
            # See tor2e-2e-core-callings.ttrpg for full calling definitions.
            STEPS {
                1 "Choose a Calling — Captain, Champion, Messenger, Scholar, Treasure Hunter, or Warden"
                2 "Spend Previous Experience points (10-point budget; see PREVIOUS_EXPERIENCE_COSTS)"
                3 "Choose your starting Gear"
                4 "Record Valour and Wisdom at 1; choose a starting Reward and a starting Virtue"
            }
        }
        PHASE_3 "Gather the Company" {
            DESCRIPTION "All Players cooperate to establish how their Player-heroes met, formed a Company, and define shared Company details."
            # See ^"Company" DEF below.
        }
    }
    # ─────────────────────────────────────────────
    # COMPANY
    # The group of Player-heroes adventuring together.
    # "Company" and "Fellowship" are used interchangeably in the source.
    # ─────────────────────────────────────────────
    ^"Company" DEF {
        ALIAS "Fellowship"
        PROPERTIES {
            ^"Description" STRING "The group of Player-heroes who adventure together. A Company may be composed of adventurers of any Heroic Culture and Calling." FIXED
            ^"Members" LIST OF ^"Player-Hero"
            ^"Fellowship Rating" INTEGER MIN 0 DEFAULT 0
            ^"Fellowship Focus" STRING
            ^"Safe Haven" STRING
            ^"Patron" ^"Patron"
        }
    }
    # ─────────────────────────────────────────────
    # SCENE
    # ─────────────────────────────────────────────
    ^"Scene" DEF {
        PROPERTIES {
            ^"Description" STRING "A single episode focusing on the Company, or part of it, facing a challenge, preparing for one, or recovering from one." FIXED
            ^"Framing" STRING "The Loremaster frames each scene by describing the location, identifying which Player-heroes and other characters are present, and defining the challenge the Company faces." FIXED
            ^"Player Agency" STRING "Players have full control over what their Player-heroes do and how they do it. The Loremaster determines how the world — Loremaster Characters, creatures, and the environment — reacts." FIXED
        }
        # Advisory scene flow (typical, not binding):
        # 1. The Loremaster describes the situation.
        # 2. Players declare what their Player-heroes do (actions).
        # 3. The Loremaster determines the outcome and describes the results.
    }
    # ─────────────────────────────────────────────
    # DICE
    # ─────────────────────────────────────────────
    DICE {
        ^"Feat Die" DEF {
            PROPERTIES {
                ^"Description" STRING "A 12-sided die (d12) rolled once with every roll. Shows numbers 1–10 and two special icons." FIXED
                ^"Sides" INTEGER 12 FIXED
                ^"Gandalf Rune" STRING "Face 12. The greatest possible result. The action succeeds automatically regardless of whether the total meets the TN." FIXED
                ^"Eye of Sauron" STRING "Face 11. The worst possible result. Counts as zero for the purpose of totalling the roll. May trigger additional adverse effects depending on the type of roll." FIXED
                ^"Numbers" STRING "Faces 1–10. Added to Success Dice results to produce the roll total." FIXED
            }
        }
        ^"Success Die" DEF {
            PROPERTIES {
                ^"Description" STRING "A 6-sided die (d6). The number of Success Dice rolled equals the rating of the ability being tested (minimum 0). Rolled alongside the Feat Die." FIXED
                ^"Sides" INTEGER 6 FIXED
                ^"Tengwar Rune" STRING "Face 6. Counts as 6 toward the roll total AND as one Success icon for determining degree of success and triggering Special Successes." FIXED
                ^"Outline Numbers" STRING "Faces 1, 2, 3. Shown in outline. Count normally toward the total. When the Player-hero is Weary, these faces count as zero instead." FIXED
                ^"Solid Numbers" STRING "Faces 4, 5. Shown in solid black. Always count normally toward the total." FIXED
            }
        }
    }
    # ─────────────────────────────────────────────
    # ACTION RESOLUTION
    # ─────────────────────────────────────────────
    ACTION_RESOLUTION {
        DESCRIPTION "When a Player-hero attempts an action whose outcome is uncertain, the Loremaster may call for a roll. Actions occur within Scenes."
        ^"Action"
        STRING "A declaration of intent by a Player describing what their Player-hero attempts to do." FIXED
        ^"When to Roll" DEF {
            PROPERTIES {
                ^"Danger" STRING "The action involves risk — physical peril, social jeopardy, or meaningful consequences on failure." FIXED
                ^"Knowledge" STRING "The Player-hero seeks hidden or obscure information that they might not possess." FIXED
                ^"Manipulation" STRING "The Player-hero attempts to persuade, deceive, or socially manoeuvre another character." FIXED
            }
        }
        ^"When Not to Roll" DEF {
            PROPERTIES {
                ^"No Danger" STRING "There is no meaningful risk or consequence of failure." FIXED
                ^"Common Knowledge" STRING "The information sought is obvious or well-known to the Player-hero." FIXED
                ^"Willing Target" STRING "The target is already cooperative or willing." FIXED
            }
        }
    }
    # ─────────────────────────────────────────────
    # ROLL MECHANICS
    # ─────────────────────────────────────────────
    ROLL_MECHANICS {
        DESCRIPTION "The procedure for resolving uncertain actions through dice rolls."
        ^"Who Rolls" DEF {
            PROPERTIES {
                ^"Single Roller" STRING "Normally a single Player-hero makes the roll — the one best suited to the task. Other heroes may provide Support." FIXED
                ^"Group Roll" STRING "When something involves everyone in the group, all affected Player-heroes roll." FIXED
            }
        }
        ^"Roll Types" DEF {
            PROPERTIES {
                ^"Skill Roll" STRING "The most common type. Used when a Player-hero attempts something covered by one of the 18 Skills." FIXED
                ^"Combat Roll" STRING "Used in fights. Player-heroes use Combat Proficiencies for attack rolls and Protection rolls to avoid serious injury." FIXED
                ^"Shadow Test" STRING "Used to resist the corrupting effect of the Shadow. Made using Valour or Wisdom, prompted by Dread, Sorcery, or Greed." FIXED
            }
        }
        ^"Roll Procedure" DEF {
            PROPERTIES {
                ^"Step 1" STRING "Roll one Feat Die plus a number of Success Dice equal to the rating of the ability being tested. If the rating is zero, roll only the Feat Die." FIXED
                ^"Step 2" STRING "Add up the numerical results on all dice. Compare the total to the Target Number (TN) associated with the ability." FIXED
                ^"Success" STRING "If the total equals or exceeds the TN, the roll succeeds — the Player-hero achieves their goal." FIXED
                ^"Failure" STRING "If the total is less than the TN, the roll fails — the desired goal was not achieved." FIXED
            }
        }
        ^"Target Numbers" DEF {
            PROPERTIES {
                ^"Attribute TN" STRING "Each Attribute TN equals 20 minus the corresponding Attribute score." FIXED
                ^"Strength TN" FORMULA "20 - Strength"
                ^"Heart TN" FORMULA "20 - Heart"
                ^"Wits TN" FORMULA "20 - Wits"
            }
            # Optional rule (also default in Strider Mode):
            # TN = 18 - Attribute instead of 20 - Attribute.
            # Suited for shorter campaigns or one-shot games.
        }
        ^"Degree of Success" DEF {
            PROPERTIES {
                ^"Success" STRING "Roll meets or exceeds the TN but no Tengwar icons were rolled. The action succeeds at the bare minimum." FIXED
                ^"Great Success" STRING "Roll succeeds and exactly one Tengwar icon was rolled. The accomplishment is out of the ordinary." FIXED
                ^"Extraordinary Success" STRING "Roll succeeds and two or more Tengwar icons were rolled. The result is absolutely exceptional and memorable." FIXED
            }
        }
        ^"Special Successes" DEF {
            DESCRIPTION "On a successful Skill roll, each Tengwar icon may be spent to trigger one special result. Spending does not reduce the numerical total or the overall success level."
            PROPERTIES {
                ^"Cancel a Failure" STRING "If the roll involves multiple players, help another Player-hero who failed — their failed roll is treated as a success." FIXED
                ^"Score 1 Additional Success" STRING "If the action requires multiple successes, score 1 additional success." FIXED
                ^"Gain Insight" STRING "Gain additional information not necessarily related to the task at hand." FIXED
                ^"Go Quietly" STRING "Achieve the goal noiselessly or without attracting attention." FIXED
                ^"Make Haste" STRING "Complete the task in about half the expected time." FIXED
                ^"Widen Influence" STRING "Affect one additional subject or group of subjects beyond those originally targeted." FIXED
            }
        }
        ^"Repeating a Roll" DEF {
            PROPERTIES {
                ^"One Attempt" STRING "Players have only one attempt at anything resolved by a die roll." FIXED
                ^"Different Skill" STRING "If the Loremaster allows, a failed Skill roll may be retried by the same Player-hero using a different Skill, representing a different approach. The hero must cope with the consequences of the first failure." FIXED
            }
        }
        # ── Roll Modifiers ──
        ^"Favoured Roll" DEF {
            PROPERTIES {
                ^"Description" STRING "Roll two Feat Dice instead of one, keeping the best result." FIXED
                ^"Sources" STRING "Favoured Skills, certain Cultural Virtues, and other special abilities." FIXED
            }
        }
        ^"Ill-favoured Roll" DEF {
            PROPERTIES {
                ^"Description" STRING "Roll two Feat Dice instead of one, keeping the worst result." FIXED
                ^"Sources" STRING "Adversary special abilities, Madness, Flaws, or when Shadow Points equal maximum Hope." FIXED
            }
        }
        ^"Favoured vs Ill-favoured" DEF {
            PROPERTIES {
                ^"Cancellation" STRING "If a roll is both Favoured and Ill-favoured for different reasons, they cancel out — roll one Feat Die normally. This applies regardless of how many sources contribute to each side." FIXED
                ^"Ill-favoured Player-hero" STRING "When a rule makes a Player-hero Ill-favoured (rather than a specific roll), all rolls made by that hero are Ill-favoured. Includes Player-heroes whose Shadow Points equal their maximum Hope." FIXED
            }
        }
        ^"Bonus Success Dice" DEF {
            PROPERTIES {
                ^"Description" STRING "Under favourable circumstances or with beneficial talents, a Player-hero gains additional Success Dice, noted as gain (Nd)." FIXED
            }
        }
        ^"Hope Bonus" DEF {
            PROPERTIES {
                ^"Description" STRING "Before making a roll, a Player-hero may spend 1 Hope point to gain (1d). Only 1 Hope point may be spent per roll by the rolling hero." FIXED
            }
        }
        ^"Inspiration" DEF {
            PROPERTIES {
                ^"Description" STRING "An Inspired Player-hero who spends 1 Hope point gains (2d) instead of (1d)." FIXED
                ^"Sources" STRING "Achieved mainly through invocation of a Distinctive Feature, or certain Cultural Virtues." FIXED
            }
        }
        ^"Support" DEF {
            PROPERTIES {
                ^"Description" STRING "A Player-hero may spend 1 Hope point to let another Player-hero making a Skill roll gain (1d)." FIXED
                ^"Requirements" STRING "The supporting hero must possess at least one rank in an appropriate Skill (Loremaster's judgement). Only one hero may support per roll." FIXED
            }
        }
        ^"Penalty Success Dice" DEF {
            PROPERTIES {
                ^"Description" STRING "Under unfavourable circumstances, a Player-hero loses Success Dice, noted as lose (Nd). The number of Success Dice cannot drop below zero." FIXED
                ^"Sources" STRING "Situational disadvantages, less aggressive combat stances, complications." FIXED
            }
        }
        ^"Bonuses vs Penalties" DEF {
            PROPERTIES {
                ^"Cumulative" STRING "Bonuses and penalties are cumulative. Add all gained dice and subtract all lost dice to determine the final modifier." FIXED
            }
        }
        ^"Magical Success" DEF {
            PROPERTIES {
                ^"Description" STRING "A Player-hero possessing a magical talent or artefact may spend 1 Hope point before a Skill roll to pass the action automatically, regardless of the TN." FIXED
                ^"Procedure" STRING "Roll only the required number of Success Dice (to check for degree of success) but disregard the numerical total." FIXED
                ^"Narrative" STRING "A Magical success produces an outcome unmistakably supernatural — the hero achieves something impossible without magical aid." FIXED
                ^"Caution" STRING "Overt magical effects may unsettle folk unaccustomed to such feats, or raise suspicion from those capable of recognising supernatural influences." FIXED
            }
        }
    }
    # ─────────────────────────────────────────────
    # CONDITIONS
    # Three conditions that modify die rolls, tracked on the character sheet.
    # ─────────────────────────────────────────────
    CONDITIONS {
        ^"Weary" DEF {
            PROPERTIES {
                ^"Trigger" STRING "Current Endurance drops to a level equal to or lower than Load (Load is temporarily increased by Fatigue during journeys)." FIXED
                ^"Effect" STRING "All Success Dice showing an outline number (1, 2, or 3) count as zero." FIXED
                ^"Removal" STRING "Endurance rises above Load (+ Fatigue)." FIXED
            }
        }
        ^"Miserable" DEF {
            PROPERTIES {
                ^"Trigger" STRING "Shadow Points equal or exceed current Hope score." FIXED
                ^"Effect" STRING "When making a roll, if the Feat Die shows the Eye of Sauron, the action fails regardless of the total result." FIXED
                ^"Removal" STRING "Shadow Points drop below Hope score (e.g. via Fellowship Phase or spending Hope to convert Shadow Points to Shadow Scars)." FIXED
            }
        }
        ^"Wounded" DEF {
            PROPERTIES {
                ^"Trigger" STRING "Failed Protection roll in combat (Piercing Blow with no Tengwar on Protection dice)." FIXED
                ^"Effect" STRING "Wounded heroes who remain active risk being knocked out of combat. Wounded heroes recover lost Endurance points more slowly." FIXED
                ^"Removal" STRING "Rest and recovery (see Resting rules). A Moderate Injury (Gandalf Rune on Wound Severity) is removed at end of combat." FIXED
            }
        }
    }
    # ─────────────────────────────────────────────
    # CORE ACTOR TYPES
    # ─────────────────────────────────────────────
    #TOR0010000000000 ACTOR "Player-Hero" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Culture" STRING REQUIRED
            ^"Calling" STRING REQUIRED
            ^"Age" INTEGER MIN 1 DEFAULT 25
            ^"Standard of Living" ENUM ["Poor", "Frugal", "Common", "Prosperous", "Rich", "Very Rich"] DEFAULT "Common"
            ^"Attributes" DEF {
                ^"Strength" INTEGER MIN 1 MAX 9 DEFAULT 4
                ^"Heart" INTEGER MIN 1 MAX 9 DEFAULT 4
                ^"Wits" INTEGER MIN 1 MAX 9 DEFAULT 4
            }
            ^"Target Numbers" DEF {
                ^"Strength TN" INTEGER MIN 11 MAX 19 DEFAULT 14
                FORMULA "20 - Strength"
                ^"Heart TN" INTEGER MIN 11 MAX 19 DEFAULT 14
                FORMULA "20 - Heart"
                ^"Wits TN" INTEGER MIN 11 MAX 19 DEFAULT 14
                FORMULA "20 - Wits"
            }
            ^"Derived Stats" DEF {
                ^"Endurance" INTEGER MIN 0 DEFAULT 22
                ^"Current Endurance" INTEGER MIN 0
                ^"Hope" INTEGER MIN 0 DEFAULT 12
                ^"Current Hope" INTEGER MIN 0
                ^"Parry" INTEGER MIN 10 DEFAULT 12
            }
            ^"Advancement" DEF {
                ^"Valour" INTEGER MIN 1 MAX 6 DEFAULT 1
                ^"Wisdom" INTEGER MIN 1 MAX 6 DEFAULT 1
                ^"Adventure Points" INTEGER MIN 0 DEFAULT 0
                ^"Skill Points" INTEGER MIN 0 DEFAULT 0
                ^"Treasure" INTEGER MIN 0 DEFAULT 0
            }
            ^"Fellowship Focus Target" STRING
            ^"Shadow" DEF {
                ^"Shadow Points" INTEGER MIN 0 DEFAULT 0
                ^"Shadow Scars" INTEGER MIN 0 DEFAULT 0
                ^"Flaws" LIST OF ^"Flaw"
                ^"Shadow Path" STRING
            }
            ^"Skills" LIST OF ^"SkillRank"
            ^"Combat Proficiencies" LIST OF ^"CombatProficiency"
            ^"Distinctive Features" LIST OF ^"DistinctiveFeature"
            ^"Virtues" LIST OF ^"Virtue"
            ^"Rewards" LIST OF ^"Reward"
            ^"Patron" STRING
            ^"Cultural Blessing" STRING
            ^"Background" STRING
            ^"Conditions" DEF {
                ^"Weary" BOOLEAN DEFAULT false
                ^"Wounded" BOOLEAN DEFAULT false
                ^"Miserable" BOOLEAN DEFAULT false
            }
            ^"Load" INTEGER MIN 0 DEFAULT 0
            ^"Fatigue" INTEGER MIN 0 DEFAULT 0
        }
        RULES {
            #TOR_R00100000000: WHEN [^"Strength" UPDATED] THEN RECALCULATE ^"Endurance"
            #TOR_R00200000000: WHEN [^"Heart" UPDATED]    THEN RECALCULATE ^"Hope"
            #TOR_R00300000000: WHEN [^"Wits" UPDATED]     THEN RECALCULATE ^"Parry"
            #TOR_R00400000000: WHEN [^"Shadow Points" >= ^"Hope"] THEN ^"Player-Hero" IS miserable
            #TOR_R00500000000: WHEN [^"Endurance" <= 0]   THEN ^"Player-Hero" IS incapacitated
            #TOR_R00600000000: WHEN [^"Endurance" <= ^"Load" + ^"Fatigue"] THEN ^"Player-Hero" IS weary
            #TOR_R00700000000: WHEN [^"Endurance" > ^"Load" + ^"Fatigue"]  THEN ^"Player-Hero" IS NOT weary
            #TOR_R00800000000: WHEN [^"Valour" INCREASED] THEN GRANT ^"Reward"
            #TOR_R00900000000: WHEN [^"Wisdom" INCREASED] THEN GRANT ^"Virtue"
        }
    }
    #TOR0020000000000 ACTOR "Adversary" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Adversary Type" ENUM ["Creature", "Orc", "Troll", "Undead", "Man", "Spider", "Wolf", "Dragon"] DEFAULT "Creature"
            ^"Attribute Level" INTEGER MIN 1 MAX 15 DEFAULT 3
            ^"Endurance" INTEGER MIN 1 DEFAULT 12
            ^"Might" INTEGER MIN 1 MAX 5 DEFAULT 1
            ^"Hate" INTEGER MIN 0 DEFAULT 3
            ^"Hate Current" INTEGER MIN 0 DEFAULT 3
            ^"Resolve" INTEGER MIN 0 DEFAULT 0
            ^"Resolve Current" INTEGER MIN 0 DEFAULT 0
            ^"Parry Modifier" INTEGER MIN -3 MAX 5 DEFAULT 0
            ^"Armour Rating" INTEGER MIN 0 MAX 6 DEFAULT 1
            ^"Combat Proficiencies" LIST OF ^"AdversaryCombatProfile"
            ^"Fell Abilities" LIST OF ^"FellAbility"
            ^"Description" STRING
            ^"Source" STRING
        }
    }
    #TOR0030000000000 ACTOR "Loremaster Character" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
            ^"Location" STRING
            ^"Notes" STRING
        }
    }
    #TOR0040000000000 ACTOR "Patron" DEF {
        EXTENDS ^"Loremaster Character"
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Title" STRING
            ^"Location" STRING
            ^"Fellowship Bonus" INTEGER MIN 0 MAX 3 DEFAULT 1
            ^"Patron Ability" STRING
            ^"Background" STRING
            ^"Source" STRING
        }
    }
    # ─────────────────────────────────────────────
    # RATING LABELS
    # Ratings range from 0 (lowest) to 6 (highest) for both Skills and
    # Combat Proficiencies, with different descriptive labels for each.
    # ─────────────────────────────────────────────
    RATING_LABELS {
        SKILL {
            0 "Unskilled"
            1 "Poor"
            2 "Average"
            3 "Good"
            4 "Superior"
            5 "Outstanding"
            6 "Prodigious"
        }
        COMBAT_PROFICIENCY {
            0 "Untrained"
            1 "Beginner"
            2 "Average"
            3 "Experienced"
            4 "Veteran"
            5 "Master"
            6 "Heroic"
        }
    }
    # ─────────────────────────────────────────────
    # SHARED DEF TYPES
    # ─────────────────────────────────────────────
    ^"SkillRank" DEF {
        PROPERTIES {
            ^"Skill" STRING REQUIRED
            ^"Rank" INTEGER MIN 0 MAX 6 DEFAULT 0
            ^"Favoured" BOOLEAN DEFAULT false
        }
    }
    ^"CombatProficiency" DEF {
        PROPERTIES {
            ^"Group" ENUM ["Axes", "Bows", "Spears", "Swords", "Brawling"] REQUIRED
            ^"Rank" INTEGER MIN 0 MAX 6 DEFAULT 1
        }
    }
    ^"AdversaryCombatProfile" DEF {
        PROPERTIES {
            ^"Weapon Name" STRING REQUIRED
            ^"Rank" INTEGER MIN 1 MAX 6 DEFAULT 2
            ^"Damage" INTEGER MIN 1 DEFAULT 3
            ^"Injury" INTEGER MIN 10 DEFAULT 14
            ^"Special Damage" ENUM ["Pierce", "Seize", "Heavy Blow", "Break Shield", "Fell Blow", ""] DEFAULT ""
        }
    }
    ^"FellAbility" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Effect" STRING
        }
    }
    ^"DistinctiveFeature" DEF {
        # Traits that set one hero apart from another, typically tied to Heroic Culture
        # or Calling. When relevant to a roll, a Player may spend 1 Hope to become
        # Inspired (see ROLL_MECHANICS).
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Type" ENUM ["Personality", "Physical", "Calling"] DEFAULT "Personality"
        }
    }
    ^"Virtue" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Culture" STRING DEFAULT "Standard"
            ^"Minimum Wisdom" INTEGER MIN 1 MAX 6 DEFAULT 1
            ^"Effect" STRING
        }
    }
    ^"Reward" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Applies To" ENUM ["Armour", "Weapon", "Shield"] REQUIRED
            ^"Effect" STRING
        }
    }
    ^"Flaw" DEF {
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Shadow Path" STRING
            ^"Severity" INTEGER MIN 1 MAX 4 DEFAULT 1
            ^"Effect" STRING
        }
    }
    # ─────────────────────────────────────────────
    # ADVANCEMENT COSTS
    # ─────────────────────────────────────────────
    # AP (Adventure Points) are spent on: Valour, Wisdom, Combat Proficiencies
    # SP (Skill Points) are spent on: Skills
    # All post-creation advancement uses the same cost table regardless of trait type.
    ADVANCEMENT_COSTS {
        ^"Valour"
        COST "rank 1: 4 AP | rank 2: 8 AP | rank 3: 12 AP | rank 4: 20 AP | rank 5: 26 AP | rank 6: 30 AP"
        ^"Wisdom"
        COST "rank 1: 4 AP | rank 2: 8 AP | rank 3: 12 AP | rank 4: 20 AP | rank 5: 26 AP | rank 6: 30 AP"
        ^"Combat Proficiency"
        COST "rank 1: 4 AP | rank 2: 8 AP | rank 3: 12 AP (max rank 3)"
        ^"Skill Rank"
        COST "rank 1: 4 SP | rank 2: 8 SP | rank 3: 12 SP | rank 4: 20 SP | rank 5: 26 SP | rank 6: 30 SP"
    }
    # ─────────────────────────────────────────────
    # PREVIOUS EXPERIENCE COSTS (Character Creation)
    # ─────────────────────────────────────────────
    # Spent during character creation from the 10-point Previous Experience budget.
    # These are NOT Adventure Points or Skill Points.
    PREVIOUS_EXPERIENCE_COSTS {
        ^"Skill Rank"
        COST "rank 1: 1 pt | rank 2: 2 pts | rank 3: 3 pts | rank 4: 5 pts (max rank 4)"
        ^"Combat Proficiency"
        COST "rank 1: 2 pts | rank 2: 4 pts | rank 3: 6 pts"
    }
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # SKILL BASE TYPE
    # ─────────────────────────────────────────────
    ^"Skill" DEF {
        PROPERTIES {
            ^"Governing Attribute" ENUM ["Strength", "Heart", "Wits"] REQUIRED
            ^"Skill Group" ENUM ["Personality", "Movement", "Perception", "Survival", "Custom", "Vocation"] REQUIRED
            ^"Description" STRING
        }
    }
    # ─────────────────────────────────────────────
    # SKILL GROUPS
    # ─────────────────────────────────────────────
    # The 18 Skills are categorised by affinity into six Skill groups of
    # 3 Skills each, with each group associated with a different type of
    # activity. Each group contains one Strength, one Heart, and one Wits skill.
    SKILL_GROUPS {
        ^"Personality"
        {
            SKILLS [^"Awe", ^"Enhearten", ^"Persuade"]
            DESCRIPTION "A hero's personality comes through in their capacity to impress, encourage, and influence others. A good level of proficiency in all three Skills in this group is the mark of a leader."
        }
        ^"Movement"
        {
            SKILLS [^"Athletics", ^"Travel", ^"Stealth"]
            DESCRIPTION "Overcoming obstacles, enduring long journeys, and moving secretly are the stuff adventurers are made of."
        }
        ^"Perception"
        {
            SKILLS [^"Awareness", ^"Insight", ^"Scan"]
            DESCRIPTION "The ability to catch hidden details often pays off, be it noticing an odd noise that gives away an ambusher, catching the gleam in the eyes of a liar, or spotting the crack in the wall that reveals a secret door."
        }
        ^"Survival"
        {
            SKILLS [^"Hunting", ^"Healing", ^"Explore"]
            DESCRIPTION "The three Skills of this group, essential for a roving adventurer, make for an invaluable member of a company."
        }
        ^"Custom"
        {
            SKILLS [^"Song", ^"Courtesy", ^"Riddle"]
            DESCRIPTION "While heroes are often held to be uncivilised brutes by the common folk, their lives can sometimes depend on knowing the proper words, wisest song, or cleverest answer. Excelling in these Skills is considered a noble achievement."
        }
        ^"Vocation"
        {
            SKILLS [^"Craft", ^"Battle", ^"Lore"]
            DESCRIPTION "Before their resolve hardened and pushed them on the road to adventure, adventurers probably led a life much like that of ordinary individuals: learning a trade, defending their people, and absorbing their accumulated wisdom."
        }
    }
    # ─────────────────────────────────────────────
    # THE 18 SKILLS
    # Organised by governing Attribute, with Skill Group cross-reference.
    # ─────────────────────────────────────────────
    # STRENGTH SKILLS
    ^"Awe" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Strength" FIXED
            ^"Skill Group" STRING "Personality" FIXED
            ^"Description" STRING "This Skill measures the capacity to evoke respect in onlookers, and determines the impression the Player-heroes make on someone they meet for the first time. Depending on the circumstances and on the player's intentions, it can be used to instil wonderment, admiration, or even fear. Awe arises from a hero's native charisma, but can also be engineered by a dramatic entrance or impressive attire. Successful use of the Awe Skill evokes the chosen effect, while failure can lead to the opposite result. Achieving a superior success means that a hero has won the hearts of the onlookers or cowed them into silent submission."
        }
    }
    ^"Athletics" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Strength" FIXED
            ^"Skill Group" STRING "Movement" FIXED
            ^"Description" STRING "Athletics is a broad Skill, covering most of the physical activities that a hero might undertake while adventuring, including running, leaping, climbing, and swimming. Heroes with high Athletics Skill scores exhibit a winning combination of physical prowess, grace, and control, generally gained through continuous exercise and daily exertion. A successful Athletics roll produces a satisfactory outcome in the physical activity, while a failed roll might lead to serious harm, depending on the circumstances. A superior result suggests a spectacular achievement."
        }
    }
    ^"Awareness" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Strength" FIXED
            ^"Skill Group" STRING "Perception" FIXED
            ^"Description" STRING "The Awareness Skill represents a hero's readiness to react and the ability to notice something unexpected, out of the ordinary, or difficult to detect. A high Skill score reflects both keen senses and the experience to understand what is seen or heard — a high level of watchfulness is extremely useful if a Player-hero serves as a look-out for the Company."
        }
    }
    ^"Hunting" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Strength" FIXED
            ^"Skill Group" STRING "Survival" FIXED
            ^"Description" STRING "Knowing how to hunt is a fundamental skill, shared by most cultures of Middle-earth. A Hunting roll may be required when pursuing a creature through wild areas, or to follow tracks and identify a quarry by its spoor. The Hunting Skill also covers preparing traps and the training and use of hunting dogs or birds. In wilder areas, hunters learn to apply their trade to more dangerous quarries — such as Orcs, Spiders, or Wargs — or else risk becoming the prey."
        }
    }
    ^"Song" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Strength" FIXED
            ^"Skill Group" STRING "Custom" FIXED
            ^"Description" STRING "Hobbits and Men, Elves and Dwarves, even Goblins and maybe Orcs: all creatures of Middle-earth celebrate by playing music and singing songs. Great deeds and grim misfortunes are remembered in verse, and pleasant or comic stories are told to ease spirits and find comfort. The Song Skill is used to recite poems, sing songs, or play instruments suitable to a character's Culture. It can also be used to learn new works or create original compositions."
        }
    }
    ^"Craft" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Strength" FIXED
            ^"Skill Group" STRING "Vocation" FIXED
            ^"Description" STRING "The Craft Skill doesn't really cover the whole range of abilities of smiths, wrights, and other artisans, but reflects a talent for making or mending things by hand. Craft can be used to repair the wheel of a cart, or construct an improvised raft with wood found on a river shore, or to start a fire on a windy hill. A high Craft score may indicate that the Player-hero was a craftsperson before starting a life of adventure. Some Cultures, such as the Dwarves and Noldorin Elves, revere crafts as the highest expression of creativity."
        }
    }
    # HEART SKILLS
    ^"Enhearten" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Heart" FIXED
            ^"Skill Group" STRING "Personality" FIXED
            ^"Description" STRING "Player-heroes can use the Enhearten Skill to instil positive feelings in others, urging them to act on the matter at hand. They achieve this mainly through example, charisma, and personal conviction, rather than through the effective use of words (which falls under Persuade). This Skill can be used on individuals, but is particularly effective in influencing crowds. Player-heroes with high Enhearten ratings can be forceful orators, passionate agitators, and well-loved leaders. A successful Enhearten roll awakens a chosen feeling in the subject, as long as it is not in opposition to their current mood. A superior success is enough to influence wholly disinterested individuals, or turn rivals into supporters."
        }
    }
    ^"Travel" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Heart" FIXED
            ^"Skill Group" STRING "Movement" FIXED
            ^"Description" STRING "In the Third Age, the cities, villages, and towns of Middle-earth are often separated by many leagues of wild or deserted areas. Roads that used to lead safely to distant realms now end in broken trails that go nowhere. Whichever way the Company chooses to go, it will be a long and weary way before they get there. A successful roll of Travel may let a Player-hero estimate the length of a journey, read a map, and even evaluate whether a group of strangers on the road can be approached safely or if they should be left alone instead. A good Travel Skill is an invaluable asset for the Guide of the Company when on a journey."
        }
    }
    ^"Insight" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Heart" FIXED
            ^"Skill Group" STRING "Perception" FIXED
            ^"Description" STRING "Insight represents the ability to see beyond appearances and to recognise the hidden thoughts and beliefs of people. Insight does not reveal if someone is lying, but the information it yields can be used to draw useful conclusions about people's motives. Heroes with a high Insight score are often recognised as being sensible and discerning individuals, and many may seek their counsel. A successful Insight roll provides the Player-heroes with a reliable, but partial, portrait of the person they are observing. A superior success allows them to correctly guess additional details about an individual's state of mind. Insight tests may be rolled in opposition to an adversary trying to sway or convince a Player-hero of something."
        }
    }
    ^"Healing" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Heart" FIXED
            ^"Skill Group" STRING "Survival" FIXED
            ^"Description" STRING "The knowledge of how to relieve pain and apply remedies to restore health to the suffering is an ancient one, and treatments differ from culture to culture. However, almost all traditions agree on the treatment of serious injuries, which must be tended immediately to keep from worsening. The Healing Skill includes bone setting and the use of herbs or salves, but the outcome relies on the ability of the healer to understand what ails the sufferer and determine what should be done to help them."
        }
    }
    ^"Courtesy" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Heart" FIXED
            ^"Skill Group" STRING "Custom" FIXED
            ^"Description" STRING "The Free Peoples recognise common norms of decency and ancient conventions of behaviour. Observing these traditions demonstrates respect and is a way of quickly establishing a friendly footing even with complete strangers. Succeeding in a Courtesy roll might mean the Player-heroes know what to say at the right moment to make a good impression with their host, or are mindful of their manners when receiving guests."
        }
    }
    ^"Battle" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Heart" FIXED
            ^"Skill Group" STRING "Vocation" FIXED
            ^"Description" STRING "A rating in this Skill shows a firm grasp of the rules of battle and the capability to maneuver appropriately when involved in a violent confrontation. The Battle Skill can be used to gain an advantage when fighting against a group of foes, or leading a company of troops in open battle and maintaining order in the midst of chaos. Individual fighting talents are covered by Combat Proficiencies."
        }
    }
    # WITS SKILLS
    ^"Persuade" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Wits" FIXED
            ^"Skill Group" STRING "Personality" FIXED
            ^"Description" STRING "This Skill allows the Player-heroes to apply their reasoning to convince other individuals of an idea or course of action. It can be used to influence small groups of listeners, but only if used in an appropriate context, such as a common hall. Persuasion requires more time than other Personality Skills, but can have a more lasting impact on other characters' actions. A high Persuade score denotes an uncommon eloquence, a love of speech and knowledge of its proper use and its effect on listeners. Wise people, advisers to chieftains and kings, and their messengers all share this passion for the spoken word. The successful use of the Persuade Skill allows a Player-hero to convince an audience that their current position regarding a matter is flawed. A superior success convinces listeners of the quality of a hero's stance, and may even turn them into ardent believers."
        }
    }
    ^"Stealth" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Wits" FIXED
            ^"Skill Group" STRING "Movement" FIXED
            ^"Description" STRING "Player-heroes resort to Stealth whenever they need to act in a furtive or secret way. The Skill includes hiding, moving quietly, and shadowing others. These activities often rely on quickness and precision, so a stealthy Player-hero combines practised caution with the ability to judge the right moment to take a chance. Hunters, burglars, and solitary fighters use Stealth to prosper in their trade. A successful Stealth roll indicates that the hero has gone unnoticed, while failure almost certainly attracts unwanted attention. A superior success produces an outcome so flawless that it may even be impossible to notice the deed after the fact."
        }
    }
    ^"Scan" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Wits" FIXED
            ^"Skill Group" STRING "Perception" FIXED
            ^"Description" STRING "Player-heroes can use the Scan Skill when examining something closely or attentively. This Skill allows a Player-hero to skim through a book to locate a piece of relevant information, look for concealed doors or hidden inscriptions, recognise a familiar face in a crowd, or locate a set of tracks on the ground. Scan rolls are generally initiated by the players rather than the Loremaster. One roll is required for each inspection of a small area, such as a room. Awareness, rather than Scan, is used to see if a hero passively notices something. A successful Scan roll generally lets Player-heroes find what they are looking for — if it is to be found at all. A superior success usually means the object is found more quickly."
        }
    }
    ^"Explore" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Wits" FIXED
            ^"Skill Group" STRING "Survival" FIXED
            ^"Description" STRING "Player-heroes rely on the Explore Skill when they move through an unfamiliar area of the Wild. An Explore roll may be required during a journey to find out where the Company is heading, or to get back on track after a detour; to cope with adverse weather conditions or other natural hazards; to create paths through the wilderness suitable for others to follow; or to choose a suitable place to set up camp. A high Explore rating is an invaluable resource if a Player-hero is acting as a scout for the Company."
        }
    }
    ^"Riddle" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Wits" FIXED
            ^"Skill Group" STRING "Custom" FIXED
            ^"Description" STRING "Owing its name to the ancient game, the Riddle Skill represents the ability to draw conclusions from seemingly unconnected scraps of information by deduction, reasoning, and intuition. Adventurers also rely on Riddle whenever they are forced to talk about a subject but prefer to conceal part of what they know; for example, to tell something about themselves without revealing their identity. As an accepted custom among many cultures, speaking in riddles is usually allowed among strangers meeting for the first time and wanting to speak guardedly. This Skill is also used to gain helpful insight from a spoken or written riddle."
        }
    }
    ^"Lore" DEF {
        EXTENDS ^"Skill"
        PROPERTIES {
            ^"Governing Attribute" STRING "Wits" FIXED
            ^"Skill Group" STRING "Vocation" FIXED
            ^"Description" STRING "Lore expresses a love for learning: be it a fascination with descriptions of distant lands or an interest in family genealogy. Whenever an action involves knowledge of some kind, a Lore test is required. Player-heroes are considered to be knowledgeable in the traditions of their own people, and so the Loremaster should rarely require a player to make a Lore roll for information regarding their own character's Culture or the area they originally came from."
        }
    }
    # ─────────────────────────────────────────────
    # COMBAT PROFICIENCIES (4 standard + Brawling)
    # ─────────────────────────────────────────────
    # Rolls made using Combat Proficiencies are resolved as Skill rolls,
    # rolling one Feat Die and a number of Success Dice equal to the rank
    # possessed in the Combat Proficiency used. All Combat Proficiency rolls
    # use the Strength TN. Combat Proficiencies can never be Favoured
    # (unless a specific Cultural Blessing or Virtue overrides this).
    # Improved only with Adventure Points (not Skill Points).
    # Rank 0 = roll only a Feat Die.
    COMBAT_PROFICIENCIES {
        ^"Axes"
        {
            WEAPONS [^"Axe", ^"Great Axe", ^"Long-hafted Axe", ^"Mattock"]
            DESCRIPTION "Axes and other bashing weapons are often preferred to swords by warriors who favour a more brutal approach to fighting. Historically, the axe is the weapon of choice for most Dwarves, and for their folk it surpasses the sword in both nobility and respect. Dwarven weaponsmiths apply their cunning to making axes of many different shapes and uses, and from metals of various colours. The Axes Combat Proficiency allows a Player-hero to use an axe, a great axe, a long-hafted axe, but also a mattock."
        }
        ^"Bows"
        {
            WEAPONS [^"Bow", ^"Great Bow"]
            DESCRIPTION "A traditional hunting weapon, the bow is also commonly used in warfare. Made from a single piece of wood, or from a composition of wood, horn, or even metal, bows are a versatile weapon. They can be used during sieges, from horseback, in dense woodland, or in the open field. Archers usually carry another weapon to draw when the enemy gets closer; they seldom carry shields, as they can't use them when shooting a bow. The Bows Combat Proficiency enables a Player-hero to make ranged attacks using a bow or a great bow."
        }
        ^"Spears"
        {
            WEAPONS [^"Short Spear", ^"Spear", ^"Great Spear"]
            DESCRIPTION "The spear is arguably the most widespread weapon across Middle-earth, arming kings and soldiers, riders and infantry. It is often no more than a long wooden shaft, tipped by a leaf-shaped metal head, but some spears are works of majestic artisanship, valuable heirlooms of noble households. The length of a spear varies according to the use it is designed for. Spears can be wielded one or two-handed to thrust and lunge, cast to pierce from a distance, or used from horseback as lances. Warriors equipped with a spear typically use it in conjunction with a shield, and they usually carry an additional weapon, such as a sword or axe. The Spears Combat Proficiency allows a hero to make ranged and close combat attacks using a short spear or a spear, or to fight in close combat using a great spear."
        }
        ^"Swords"
        {
            WEAPONS [^"Sword", ^"Short Sword", ^"Long Sword"]
            DESCRIPTION "The sword with a straight blade has always been the weapon of choice among free Men and Elves. A mark of nobility or rank, swords of superior make are passed down by generations of warriors, and arms of ancient lineage are often imbued with spells and curses, the bane of the servants of the Shadow. Swords vary in size, shape, and quality as diverse as the folks that craft them. Many malevolent creatures have devised swords after their own fashion, usually crude counterfeits of those made by Men and Elves. The Swords Combat Proficiency enables a Player-hero to attack in close combat using short swords, swords, and long swords."
        }
    }
    # ─────────────────────────────────────────────
    # BRAWLING ATTACKS
    # ─────────────────────────────────────────────
    # Brawling is not a standard Combat Proficiency — it cannot be rated
    # or improved directly with Adventure Points. It functions as a derived
    # Combat Proficiency: always equal to the hero's highest standard
    # Combat Proficiency rank, but with a (1d) penalty.
    BRAWLING_ATTACKS {
        WEAPONS [^"Unarmed", ^"Dagger", ^"Cudgel", ^"Club"]
        DESCRIPTION "Adventurers who must leave behind their trusted weapons may find themselves forced to fight unarmed, or to rely on a simple dagger, or even a thrown stone. When this happens, they rely on their martial training to save themselves."
        RULE "Player-heroes performing an attack while unarmed, or using a dagger, club, or an improvised weapon, roll a number of dice equal to their highest Combat Proficiency, but suffer a disadvantage: they lose (1d)."
    }
    # ─────────────────────────────────────────────
    # JOURNEY ROLES
    # Assigned during Journeys; each uses a skill.
    # ─────────────────────────────────────────────
    # Guide is the only role that must be unique (exactly one per Company).
    # Look-out, Hunter, and Scout can be shared by multiple heroes.
    # One hero may cover multiple roles if the Company has fewer than four members.
    # Primary Skill is the skill tested when that role faces a journey event.
    # The Guide's skill (TRAVEL) is used for Marching Tests, not event resolution
    # (Guide does not appear in the Event Target table).
    ^"JourneyRole" DEF {
        PROPERTIES {
            ^"Primary Skill" STRING REQUIRED
            ^"Description" STRING
        }
    }
    ^"Guide" DEF {
        EXTENDS ^"JourneyRole"
        PROPERTIES {
            ^"Primary Skill" STRING "Travel" FIXED
            ^"Description" STRING "In charge of all decisions concerning route, rest, and supplies. Makes all Marching Tests rolling Travel at TN equal to the Guide's own Heart TN. Only one Guide is allowed per Company."
        }
    }
    ^"Hunter" DEF {
        EXTENDS ^"JourneyRole"
        PROPERTIES {
            ^"Primary Skill" STRING "Hunting" FIXED
            ^"Description" STRING "In charge of finding food in the wild. Faces journey events using Hunting."
        }
    }
    ^"Look-out" DEF {
        EXTENDS ^"JourneyRole"
        PROPERTIES {
            ^"Primary Skill" STRING "Awareness" FIXED
            ^"Description" STRING "In charge of keeping watch. Faces journey events using Awareness."
        }
    }
    ^"Scout" DEF {
        EXTENDS ^"JourneyRole"
        PROPERTIES {
            ^"Primary Skill" STRING "Explore" FIXED
            ^"Description" STRING "In charge of setting up camp and opening new trails. Faces journey events using Explore."
        }
    }
    # Council rules moved to tor2e-2e-core-council.ttrpg
    SPEC_VERSION "0.4"
    # ─────────────────────────────────────────────
    # BASE CULTURE TYPE
    # ─────────────────────────────────────────────
    ^"HeroicCulture" DEF {
        PROPERTIES {
            ^"Culture Name" STRING REQUIRED
            ^"Standard of Living" ENUM ["Poor", "Frugal", "Common", "Prosperous", "Rich", "Very Rich"] REQUIRED
            ^"Cultural Blessing Name" STRING REQUIRED
            ^"Cultural Blessing" STRING REQUIRED
            ^"Cultural Weakness" STRING
            ^"Languages" LIST OF STRING
            ^"Typical Names" DEF {
                ^"Male" LIST OF STRING
                ^"Female" LIST OF STRING
            }
        }
        # Attribute arrays: player chooses one set or rolls 1d6 to determine set.
        ATTRIBUTE_ARRAYS
        # Derived Stats: calculated from the chosen Attribute set.
        # Each culture defines its own base values in the formulas below.
        DERIVED_STATS {
            ^"Endurance"
            FORMULA "Strength + [culture base]"
            ^"Hope"
            FORMULA "Heart + [culture base]"
            ^"Parry"
            FORMULA "Wits + [culture base]"
        }
        # Starting Skills: each culture lists all 18 skills with starting ranks.
        # Two skills are marked as Favoured candidates; the player chooses one.
        STARTING_SKILLS
        # Starting Combat Proficiencies: culture-specific.
        STARTING_PROFICIENCIES
        # Distinctive Features: choose 2 from this list.
        DISTINCTIVE_FEATURES CHOOSE 2
        # Cultural Virtues available to this culture.
        CULTURAL_VIRTUES
    }
    # ─────────────────────────────────────────────
    # BARDINGS
    # ─────────────────────────────────────────────
    ^"Bardings" DEF {
        EXTENDS ^"HeroicCulture"
        PROPERTIES {
            ^"Culture Name" STRING "Bardings" FIXED
            ^"Standard of Living" STRING "Prosperous" FIXED
            ^"Cultural Blessing Name" STRING "Stout-hearted" FIXED
            ^"Cultural Blessing" STRING "VALOUR rolls are Favoured (roll two Feat Dice, keep best)." FIXED
            ^"Languages" LIST ["Dalish"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Aegir", "Arn", "Brandulf", "Domarr", "Egil", "Erland", "Farald", "Finn", "Gautarr", "Hafgrim", "Hjalmar", "Ingolf", "Jofur", "Kolbeinn", "Leiknir", "Lomund", "Munan", "Nari", "Nefstan", "Ottarr", "Ragnarr", "Reinald", "Sigmarr", "Steinarr", "Thorald", "Torwald", "Ulfarr", "Unnarr", "Vandil", "Varinn"] FIXED
                ^"Female" LIST ["Aldis", "Asfrid", "Bera", "Bergdis", "Dagmar", "Eilif", "Erna", "Frida", "Geira", "Gudrun", "Halla", "Hild", "Ingirun", "Ingrith", "Lif", "Linhild", "Kelda", "Runa", "Saldis", "Sigga", "Sigrun", "Thora", "Thordis", "Thorhild", "Ulfhild", "Ulfrun", "Una", "Valdis", "Vigdis", "Walda"] FIXED
            }
        }
        # Choose one set of Attributes, or roll 1d6 to determine set.
        ATTRIBUTE_ARRAYS {
            1
            : [STR 5, HEART 7, WITS 2]
            2
            : [STR 4, HEART 7, WITS 3]
            3
            : [STR 5, HEART 6, WITS 3]
            4
            : [STR 4, HEART 6, WITS 4]
            5
            : [STR 5, HEART 5, WITS 4]
            6
            : [STR 6, HEART 6, WITS 2]
        }
        DERIVED_STATS {
            ^"Endurance"
            FORMULA "Strength + 20"
            ^"Hope"
            FORMULA "Heart + 8"
            ^"Parry"
            FORMULA "Wits + 12"
        }
        # Copy listed ranks; choose one Favoured skill from the two marked [F].
        STARTING_SKILLS {
            ^"Awe"
            1 ^"Enhearten"
            2
            [F]  ^"Persuade"  3
            ^"Athletics"
            1
            [F] ^"Travel"   1       ^"Stealth"   0
            ^"Awareness"
            0 ^"Insight"
            2 ^"Scan"
            1 ^"Hunting"
            2 ^"Healing"
            0 ^"Explore"
            1 ^"Song"
            1 ^"Courtesy"
            2 ^"Riddle"
            0 ^"Craft"
            1 ^"Battle"
            2 ^"Lore"
            1
        }
        STARTING_PROFICIENCIES "Bows or Swords 2, any one other 1"
        DISTINCTIVE_FEATURES CHOOSE 2 ["Bold", "Eager", "Fair", "Fierce", "Generous", "Proud", "Tall", "Wilful"]
        CULTURAL_VIRTUES [^"Cram", ^"Dragon-slayer", ^"Dwarf-friend", ^"Fierce Shot", ^"Line of Girion", ^"Language of Birds"]
    }
    # ─────────────────────────────────────────────
    # DWARVES OF DURIN'S FOLK
    # ─────────────────────────────────────────────
    ^"Dwarves of Durin's Folk" DEF {
        EXTENDS ^"HeroicCulture"
        PROPERTIES {
            ^"Culture Name" STRING "Dwarves of Durin's Folk" FIXED
            ^"Standard of Living" STRING "Prosperous" FIXED
            ^"Cultural Blessing Name" STRING "Redoubtable" FIXED
            ^"Cultural Blessing" STRING "Halve the Load rating of any armour you're wearing (including helms, but not shields), rounding fractions up." FIXED
            ^"Cultural Weakness" STRING "NAUGRIM: Dwarven adventurers cannot use great bow, great spear, or great shield." FIXED
            ^"Languages" LIST ["Common Tongue", "Dwarvish (secret)"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Ai", "Anar", "Beli", "Bláin", "Borin", "Burin", "Bruni", "Farin", "Flói", "Frár", "Frerin", "Frór", "Ginar", "Gróin", "Grór", "Hanar", "Hepti", "Iari", "Lófar", "Lóni", "Náli", "Nár", "Niping", "Nói", "Núr", "Nýrád", "Ónar", "Póri", "Regin", "Svior", "Veig", "Vidar"] FIXED
                ^"Female" LIST ["Adís", "Afrid", "Agda", "Bersa", "Birna", "Dagrún", "Dís", "Drífa", "Edda", "Elin", "Fenja", "Frida", "Geira", "Gísla", "Hadda", "Hón", "Ida", "Ilmr", "Jóra", "Kára", "Kóna", "Líf", "Línhild", "Már", "Mist", "Nál", "Oda", "Ósk", "Rán", "Rinda", "Sefa", "Syn", "Tóra", "Trana", "Úlfrún", "Vírún", "Yrr"] FIXED
            }
        }
        # Choose one set of Attributes, or roll 1d6 to determine set.
        ATTRIBUTE_ARRAYS {
            1
            : [STR 7, HEART 2, WITS 5]
            2
            : [STR 7, HEART 3, WITS 4]
            3
            : [STR 6, HEART 3, WITS 5]
            4
            : [STR 6, HEART 4, WITS 4]
            5
            : [STR 5, HEART 4, WITS 5]
            6
            : [STR 6, HEART 2, WITS 6]
        }
        DERIVED_STATS {
            ^"Endurance"
            FORMULA "Strength + 22"
            ^"Hope"
            FORMULA "Heart + 8"
            ^"Parry"
            FORMULA "Wits + 10"
        }
        # Copy listed ranks; choose one Favoured skill from the two marked [F].
        STARTING_SKILLS {
            ^"Awe"
            2 ^"Enhearten"
            0 ^"Persuade"
            0 ^"Athletics"
            1 ^"Travel"
            3
            [F]   ^"Stealth"   0
            ^"Awareness"
            0 ^"Insight"
            0 ^"Scan"
            3 ^"Hunting"
            0 ^"Healing"
            0 ^"Explore"
            2 ^"Song"
            1 ^"Courtesy"
            1 ^"Riddle"
            2 ^"Craft"
            2
            [F] ^"Battle"   1       ^"Lore"      1
        }
        STARTING_PROFICIENCIES "Axes or Swords 2, choose one other Combat Proficiency 1"
        DISTINCTIVE_FEATURES CHOOSE 2 ["Cunning", "Fierce", "Lordly", "Proud", "Secretive", "Stern", "Wary", "Wilful"]
        CULTURAL_VIRTUES [^"Baruk Khazâd!", ^"Broken Spells", ^"Dark for Dark Business", ^"Durin's Way", ^"Stone-hard", ^"Untameable Spirit"]
    }
