            ^"Hope"
            FORMULA "Heart + 8"
            ^"Parry"
            FORMULA "Wits + 10"
        }
        # Copy listed ranks; choose one Favoured skill from the two marked [F].
        STARTING_SKILLS {
            ^"Awe"
            0 ^"Enhearten"
            1 ^"Persuade"
            0 ^"Athletics"
            2 ^"Travel"
            0 ^"Stealth"
            2 ^"Awareness"
            3 ^"Insight"
            0 ^"Scan"
            0 ^"Hunting"
            3
            [F] ^"Healing"  2 [F]   ^"Explore"   2
            ^"Song"
            1 ^"Courtesy"
            0 ^"Riddle"
            1 ^"Craft"
            1 ^"Battle"
            1 ^"Lore"
            0
        }
        STARTING_PROFICIENCIES "Axes or Bows 2, choose one other Combat Proficiency 1"
        DISTINCTIVE_FEATURES CHOOSE 2 ["Cunning", "Eager", "Faithful", "Patient", "Stern", "Swift", "True-hearted", "Wary"]
        CULTURAL_VIRTUES [^"A Hunter's Resolve", ^"Herbal Remedies", ^"Forest Harrier", ^"Hound of Mirkwood", ^"Natural Watchfulness", ^"Staunching Song"]
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — BEORNINGS
    # ─────────────────────────────────────────────
    ^"Beorn's Enchantment" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Beorn's Enchantment" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Beornings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Choose three STRENGTH Skills and mark them. Whenever you use any one of the three marked Skills, you can spend 1 Hope to achieve a Magical success." FIXED
        }
    }
    ^"Brother to Bears" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Brother to Bears" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Beornings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Endurance by 1 point. You don't lose (1d) on your Brawling attacks, and your unarmed attack rolls produce a Piercing Blow on a result of a Gandalf rune, with an Injury rating of 12. Additionally, you can communicate with bears by making appropriate Skill rolls, usually using COURTESY, PERSUADE, or SONG, to receive tidings, deliver messages, and so on." FIXED
        }
    }
    ^"Great Strength" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Great Strength" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Beornings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When inflicting Special Damage in combat, add +2 to your STRENGTH rating on a Heavy Blow." FIXED
        }
    }
    ^"Skin-Coat" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Skin-Coat" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Beornings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "If you wear a suit of Leather armour or no armour at all, you gain (1d) on your PROTECTION rolls." FIXED
        }
    }
    ^"Splitting Blow" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Splitting Blow" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Beornings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you score a Piercing Blow on a close combat attack, the PROTECTION roll of the target is Ill-favoured." FIXED
        }
    }
    ^"Twice-Baked Honey-Cakes" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Twice-Baked Honey-Cakes" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Beornings" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Each time you gain Fatigue from a Journey Event, you gain 1 point less. Additionally, raise your Company's Fellowship rating by 1 point." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — ELVES OF MIRKWOOD
    # ─────────────────────────────────────────────
    # Note: "Against the Unseen", "Deadly Archery", "Elvish Dreams", and
    # "Gleam of Wrath" are defined in tor2e-2e-core-virtues.ttrpg under
    # Elves of Lindon. These are shared across Elven cultures.
    ^"Elf-Lights" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Elf-Lights" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Elves of Mirkwood" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Spend 1 point of Hope to light a torch or lamp with magical flame. The Loremaster must choose a group of creatures among those observing the light whose total MIGHT score does not exceed your WISDOM rating — the selected creatures must draw near to the flame. You can control the light at will. If attacked, enemies standing by the light are surprised, won't be able to make opening volleys nor take actions in the first Close Quarters Round, and are temporarily confused and fight as if Weary for the first two rounds of combat." FIXED
        }
    }
    ^"Shots in the Dark" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Shots in the Dark" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Elves of Mirkwood" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "When you are in a forest, or at night, you are Inspired on all your combat rolls." FIXED
        }
    }
    # ─────────────────────────────────────────────
    # CULTURAL VIRTUES — WOODMEN OF WILDERLAND
    # ─────────────────────────────────────────────
    ^"A Hunter's Resolve" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "A Hunter's Resolve" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Woodmen of Wilderland" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "If you are not Wounded or Miserable, you can spend 1 Hope to recover a number of Endurance points equal to your HEART or VALOUR score, whichever is higher." FIXED
        }
    }
    ^"Herbal Remedies" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Herbal Remedies" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Woodmen of Wilderland" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "You gain (1d) on all your HEALING rolls. Additionally, at the end of a journey, you can roll HEALING to reduce your accumulated Fatigue (in addition to rolling TRAVEL to do so)." FIXED
        }
    }
    ^"Forest Harrier" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Forest Harrier" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Woodmen of Wilderland" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Your opening volleys and close combat attacks made during the first combat round of a battle are Favoured." FIXED
        }
    }
    ^"Hound of Mirkwood" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Hound of Mirkwood" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Woodmen of Wilderland" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "You have chosen a wolfhound of Wilderland to accompany you. When you make an AWARENESS or HUNTING roll you gain (1d) if the hound is with you. In combat, the hound counts as another Player-hero fighting in a Close Combat stance, and the first close combat attack aimed at you each round loses (1d). If you are hit by a Piercing Blow, you can choose to cancel it, wounding your hound instead. A wounded hound is out of combat for the remainder of a scene and returns at the start of the next session if you succeed in a HEALING roll. On a failure, the hound won't recover until the beginning of the next Adventuring Phase." FIXED
        }
    }
    ^"Natural Watchfulness" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Natural Watchfulness" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Woodmen of Wilderland" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Whenever you are making a roll using AWARENESS, EXPLORE, or SCAN, you can spend 1 Hope to achieve a Magical success. Also, you are allowed to cover the Look-out role in addition to any other role during a journey." FIXED
        }
    }
    ^"Staunching Song" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Name" STRING "Staunching Song" FIXED
            ^"Description" STRING FIXED
            ^"Culture" STRING "Woodmen of Wilderland" FIXED
            ^"Minimum Wisdom" INTEGER 2 FIXED
            ^"Effect" STRING "Raise your maximum Hope rating by 1 point. Additionally, you can roll SONG to administer First Aid or to save Dying heroes (in addition to rolling HEALING to do so)." FIXED
        }
    }
    SPEC_VERSION "0.4"
    # Source: Realms of the Three Rings supplement for The One Ring 2e.
    # Also incorporates content from the Rivendell supplement.
    # Adds two new Heroic Cultures: High Elves of Rivendell and
    # Elves of Lórien (Galadhrim).
    # ─────────────────────────────────────────────
    # HIGH ELVES OF RIVENDELL
    # ─────────────────────────────────────────────
    ^"High Elves of Rivendell" DEF {
        EXTENDS ^"HeroicCulture"
        # Source: Rivendell
        PROPERTIES {
            ^"Culture Name" STRING "High Elves of Rivendell" FIXED
            ^"Standard of Living" STRING "Prosperous" FIXED
            ^"Cultural Blessing Name" STRING "Elven-wise" FIXED
            ^"Cultural Blessing" STRING "Add 1 point to one Attribute of your choice. Additionally, if you are not Miserable, you can spend 1 point of Hope to achieve a Magical success on a skill roll." FIXED
            ^"Cultural Weakness" STRING "BESET BY WOE: You can remove accumulated Shadow points exclusively during a Yule Fellowship Phase." FIXED
            ^"Languages" LIST ["Sindarin", "Quenya (ceremony, song, and lore)"] FIXED
            ^"Typical Names" DEF {
                ^"Male" LIST ["Aegnor", "Beleg", "Celegorm", "Daeron", "Edrahil", "Fingon", "Finrod", "Gwindor", "Mablung", "Maeglin", "Orodreth", "Saeros"] FIXED
                ^"Female" LIST ["Amarië", "Ancalimë", "Berúthiel", "Celebrindal", "Elwing", "Finduilas", "Fíriel", "Idril", "Lothiriel", "Míriel", "Nimloth", "Nimrodel"] FIXED
            }
        }
        # Choose one set of Attributes, or roll 1d6 to determine set.
        # Note: Cultural Blessing adds +1 to one Attribute AFTER choosing a set.
        ATTRIBUTE_ARRAYS {
            1
            : [STR 5, HEART 2, WITS 7]
            2
            : [STR 4, HEART 3, WITS 7]
            3
            : [STR 5, HEART 3, WITS 6]
            4
            : [STR 4, HEART 4, WITS 6]
            5
            : [STR 5, HEART 4, WITS 5]
            6
            : [STR 6, HEART 2, WITS 6]
        }
        DERIVED_STATS {
            ^"Endurance"
            FORMULA "Strength + 22"
            ^"Hope"
            FORMULA "Heart + 6"
            ^"Parry"
            FORMULA "Wits + 12"
        }
        # Copy listed ranks; choose one Favoured skill from the two marked [F].
        STARTING_SKILLS {
            ^"Awe"
            2 ^"Enhearten"
            0 ^"Persuade"
            0 ^"Athletics"
            2 ^"Travel"
            1 ^"Stealth"
            0 ^"Awareness"
            2
            [F] ^"Insight"  0       ^"Scan"      0
            ^"Hunting"
            0 ^"Healing"
            2
            [F]   ^"Explore"   0
            ^"Song"
            2 ^"Courtesy"
            1 ^"Riddle"
            0 ^"Craft"
            2 ^"Battle"
            2 ^"Lore"
            3
        }
        STARTING_PROFICIENCIES "Spears or Swords 2, choose one other Combat Proficiency 1"
        DISTINCTIVE_FEATURES CHOOSE 2 ["Fair", "Keen-eyed", "Lordly", "Inquisitive", "Merry", "Proud", "Subtle", "Wilful"]
        # High Elves have access to Elves of Lindon cultural virtues
        # plus four additional unique virtues (8 total).
        CULTURAL_VIRTUES [^"Against the Unseen", ^"Deadly Archery", ^"Elvish Dreams", ^"Gleam of Wrath", ^"Artificer of Eregion", ^"Beauty of the Stars", ^"Might of the Firstborn", ^"Skill of the Eldar"]
    }
    # ─────────────────────────────────────────────
