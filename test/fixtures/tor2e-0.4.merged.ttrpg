    ^"Crown of Fornost" DEF {
        EXTENDS ^"WondrousItem"
        PROPERTIES {
            ^"Name" STRING "Crown of Fornost" FIXED
            ^"Description" STRING "A golden circlet worn by the rulers of Fornost Erain, Númenórean kings of Arnor. It carries the weight of that lost kingdom's authority." FIXED
            ^"Blessings" LIST ["Awe", "Persuade"] FIXED
            ^"Source" STRING "Lone-Lands Campaign" FIXED
        }
