            ^"Starting Range" STRING "Melee"
        }
        LEVEL_UP_OPTIONS {
            ^"Intelligent" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "Your companion gains a permanent +1 bonus to a Companion Experience of your choice."
            }
            ^"Light in the Dark" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "Use this as an additional Hope slot your character can mark."
            }
            ^"Creature Comfort" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "Once per rest, when you take time during a quiet moment to give your companion love and attention, you can gain a Hope or you can both clear a Stress."
            }
            ^"Armored" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "When your companion takes damage, you can **mark one of your Armor Slots** instead of marking one of their Stress."
            }
            ^"Vicious" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "Increase your companion’s damage dice or range by one step (d6 to d8, Close to Far, etc.)."
            }
            ^"Resilient" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "Your companion gains an additional Stress slot."
            }
            ^"Bonded" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "When you mark your last Hit Point, your companion rushes to your side to comfort you. Roll a number of **d6s** equal to the unmarked Stress slots they have and mark them. If any roll a 6, your companion helps you up. Clear your last Hit Point and return to the scene."
            }
            ^"Aware" DEF {
                EXTENDS ^"Companion Upgrade"
                ^"Description"
                STRING "Your companion gains a permanent +2 bonus to their Evasion."
            }
        }
    }
