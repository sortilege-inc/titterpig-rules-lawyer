                EXTENDS ^"Adversary Feature"
                ^"Type"
                STRING "Reaction"
                ^"Description"
                STRING "When the Ooze has 3 or more HP marked, you can **spend a Fear** to split them into two Tiny Green Oozes (with no marked HP or Stress). Immediately spotlight both of them."
            }
        }
