    #tFadsRQekIvmya6YdwMW3N9T ^"Acid Burrower" DEF {
        EXTENDS ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 1
            ^"Role" STRING "Solo"
            ^"Description" STRING "A horse-sized insect with digging claws and acidic blood."
            ^"Motives & Tactics" LIST ["Burrow", "drag away", "feed", "reposition"]
            ^"Difficulty" INTEGER 14
            ^"Damage Thresholds" DEF {
                ^"Major" INTEGER 8
                ^"Severe" INTEGER 15
            }
