BASE "daggerheart" {
    NAME "daggerheart — resolved composition"
    VERSION "0.4"
    # Generated by titterpig-synthesist from 14 source file(s).
    # Compiled artifact — do not edit; recompile from the composition manifest.
    SPEC_VERSION "0.4"
    # Core Book: Daggerheart Core Rulebook (Darrington Press, 2025-05-20).
    # A d12 Duality-Dice game: roll 2d12 (a Hope die + a Fear die) + a trait
    # modifier vs a Difficulty. This file defines the actor types and the base
    # framework types that the content files (ancestries, communities, classes,
    # domains, adversaries, ...) EXTEND. Sourcebook content lives in sibling files.
    # ============================================================
    # CORE VOCABULARY — TRAITS
    # ============================================================
    #daggerheartTrait00000000000001 ^"Trait" DEF {
        # The six character traits. An action roll adds the relevant trait
        # modifier to the Duality Dice total. Starting spread at character
        # creation is +2, +1, +1, +0, +0, -1 (a soft guideline, not a bound).
        ENUM ["Agility", "Strength", "Finesse", "Instinct", "Presence", "Knowledge"]
        DESCRIPTION "Agility: Sprint, Leap, Maneuver.
            Strength: Lift, Smash, Grapple.
            Finesse: Control, Hide, Tinker.
            Instinct: Perceive, Sense, Navigate.
            Presence: Charm, Perform, Deceive.
            Knowledge: Recall, Analyze, Comprehend."
    }
    # ============================================================
    # CORE RESOLUTION — DUALITY DICE
    # ============================================================
    #daggerheartActionRoll000000001 ^"Action Roll" DEF {
        # The core mechanic. Roll the two Duality Dice (a Hope Die and a Fear
        # Die, both d12) and add the relevant ^"Trait" modifier and any other
        # bonuses, comparing the total to a Difficulty. The higher single die
        # colors the result with Hope or with Fear regardless of success.
        OUTCOMES {
            "Critical Success"
            "The two Duality Dice show matching values. You automatically succeed with Hope, gain a Hope, and clear a Stress."
            "Success with Hope"
            "Total meets or beats the Difficulty and the Hope Die is higher. You succeed and gain a Hope."
            "Success with Fear"
            "Total meets or beats the Difficulty and the Fear Die is higher. You succeed, but the GM gains a Fear."
            "Failure with Hope"
            "Total is under the Difficulty and the Hope Die is higher. You fail, but gain a Hope."
            "Failure with Fear"
            "Total is under the Difficulty and the Fear Die is higher. You fail, and the GM gains a Fear."
        }
    }
    #daggerheartDifficulty000000001 ^"Difficulty" DEF {
        # The target number an ^"Action Roll" must meet or beat. Set by the GM
        # (or an adversary/environment stat block) for the situation.
        INTEGER MIN 1
    }
    #daggerheartProficiency00000001 ^"Proficiency" DEF {
        # Multiplier for the number of damage dice a weapon rolls. Rises by tier
        # as a character levels up. Starts at 1.
        INTEGER MIN 1 DEFAULT 1
    }
    # ============================================================
    # RANGE, REST, DEATH & TIERS (Chapter 2 core mechanics)
    # ============================================================
    #daggerheartRange00000000001 ^"Range" DEF {
        # A range band. Most distance in Daggerheart is measured by range rather
        # than exact units. Ordered nearest-to-farthest. (See daggerheart-0.4-core-mechanics.)
        PROPERTIES {
            ^"Order" INTEGER MIN 0
            ^"Description" STRING
        }
    }
    #daggerheartDowntimeMove00001 ^"Downtime Move" DEF {
        # A move a PC can make during a short or long rest.
        PROPERTIES {
            ^"Rest Type" ENUM ["Short Rest", "Long Rest"]
            ^"Description" STRING
        }
    }
    #daggerheartDeathMove00000001 ^"Death Move" DEF {
        # An option a player chooses when their character makes a death move
        # (Blaze of Glory, Avoid Death, Risk It All).
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartTierOfPlay0000001 ^"Tier Of Play" DEF {
        # One of the four tiers of play, spanning a range of levels.
        PROPERTIES {
            ^"Tier" INTEGER MIN 1 MAX 4
            ^"Minimum Level" INTEGER MIN 1 MAX 10
            ^"Maximum Level" INTEGER MIN 1 MAX 10
        }
    }
    # ============================================================
    # DAMAGE, THRESHOLDS & CONDITIONS
    # ============================================================
    #daggerheartDamageThresholds001 ^"Damage Thresholds" DEF {
        # Incoming damage is compared to two thresholds to determine how many
        # Hit Points are marked: below Major marks 1 HP; at or above Major marks
        # 2 HP; at or above Severe marks 3 HP. (Damage that meets or exceeds
        # double the Severe threshold marks 4 HP.)
        PROPERTIES {
            ^"Major" INTEGER MIN 0
            ^"Severe" INTEGER MIN 0
        }
    }
    #daggerheartCondition0000000001 ^"Condition" DEF {
        # The three core conditions. Other temporary effects are described in
        # the features that grant them.
        ENUM ["Hidden", "Restrained", "Vulnerable"]
        DESCRIPTION "Hidden: While Hidden, any rolls against you have disadvantage; you leave Hidden once an adversary would reasonably find you or you move into their line of sight.
            Restrained: While Restrained, you can't move, but you can still act.
            Vulnerable: While Vulnerable, any roll made against you has advantage."
    }
    # ============================================================
    # ACTOR HIERARCHY
    # ============================================================
    #daggerheartEntity000000000001 ACTOR "Entity" DEF {
        # Root of all actor types.
        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
        }
    }
    #daggerheartCharacter000000001 ACTOR "Character" DEF {
        EXTENDS #daggerheartEntity000000000001 ^"Entity"
        # A player character. Built from a ^"Class" (with a ^"Subclass"), an
        # ^"Ancestry", and a ^"Community", drawing cards from two ^"Domain"s.
        PROPERTIES {
            ^"Level" INTEGER MIN 1 MAX 10 DEFAULT 1
            ^"Traits" DEF {
                ^"Agility" INTEGER DEFAULT 0
                ^"Strength" INTEGER DEFAULT 0
                ^"Finesse" INTEGER DEFAULT 0
                ^"Instinct" INTEGER DEFAULT 0
                ^"Presence" INTEGER DEFAULT 0
                ^"Knowledge" INTEGER DEFAULT 0
            }
            ^"Class" ^"Class"
            ^"Subclass" ^"Subclass"
            ^"Ancestry" ^"Ancestry"
            ^"Community" ^"Community"
            ^"Evasion" INTEGER MIN 0
            ^"Hit Points" INTEGER MIN 0
            ^"Marked HP" INTEGER MIN 0 DEFAULT 0
            ^"Stress" INTEGER MIN 0
            ^"Marked Stress" INTEGER MIN 0 DEFAULT 0
            ^"Hope" INTEGER MIN 0 MAX 6 DEFAULT 2
            ^"Proficiency" ^"Proficiency"
            ^"Damage Thresholds" ^"Damage Thresholds"
            ^"Armor Score" INTEGER MIN 0 DEFAULT 0
            ^"Conditions" LIST OF ^"Condition"
            ^"Experiences" LIST OF STRING
        }
        RULES {
            #daggerheartRuleActionRoll0001: WHEN [^"Character" makes an ^"Action Roll"] THEN roll 2d12 (Hope + Fear) + the relevant ^"Trait" modifier vs a ^"Difficulty"
            #daggerheartRuleDamage00000001: WHEN [^"Character" takes damage] THEN compare the damage to ^"Damage Thresholds" to mark 1, 2, or 3 Hit Points
        }
    }
    #daggerheartAdversary000000001 ACTOR "Adversary" DEF {
        EXTENDS #daggerheartEntity000000000001 ^"Entity"
        # A GM-run threat with a tier, a role, a Difficulty, thresholds, HP,
        # Stress, a standard attack, experiences, and features. Individual stat
        # blocks EXTEND this type (see daggerheart-0.4-adversaries.ttrpg); their standard
        # attack, experiences, and features render as ATTACK / EXPERIENCES /
        # FEATURES sub-blocks.
        PROPERTIES {
            ^"Tier" INTEGER MIN 1 MAX 4
            ^"Role" STRING
            ^"Description" STRING
            ^"Motives & Tactics" LIST OF STRING
            ^"Difficulty" INTEGER MIN 0
            ^"Damage Thresholds" ^"Damage Thresholds"   # omitted for Minions ("None")
            ^"Hit Points" INTEGER MIN 0
            ^"Stress" INTEGER MIN 0
            ^"Attack Modifier" INTEGER
        }
    }
    #daggerheartAdvFeature00000001 ^"Adversary Feature" DEF {
        # A named adversary feature. Type is Passive, Action, or Reaction.
        PROPERTIES {
            ^"Type" STRING
            ^"Description" STRING
        }
    }
    #daggerheartEnvironment0000001 ACTOR "Environment" DEF {
        EXTENDS #daggerheartEntity000000000001 ^"Entity"
        # A GM-run scene/location: a tier, a category (Exploration/Event/Social/
        # Traversal), a Difficulty, guiding impulses, potential adversaries, and
        # features. Individual environments EXTEND this type (see
        # daggerheart-0.4-environments.ttrpg); features render as a FEATURES sub-block.
        PROPERTIES {
            ^"Tier" INTEGER MIN 1 MAX 4
            ^"Category" ENUM ["Exploration", "Event", "Social", "Traversal"]
            ^"Description" STRING
            ^"Impulses" LIST OF STRING
            ^"Difficulty" STRING
        }
    }
    #daggerheartEnvFeature00000001 ^"Environment Feature" DEF {
        # A named environment feature. Type is Passive, Action, or Reaction.
        PROPERTIES {
            ^"Type" STRING
            ^"Description" STRING
        }
    }
    # ============================================================
    # CHARACTER-BUILD FRAMEWORK TYPES (content files EXTEND these)
    # ============================================================
    #daggerheartAncestry0000000001 ^"Ancestry" DEF {
        APPLIES TO [^"Character"]
        # A character's lineage, affecting physical appearance. Each ancestry
        # grants exactly two ancestry features (see the FEATURES sub-block on
        # each ancestry instance). Individual ancestries EXTEND this type and
        # supply a ^"Description" and their features.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartAncestryFeature001 ^"Ancestry Feature" DEF {
        # One of an ancestry's two features: a named rules widget. Rendered as a
        # nested DEF in an ancestry's FEATURES sub-block.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartCommunity00000001 ^"Community" DEF {
        APPLIES TO [^"Character"]
        # The culture or environment a character grew up in. Each community
        # grants one community feature and suggests six descriptive adjectives.
        # Individual communities EXTEND this type.
        PROPERTIES {
            ^"Description" STRING
            ^"Adjectives" LIST OF STRING
        }
    }
    #daggerheartCommunityFeature01 ^"Community Feature" DEF {
        # A community's single feature: a named rules widget. Rendered as a
        # nested DEF in a community's FEATURES sub-block.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartClass000000000001 ^"Class" DEF {
        APPLIES TO [^"Character"]
        # A character class (Bard, Druid, Guardian, ...). Grants two class
        # domains, a starting Evasion and Hit Points, starter class items, a
        # Hope feature (a 3-Hope signature move), and class features. Individual
        # classes EXTEND this type (see daggerheart-0.4-classes.ttrpg); their Hope
        # feature and class features render as nested DEFs in a FEATURES block.
        PROPERTIES {
            ^"Description" STRING
            ^"Domains" LIST OF ^"Domain"
            ^"Starting Evasion" INTEGER MIN 0
            ^"Starting Hit Points" INTEGER MIN 0
            ^"Class Items" STRING
        }
    }
    #daggerheartClassFeature00001 ^"Class Feature" DEF {
        # A named class feature (or the class's Hope feature). Rendered as a
        # nested DEF in a class's FEATURES sub-block.
        PROPERTIES {
            ^"Description" STRING
            ^"Hope Cost" INTEGER MIN 0
        }
    }
    #daggerheartSubclass000000001 ^"Subclass" DEF {
        APPLIES TO [^"Character"]
        # A specialization within a ^"Class". Grants a Spellcast trait (for
        # spellcasters) and three tiers of features: Foundation (starting),
        # Specialization (mid), and Mastery (high). Individual subclasses EXTEND
        # this type (see daggerheart-0.4-classes.ttrpg); their features render as nested
        # DEFs in FOUNDATION/SPECIALIZATION/MASTERY sub-blocks.
        PROPERTIES {
            ^"Class" ^"Class"                   # the parent class
            ^"Description" STRING
            ^"Spellcast Trait" STRING
        }
    }
    #daggerheartSubclassFeature01 ^"Subclass Feature" DEF {
        # A named subclass feature (Foundation, Specialization, or Mastery tier).
        # Rendered as a nested DEF in a subclass's feature sub-blocks.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartBeastform00000001 ^"Beastform" DEF {
        # A Druid Beastform option: a creature category the Druid's "Beastform"
        # feature lets them transform into (of their tier or lower). While
        # transformed they gain the form's Evasion bonus, trait bonus, attack,
        # advantages, and features. Individual forms EXTEND this type (see
        # daggerheart-0.4-druid-beastform.ttrpg). Attack and Trait Bonus render as nested
        # DEF properties; features render in a FEATURES sub-block.
        PROPERTIES {
            ^"Tier" INTEGER MIN 1 MAX 4
            ^"Examples" LIST OF STRING
            ^"Evasion Bonus" INTEGER
            ^"Advantages" LIST OF STRING
        }
    }
    #daggerheartBeastformFeature1 ^"Beastform Feature" DEF {
        # A named feature of a Beastform option.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartRangerCompanion01 ^"Ranger Companion" DEF {
        # The Beastbound Ranger's animal companion. Holds the companion's
        # starting statistics and its level-up options (in a LEVEL_UP_OPTIONS
        # sub-block on the instance); the full companion-creation and play rules
        # are in daggerheart-0.4-ranger-companion.lore.
        PROPERTIES {
            ^"Starting Evasion" INTEGER
            ^"Starting Experiences" DEF {
                ^"Count" INTEGER
                ^"Value" INTEGER
            }
            ^"Starting Damage Die" STRING
            ^"Starting Range" STRING
        }
    }
    #daggerheartCompanionUpgrade1 ^"Companion Upgrade" DEF {
        # A level-up option a Ranger can choose for their companion.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartDomain00000000001 ^"Domain" DEF {
        # One of the nine domains (Arcana, Blade, Bone, Codex, Grace, Midnight,
        # Sage, Splendor, Valor) — a core theme. Each class draws on two domains;
        # a character takes ^"Domain Card"s from their class's two domains as they
        # level. Individual domains EXTEND this type (see daggerheart-0.4-domains.ttrpg).
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartDomainCard0000001 ^"Domain Card" DEF {
        # A domain card: a Spell, Ability, or Grimoire (Codex's spellbook cards)
        # that a character can hold in their loadout or vault. Each card belongs
        # to one ^"Domain" and a domain level (1-10, gating when it can be taken),
        # and has a Recall Cost (the Stress to swap it out of the vault into the
        # loadout). Individual cards EXTEND this type (see daggerheart-0.4-domain-cards.ttrpg).
        PROPERTIES {
            ^"Domain" ^"Domain"
            ^"Domain Level" INTEGER MIN 1 MAX 10
            ^"Type" ENUM ["Spell", "Ability", "Grimoire"]
            ^"Recall Cost" INTEGER MIN 0
            ^"Description" STRING
        }
    }
    # ============================================================
    # EQUIPMENT
    # ============================================================
    #daggerheartWeapon00000000001 ^"Weapon" DEF {
        # A weapon from the weapon tables. Primary weapons are a character's
        # main arm; Secondary weapons augment them. Tier gates when it can be
        # acquired. Individual weapons EXTEND this type (see daggerheart-0.4-equipment.ttrpg).
        PROPERTIES {
            ^"Category" ENUM ["Primary", "Secondary"]
            ^"Tier" INTEGER MIN 1 MAX 4
            ^"Trait" STRING
            ^"Range" STRING
            ^"Damage" STRING
            ^"Damage Type" ENUM ["Physical", "Magic"]
            ^"Burden" STRING
            ^"Feature" STRING
        }
    }
    #daggerheartArmor000000000001 ^"Armor" DEF {
        # Armor from the armor tables. Sets base damage thresholds and a base
        # Armor Score. Individual armors EXTEND this type.
        PROPERTIES {
            ^"Tier" INTEGER MIN 1 MAX 4
            ^"Base Thresholds" ^"Damage Thresholds"
            ^"Base Score" INTEGER MIN 0
            ^"Feature" STRING
        }
    }
    #daggerheartLoot000000000001 ^"Loot" DEF {
        # A loot result (an Item or a Consumable) from the loot roll tables.
        # Individual loot entries EXTEND this type (see daggerheart-0.4-loot.ttrpg).
        PROPERTIES {
            ^"Kind" ENUM ["Item", "Consumable"]
            ^"Roll" STRING
            ^"Description" STRING
        }
    }
    # ============================================================
    # CAMPAIGN FRAMES
    # ============================================================
    #daggerheartCampaignFrame0001 ^"Campaign Frame" DEF {
        # A campaign frame: a ready-to-run setting/premise (The Witherwild, Five
        # Banners Burning, ...). This type holds the structured "frame card"
        # metadata; each frame's full narrative content (Overview, Distinctions,
        # Principles, Inciting Incident, Campaign Mechanics, Session Zero
        # Questions) lives in the companion daggerheart-0.4-campaign-frames.lore. Individual
        # frames EXTEND this type (see daggerheart-0.4-campaign-frames.ttrpg).
        PROPERTIES {
            ^"Tagline" STRING
            ^"Designers" STRING
            ^"Complexity Rating" INTEGER MIN 1 MAX 3
            ^"Pitch" STRING
            ^"Tone & Feel" LIST OF STRING
            ^"Themes" LIST OF STRING
            ^"Touchstones" LIST OF STRING
            ^"Session Zero Questions" LIST OF STRING
        }
        # Player and GM principles render as PLAYER_PRINCIPLES / GM_PRINCIPLES
        # sub-blocks of ^"Frame Principle" DEFs on each frame instance.
    }
    #daggerheartFramePrinciple001 ^"Frame Principle" DEF {
        # A named player or GM principle guiding play of a campaign frame.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    #daggerheartFrameMechanic0001 ^"Frame Mechanic" DEF {
        # A named campaign mechanic specific to a frame (e.g. "Corruption from
        # the Witherwild"). The summary is captured here; the full rules — with
        # any tables or sub-rules — live in the frame's .lore.
        PROPERTIES {
            ^"Description" STRING
        }
    }
    SPEC_VERSION "0.4"
    #daggerheartcmRange0000000000 ^"Melee" DEF {
        EXTENDS ^"Range"
        PROPERTIES {
            ^"Order" INTEGER 0
            ^"Description" STRING "Your character is within touching distance of the target. A PC can touch targets up to a few feet away from them. Keep in mind that Melee range might be greater for especially large NPCs."
        }
    }
    #daggerheartcmRange0100000000 ^"Very Close" DEF {
        EXTENDS ^"Range"
        PROPERTIES {
            ^"Order" INTEGER 1
            ^"Description" STRING "Your character is very close to a target, able to see their fine details, and can reach them within moments. This is about 5–10 feet away. While in danger, a character can move into Melee range with anything that’s within Very Close range of them as part of their action. *Anything on a * *battle map that is within the shortest length of a game card * *(2–3­ inches) can usually be considered within Very Close * *range.*"
        }
    }
    #daggerheartcmRange0200000000 ^"Close" DEF {
        EXTENDS ^"Range"
        PROPERTIES {
            ^"Order" INTEGER 2
            ^"Description" STRING "Your character is close enough to a target to see their prominent details, such as across a room or in a neighboring market stall. This is about 10–30 feet away. While in danger, a character can move into Melee range with anything that’s within Close range of them as part of their action. *Anything on a battle map that is within the * *length of a standard pen or pencil (5–6 inches) can usually be * *considered within Close range.*"
        }
    }
    #daggerheartcmRange0300000000 ^"Far" DEF {
        EXTENDS ^"Range"
        PROPERTIES {
            ^"Order" INTEGER 3
            ^"Description" STRING "Your character is far enough away that they can see the appearance of a target, but not in detail, such as across a small battlefield or down a large corridor. This is about 30–100 feet away. While a character is in danger, the GM might call for them to make an Agility Roll to safely move into Melee range with something that’s within Far range of them. *Anything on a battle map that is within the length of * *the long edge of a standard piece of paper (11–12 inches) * *can usually be considered within Far range.*"
        }
    }
    #daggerheartcmRange0400000000 ^"Very Far" DEF {
        EXTENDS ^"Range"
        PROPERTIES {
            ^"Order" INTEGER 4
            ^"Description" STRING "Your character is very far away, such as across a large battlefield or down a long street, and while they might be able to see the shape of a person or object, they likely can’t make out any details. This is about 100–300 feet away. While a character is in danger, the GM might call for them to make an Agility Roll to safely move into Melee range with something that’s within Very Far range of them. *Anything on a battle map that is beyond Far range, but still * *within the bounds of the conflict or scene, can usually be * *considered within Very Far range.*"
        }
    }
    #daggerheartcmRange0500000000 ^"Out of Range" DEF {
        EXTENDS ^"Range"
        PROPERTIES {
            ^"Order" INTEGER 5
            ^"Description" STRING "Anything beyond a character’s Very Far range is Out of Range and usually can’t be targeted."
        }
    }
    #daggerheartcmDown00000000000 ^"Tend to Wounds" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Short Rest"
            ^"Description" STRING "Describe how you hastily patch yourself up, then clear a number of Hit Points equal to 1d4 + your tier. You can do this to an ally instead."
        }
    }
    #daggerheartcmDown01000000000 ^"Clear Stress" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Short Rest"
            ^"Description" STRING "Describe how you blow off steam or pull yourself together, then clear a number of Stress equal to 1d4 + your tier."
        }
    }
    #daggerheartcmDown02000000000 ^"Repair Armor" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Short Rest"
            ^"Description" STRING "Describe how you quickly repair your armor, then clear a number of Armor Slots equal to 1d4 + your tier. You can do this to an ally’s armor instead."
        }
    }
    #daggerheartcmDown03000000000 ^"Prepare (Short Rest)" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Short Rest"
            ^"Description" STRING "Describe how you prepare yourself for the path ahead, then gain a Hope. If you choose to Prepare with one or more members of your party, you each gain 2 Hope."
        }
    }
    #daggerheartcmDown04000000000 ^"Tend to All Wounds" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Long Rest"
            ^"Description" STRING "Describe how you patch yourself up, then clear all Hit Points. You can do this to an ally instead."
        }
    }
    #daggerheartcmDown05000000000 ^"Clear All Stress" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Long Rest"
            ^"Description" STRING "Describe how you blow off steam or pull yourself together, then clear all Stress."
        }
    }
    #daggerheartcmDown06000000000 ^"Repair All Armor" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Long Rest"
            ^"Description" STRING "Describe how you spend time repairing your armor, then clear all Armor Slots. You can do this to an ally’s armor instead."
        }
    }
    #daggerheartcmDown07000000000 ^"Prepare (Long Rest)" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Long Rest"
            ^"Description" STRING "Describe how you prepare for the next day’s adventure, then gain a Hope. If you choose to Prepare with one or more members of your party, you each gain 2 Hope."
        }
    }
    #daggerheartcmDown08000000000 ^"Work on a Project" DEF {
        EXTENDS ^"Downtime Move"
        PROPERTIES {
            ^"Rest Type" STRING "Long Rest"
            ^"Description" STRING "Establish or continue work on a project (see the following “Working on a Project in Downtime” section)."
        }
    }
    #daggerheartcmDeath0000000000 ^"Blaze of Glory" DEF {
        EXTENDS ^"Death Move"
        PROPERTIES {
            ^"Description" STRING "Your character embraces death and goes out in a blaze of glory. Take one action (at the GM’s discretion), which critically succeeds, then cross through the veil of death."
        }
    }
    #daggerheartcmDeath0100000000 ^"Avoid Death" DEF {
        EXTENDS ^"Death Move"
        PROPERTIES {
            ^"Description" STRING "Your character avoids death and faces the consequences. They temporarily drop unconscious, and then you work with the GM to describe how the situation worsens. Your character can’t move or act while unconscious, they can’t be targeted by an attack, and they return to consciousness when an ally clears 1 or more of their marked Hit Points or when the party finishes a long rest. After your character falls unconscious, roll your Hope Die. If its value is equal to or under your character’s level, they gain a scar (see the following “Scars” section)."
        }
    }
    #daggerheartcmDeath0200000000 ^"Risk It All" DEF {
        EXTENDS ^"Death Move"
        PROPERTIES {
            ^"Description" STRING "Roll your Duality Dice. If the Hope Die is higher, your character stays on their feet and clears an amount of Hit Points or Stress equal to the value of the Hope Die (divide the Hope Die value between Hit Points and Stress however you’d prefer). If the Fear Die is higher, your character crosses through the veil of death. If you critically succeed, your character stays up and clears all Hit Points and Stress."
        }
    }
    #daggerheartcmTier10000000000000 ^"Tier 1" DEF {
        EXTENDS ^"Tier Of Play"
        PROPERTIES {
            ^"Tier" INTEGER 1
            ^"Minimum Level" INTEGER 1
            ^"Maximum Level" INTEGER 1
        }
    }
    #daggerheartcmTier20000000000000 ^"Tier 2" DEF {
        EXTENDS ^"Tier Of Play"
        PROPERTIES {
            ^"Tier" INTEGER 2
            ^"Minimum Level" INTEGER 2
            ^"Maximum Level" INTEGER 4
        }
    }
    #daggerheartcmTier30000000000000 ^"Tier 3" DEF {
        EXTENDS ^"Tier Of Play"
        PROPERTIES {
            ^"Tier" INTEGER 3
            ^"Minimum Level" INTEGER 5
            ^"Maximum Level" INTEGER 7
        }
    }
    #daggerheartcmTier40000000000000 ^"Tier 4" DEF {
        EXTENDS ^"Tier Of Play"
        PROPERTIES {
            ^"Tier" INTEGER 4
            ^"Minimum Level" INTEGER 8
            ^"Maximum Level" INTEGER 10
        }
    }
    SPEC_VERSION "0.4"
    #tu5twuDzDWTRDecz1APzcdqM ^"Arcana" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Arcana is the domain of innate and instinctual magic. Those who choose this path tap into the raw, enigmatic forces of the realms to manipulate both their own energy and the elements. Arcana offers wielders a volatile power, but it is incredibly potent when correctly channeled."
        }
    }
    #tC9S4skGlLtk253DCYgkOlOI ^"Grace" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Grace is the domain of charisma. Through rapturous storytelling, charming spells, or a shroud of lies, those who channel this power define the realities of their adversaries, bending perception to their will. Grace offers its wielders raw magnetism and mastery over language."
        }
    }
    #tdzXLr3Xz8ftfy54rxEpPfkK ^"Blade" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Blade is the domain of weapon mastery. Whether by steel, bow, or perhaps a more specialized arm, those who follow this path have the skill to cut short the lives of others. Wielders of Blade dedicate themselves to achieving inexorable power over death."
        }
    }
    #tPNqoo93BXAvMH6FQhwHukMP ^"Midnight" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Midnight is the domain of shadows and secrecy. Whether by clever tricks, deft magic, or the cloak of night, those who channel these forces practice the art of obscurity and can uncover sequestered treasures. Midnight offers practitioners the power to control and create enigmas."
        }
    }
    #tDsEd8c69fffSsULDA5HOcLV ^"Bone" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Bone is the domain of tactics and the body. Practitioners of this domain have an uncanny control over their own physical abilities and an eye for predicting the behaviors of others in combat. Adherents to Bone gain an unparalleled understanding of bodies and their movements."
        }
    }
    #t3KZ2wBcoWJe3GhDpXW20cNR ^"Sage" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Sage is the domain of the natural world. Those who walk this path tap into the unfettered power of the earth and its creatures to unleash raw magic. Sage grants its adherents the vitality of a blooming flower and the ferocity of a ravenous predator."
        }
    }
    #tUsou5TRL5DtEa0DXMKC0Msy ^"Codex" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Codex is the domain of intensive magical study. Those who seek magical knowledge turn to the equations of power recorded in books, written on scrolls, etched into walls, or tattooed on bodies. Codex offers a commanding and versatile understanding of magic to devotees who pursue knowledge beyond the boundaries of common wisdom."
        }
    }
    #tH64AzlE0K71HvsIHY1MiOzP ^"Splendor" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Splendor is the domain of life. Through this magic, followers gain the ability to heal and, to an extent, control death. Splendor offers its disciples the magnificent ability to both give and end life."
        }
    }
    #tB7ZQjAeGl6YazECH2DGoABg ^"Valor" DEF {
        EXTENDS ^"Domain"
        PROPERTIES {
            ^"Description" STRING "Valor is the domain of protection. Whether through attack or defense, those who choose this discipline channel formidable strength to protect their allies in battle. Valor offers great power to those who raise their shields in defense of others."
        }
    }
    SPEC_VERSION "0.4"
