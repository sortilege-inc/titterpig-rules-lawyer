            ^"Examples" LIST ["Upgraded Tier 1 or Tier 2 Options"]
        }
        FEATURES {
            ^"Evolved" DEF {
                EXTENDS ^"Beastform Feature"
                ^"Description"
                STRING "Pick a Tier 1 or Tier 2 Beastform option and become a larger, more powerful version of that creature. While you’re in this form, you retain all traits and features from the original form and gain the the following bonuses:

• A +9 bonus to damage rolls

• A +2 bonus to the trait used by this form

• A +3 bonus to Evasion

• Your damage die increases by one size (d6 becomes d8, d8 becomes d10, etc.)"
            }
        }
    }
