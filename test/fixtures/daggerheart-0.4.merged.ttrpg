                EXTENDS ^"Environment Feature"
                ^"Type"
                STRING "Passive"
                ^"Description"
                STRING "The Difficulty of this environment equals that of the adversary with the highest Difficulty. *Who cues the ambush? What makes it clear they’re in charge?*"
            }
            ^"Surprise!" DEF {
                EXTENDS ^"Environment Feature"
                ^"Type"
                STRING "Action"
                ^"Description"
                STRING "The ambushers reveal themselves to the party, you gain 2 Fear, and the spotlight immediately shifts to one of the ambushing adversaries. *What do the ambushers want from the party? How do their tactics in * *the ambush reﬂ ect that? *"
            }
        }
    }
    #t8Isw9vRMej5R36RTzbj94aV ^"Ambushers" DEF {
        EXTENDS ^"Environment"
        PROPERTIES {
            ^"Tier" INTEGER 1
            ^"Category" STRING "Event"
            ^"Description" STRING "An ambush is set by the PCs to catch unsuspecting adversaries * *off -guard."
            ^"Impulses" LIST ["Escape", "group up", "protect the most vulnerable"]
            ^"Difficulty" STRING "Special (see “Relative Strength”)"
        }
        POTENTIAL_ADVERSARIES {
