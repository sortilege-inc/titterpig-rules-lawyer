        }
        ATTACK {
            ^"Claws" DEF {
                ^"Range"
                STRING "Very Close"
                ^"Damage"
                STRING "1d12+2 phy"
            }
        }
        EXPERIENCES {
            ^"Tremor Sense"
            INTEGER 2
        }
        FEATURES {
            ^"Relentless (3)" DEF {
                EXTENDS ^"Adversary Feature"
                ^"Type"
                STRING "Passive"
                ^"Description"
                STRING "The Burrower can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
            }
            ^"Earth Eruption" DEF {
                EXTENDS ^"Adversary Feature"
                ^"Type"
                STRING "Action"
                ^"Description"
                STRING "**Mark a Stress** to have the Burrower burst out of the ground. All creatures within Very Close range must succeed on an Agility Reaction Roll or be knocked over, making them *Vulnerable* until they next act."
            }
            ^"Spit Acid" DEF {
                EXTENDS ^"Adversary Feature"
                ^"Type"
                STRING "Action"
                ^"Description"
                STRING "Make an attack against all targets in front of the Burrower within Close range. Targets the Burrower succeeds against take **2d6** physical damage and must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage). If they can’t mark an Armor Slot, they must mark an additional HP and you gain a Fear."
            }
            ^"Acid Bath" DEF {
                EXTENDS ^"Adversary Feature"
                ^"Type"
                STRING "Reaction"
                ^"Description"
                STRING "When the Burrower takes Severe damage, all creatures within Close range are bathed in their acidic blood, taking **1d10 **physical damage. This splash covers the ground within Very Close range with blood, and all creatures other than the Burrower who move through it take **1d6** physical damage."
            }
        }
    }
