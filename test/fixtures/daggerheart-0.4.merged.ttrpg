    SPEC_VERSION "0.4"
    #tueGL6CbkXoiwOlvPQ6dcoCh ^"Abandoned Grove" DEF {
        EXTENDS ^"Environment"
        PROPERTIES {
            ^"Tier" INTEGER 1
            ^"Category" STRING "Exploration"
            ^"Description" STRING "A former druidic grove lying fallow and fully reclaimed by nature."
            ^"Impulses" LIST ["Draw in the curious", "echo the past"]
            ^"Difficulty" STRING "11"
        }
        POTENTIAL_ADVERSARIES {
            ^"Beasts"
            LIST ["Bear", "Dire Wolf", "Glass Snake"]
            ^"Grove Guardians"
            LIST ["Minor Treant", "Sylvan Soldier", "Young Dryad"]
        }
        FEATURES {
            ^"Overgrown Battlefield" DEF {
                EXTENDS ^"Environment Feature"
                ^"Type"
                STRING "Passive"
                ^"Description"
                STRING "There has been a battle here. A PC can make an Instinct Roll to identify evidence of that fight. On a success with Hope, learn all three pieces of information below. On a success with Fear, learn two. On a failure, a PC can mark a Stress to learn one and gain advantage on the next action roll to investigate this environment. A PC with an appropriate background or Experience can learn an additional detail and ask a follow-up question about the scene and get a truthful (if not always complete) answer.
• Traces of a battle (broken weapons and branches, gouges in the ground) litter the ground. • A moss-covered tree trunk is actually the corpse of a treant. • Still-standing trees are twisted in strange ways, as if by powerful magic. *Why did these groups come to blows? Why is the grove unused now?*"
            }
            ^"Barbed Vines" DEF {
                EXTENDS ^"Environment Feature"
                ^"Type"
                STRING "Action"
                ^"Description"
                STRING "Pick a point within the grove. All targets within Very Close range of that point must succeed on an Agility Reaction Roll or take **1d8+3 **physical damage and become *Restrained* by barbed vines. *Restrained* creatures until they’re freed with a successful Finesse or Strength roll or by dealing at least 6 damage to the vines. *How many vines are there? Where do they grab you? Do they pull you * *down or lift you oﬀ the ground?*"
            }
            ^"You Are Not Welcome Here" DEF {
                EXTENDS ^"Environment Feature"
                ^"Type"
                STRING "Action"
                ^"Description"
                STRING "A Young Dryad, two Sylvan Soldiers, and a number of Minor Treants equal to the number of PCs appear to confront the party for their intrusion. *What are the grove guardians concealing? What threat to the forest * *could the PCs confront to appease the Dryad?*"
            }
            ^"Defiler" DEF {
                EXTENDS ^"Environment Feature"
                ^"Type"
                STRING "Action"
                ^"Description"
                STRING "**Spend a Fear** to summon a Minor Chaos Elemental drawn to the echoes of violence and discord. They appear within Far range of a chosen PC and immediately take the spotlight. *What color does the grass turn as the elemental appears? How does * *the chaos warp insects and small wildlife within the grove?*"
            }
        }
    }
    #tfykaIruQp4oMuxQeHpiLSlS ^"Ambushed" DEF {
        EXTENDS ^"Environment"
        PROPERTIES {
            ^"Tier" INTEGER 1
            ^"Category" STRING "Event"
            ^"Description" STRING "An ambush is set to catch an unsuspecting party off -guard."
            ^"Impulses" LIST ["Overwhelm", "scatter", "surround"]
            ^"Difficulty" STRING "Special (see “Relative Strength”)"
        }
        POTENTIAL_ADVERSARIES {
